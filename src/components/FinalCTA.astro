---
import type { Language } from '@i18n/index';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { ArrowRight, Check } from '@lucide/astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const points = [
  pick(lang, { en: 'Website CHF\u00A00', fr: 'Site web CHF\u00A00', de: 'Website CHF\u00A00', it: 'Sito web CHF\u00A00' }),
  pick(lang, { en: 'Your domain stays yours', fr: 'Votre domaine reste le vôtre', de: 'Die Domain gehört Ihnen', it: 'Il dominio resta tuo' }),
  pick(lang, { en: 'No commitment', fr: 'Sans engagement', de: 'Unverbindlich', it: 'Senza impegno' }),
];
---

<section class="relative isolate overflow-hidden border-t border-ink-900/10 bg-paper py-24 md:py-32" id="get-started" aria-labelledby="final-title">
  <div class="final-grid grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-custom">
    <div class="max-w-4xl">
      <p class="eyebrow flex items-center gap-3 mb-8">
        <span class="h-px w-8 bg-signal-600" aria-hidden="true"></span>
        {pick(lang, { en: 'Start here', fr: 'Pour commencer', de: 'Jetzt starten', it: 'Inizia qui' })}
      </p>
      <h2 id="final-title" class="text-display-lg">{t('finalCta.title')}</h2>
      <p class="lead mt-6">{t('finalCta.text')}</p>

      <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
        <a href={getLocalizedPath('/start', lang)} class="btn btn-primary btn-lg">
          {t('finalCta.primary')}
          <ArrowRight size={18} class="arrow" stroke-width={1.75} />
        </a>
        <a href={getLocalizedPath('/start?path=extend', lang)} class="link-arrow self-start sm:self-auto py-2">
          {t('finalCta.secondary')}
          <ArrowRight size={16} stroke-width={1.75} />
        </a>
      </div>

      <ul class="mt-12 flex flex-col sm:flex-row gap-x-8 gap-y-3 text-sm text-steel-700">
        {points.map((p) => (
          <li class="flex items-center gap-2.5">
            <Check size={16} class="text-signal-600" stroke-width={2} />{p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .final-grid {
    mask-image: radial-gradient(ellipse 70% 80% at 90% 50%, #000 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 90% 50%, #000 10%, transparent 70%);
  }
</style>
