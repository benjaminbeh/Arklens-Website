---
import type { Language } from '@i18n/index';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/#how-it-works', label: t('nav.howItWorks') },
  { href: '/#what-we-offer', label: t('nav.whatWeOffer') },
  { href: '/#examples', label: t('nav.examples') },
  { href: '/ai/', label: t('nav.ai') },
  { href: '/#faq', label: t('nav.faq') },
  { href: '/contact', label: t('nav.contact') },
  { href: '/start', label: t('nav.getStarted') },
];

const legalLinks = [
  { href: '/terms', label: t('footer.terms') },
  { href: '/privacy', label: t('footer.privacy') },
  { href: '/legal', label: t('footer.legal') },
];
---

<footer class="bg-paper-100 border-t border-ink-900/10">
  <div class="container-custom pt-16 pb-10 md:pt-20">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 lg:col-span-6">
        <a href={getLocalizedPath('/', lang)} class="inline-flex items-center gap-2.5 text-ink-900" aria-label={t('a11y.home')}>
          <img src="/arklens-logo.png" width="40" height="40" alt="" class="block h-10 w-10 shrink-0 object-contain" loading="lazy" decoding="async" />
          <span class="text-2xl font-semibold tracking-[-0.03em]">Arklens</span>
        </a>
        <p class="mt-5 max-w-sm text-steel-600">{t('footer.tagline')}</p>
      </div>

      <nav class="col-span-6 lg:col-span-3" aria-labelledby="footer-nav">
        <h2 id="footer-nav" class="eyebrow mb-5">{t('footer.navHeading')}</h2>
        <ul class="space-y-3">
          {navLinks.map((l) => (
            <li><a href={getLocalizedPath(l.href, lang)} class="text-ink-900 hover:text-signal-700 transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="col-span-6 lg:col-span-3" aria-labelledby="footer-legal">
        <h2 id="footer-legal" class="eyebrow mb-5">{t('footer.legalHeading')}</h2>
        <ul class="space-y-3">
          {legalLinks.map((l) => (
            <li><a href={getLocalizedPath(l.href, lang)} class="text-ink-900 hover:text-signal-700 transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-16 pt-6 border-t border-ink-900/10 flex flex-col sm:flex-row gap-3 justify-between text-sm text-steel-600">
      <p>{t('footer.copyright').replace('2025', String(currentYear))}</p>
      <p class="inline-flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" fill="#D52B1E" />
          <path d="M13 6h6v7h7v6h-7v7h-6v-7H6v-6h7z" fill="#fff" />
        </svg>
        {pick(lang, { en: 'Made for Swiss SMEs', fr: 'Conçu pour les PME suisses', de: 'Für Schweizer KMU', it: 'Per le PMI svizzere' })}
      </p>
    </div>
  </div>
</footer>
