---
/**
 * "We work with the tools you already use" — credibility bridge between the
 * add-ons section (06) and the dark "Tools that work together" zone (Progression).
 *
 * Restrained text-name chips grouped into six category cards. No logos, no partner
 * wall, no endorsement/partnership implication. Platform names are shown as examples
 * only; the disclaimer and framing copy keep this as plain, honest, visible content.
 *
 * English-first source meaning; FR/DE/IT are natural Swiss localisations (not literal
 * translations). Product/brand names and the CRM/ERP acronyms are intentionally
 * identical in every language and are covered by scripts/i18n-allowlist.json.
 */
import type { Language } from '@i18n/index';
import { getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { Mail, Calculator, Users, Factory, Server, Workflow, ArrowRight } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Platform names are brand/trademark strings, shown identically in every language.
// `note` is a short honest qualifier so we never imply every tool is equally common.
const categories = [
  {
    icon: Mail,
    title: pick(lang, { en: 'Office & collaboration', fr: 'Bureautique et collaboration', de: 'Büro und Zusammenarbeit', it: 'Produttività e collaborazione' }),
    note: pick(lang, { en: 'Everyday email, documents and shared files', fr: 'E-mails, documents et fichiers partagés au quotidien', de: 'E-Mails, Dokumente und gemeinsame Dateien im Alltag', it: 'E-mail, documenti e file condivisi di ogni giorno' }),
    tools: ['Microsoft 365', 'Google Workspace', 'SharePoint'],
  },
  {
    icon: Calculator,
    title: pick(lang, { en: 'Business & accounting', fr: 'Gestion et comptabilité', de: 'Betrieb und Buchhaltung', it: 'Gestione e contabilità' }),
    note: pick(lang, { en: 'Business and accounting tools used by Swiss SMEs', fr: 'Outils de gestion et de comptabilité utilisés par les PME suisses', de: 'Betriebs- und Buchhaltungslösungen, die Schweizer KMU nutzen', it: 'Strumenti di gestione e contabilità usati dalle PMI svizzere' }),
    tools: ['bexio', 'Abacus', 'KLARA'],
  },
  {
    icon: Users,
    title: pick(lang, { en: 'CRM & sales', fr: 'CRM et ventes', de: 'CRM und Vertrieb', it: 'CRM e vendite' }),
    note: pick(lang, { en: 'Keeping track of customers and quotes', fr: 'Suivre les clients et les offres', de: 'Den Überblick über Kundschaft und Offerten behalten', it: 'Tenere traccia di clienti e offerte' }),
    tools: ['Salesforce', 'HubSpot', 'Microsoft Dynamics'],
  },
  {
    icon: Factory,
    title: pick(lang, { en: 'ERP & operations', fr: 'ERP et opérations', de: 'ERP und Betriebsabläufe', it: 'ERP e operations' }),
    note: pick(lang, { en: 'More common in larger or industrial SMEs', fr: 'Plus courant dans les PME de plus grande taille ou industrielles', de: 'Häufiger bei grösseren oder industriellen KMU', it: 'Più diffuso nelle PMI più grandi o industriali' }),
    tools: ['SAP', 'Abacus', 'Odoo'],
  },
  {
    icon: Server,
    title: pick(lang, { en: 'Hosting & web', fr: 'Hébergement et web', de: 'Hosting und Web', it: 'Hosting e web' }),
    note: pick(lang, { en: 'Hosting, domains and web infrastructure', fr: 'Hébergement, noms de domaine et infrastructure web', de: 'Hosting, Domains und Web-Infrastruktur', it: 'Hosting, domini e infrastruttura web' }),
    tools: ['Infomaniak', 'Hostpoint', 'Cloudflare'],
  },
  {
    icon: Workflow,
    title: pick(lang, { en: 'Automation & workflows', fr: 'Automatisation et processus', de: 'Automatisierung und Abläufe', it: 'Automazione e processi' }),
    note: pick(lang, { en: 'Connecting steps so work moves on its own', fr: 'Relier les étapes pour que le travail avance automatiquement', de: 'Schritte verbinden, damit die Arbeit von selbst weiterläuft', it: 'Collegare i passaggi perché il lavoro proceda da solo' }),
    tools: ['Power Automate', 'Make', 'Zapier'],
  },
];

// Translatable workflow words stay localised; brand/acronym steps are fixed.
const workflowSteps = [
  pick(lang, { en: 'Enquiry', fr: 'Demande', de: 'Anfrage', it: 'Richiesta' }),
  'Microsoft 365',
  'CRM / ERP',
  pick(lang, { en: 'Quotation', fr: 'Offre', de: 'Offerte', it: 'Offerta' }),
  pick(lang, { en: 'Follow-up', fr: 'Suivi', de: 'Nachfassen', it: 'Follow-up' }),
];
---

<section class="section bg-white border-y border-ink-900/10" id="your-systems" aria-labelledby="systems-title">
  <div class="container-custom">
    <SectionHeader
      id="systems-title"
      index="07"
      eyebrow={pick(lang, { en: 'Your systems', fr: 'Vos systèmes', de: 'Ihre Systeme', it: 'I tuoi sistemi' })}
      title={pick(lang, {
        en: 'We work with the tools you already use',
        fr: 'Nous travaillons avec les outils que vous utilisez déjà',
        de: 'Wir arbeiten mit den Programmen, die Sie bereits nutzen',
        it: 'Lavoriamo con gli strumenti che già utilizzi',
      })}
      lead={pick(lang, {
        en: 'From everyday office software and accounting platforms to CRM, ERP and hosting, we help Swiss SMEs get more from the systems they already use.',
        fr: 'De la bureautique du quotidien aux logiciels de comptabilité, en passant par le CRM, l’ERP et l’hébergement, nous aidons les PME suisses à tirer davantage parti des systèmes qu’elles utilisent déjà.',
        de: 'Von der täglichen Bürosoftware über Buchhaltungslösungen bis hin zu CRM, ERP und Hosting: Wir helfen Schweizer KMU, mehr aus den Systemen herauszuholen, die sie bereits nutzen.',
        it: 'Dalla produttività di ogni giorno ai software di contabilità, fino a CRM, ERP e hosting, aiutiamo le PMI svizzere a ottenere di più dai sistemi che già utilizzano.',
      })}
    >
      <p class="mt-5 text-heading-sm font-medium text-ink-900 max-w-2xl">
        {pick(lang, {
          en: 'You don’t need to replace everything. We start with what already works, then connect, improve and automate from there.',
          fr: 'Pas besoin de tout remplacer. Nous partons de ce qui fonctionne déjà, puis nous relions, améliorons et automatisons à partir de là.',
          de: 'Sie müssen nicht alles ersetzen. Wir starten mit dem, was bereits funktioniert, und verbinden, verbessern und automatisieren von dort aus.',
          it: 'Non devi sostituire tutto. Partiamo da ciò che già funziona e da lì colleghiamo, miglioriamo e automatizziamo.',
        })}
      </p>
    </SectionHeader>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-900/10 border border-ink-900/10 rounded-md overflow-hidden">
      {categories.map((category, i) => {
        const Icon = category.icon;
        return (
          <li class="card-grid-hover relative bg-white p-7 transition-colors hover:bg-paper">
            <div class="flex items-center justify-between">
              <Icon size={22} class="text-ink-900" stroke-width={1.5} />
              <span class="font-mono text-xs text-steel-400" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-8 text-heading-sm text-ink-900">{category.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-600">{category.note}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {category.tools.map((tool) => (
                <li class="inline-flex items-center rounded-full border border-ink-900/15 bg-paper px-3 py-1 text-sm text-steel-700">
                  {tool}
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>

    <div class="mt-10 border-t border-ink-900/10 pt-8">
      <p class="text-steel-600 max-w-2xl">
        {pick(lang, {
          en: 'We can assess how your existing tools fit together and where small improvements or automation would help most.',
          fr: 'Nous pouvons évaluer comment vos outils actuels fonctionnent ensemble et où de petites améliorations ou de l’automatisation aideraient le plus.',
          de: 'Wir können beurteilen, wie Ihre bestehenden Programme zusammenspielen und wo kleine Verbesserungen oder Automatisierung am meisten bringen.',
          it: 'Possiamo valutare come i tuoi strumenti attuali funzionano insieme e dove piccoli miglioramenti o l’automazione aiuterebbero di più.',
        })}
      </p>

      <ol
        class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-2 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-steel-700"
        aria-label={pick(lang, {
          en: 'Example workflow: enquiry through to follow-up',
          fr: 'Exemple de processus : de la demande au suivi',
          de: 'Beispielablauf: von der Anfrage bis zum Nachfassen',
          it: 'Esempio di processo: dalla richiesta al riscontro',
        })}
      >
        {workflowSteps.map((step, i) => (
          <li class="flex items-center gap-2">
            <span class="whitespace-nowrap">{step}</span>
            {i < workflowSteps.length - 1 && <span class="text-steel-400" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>

      <div class="mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <p class="text-xs text-steel-500 max-w-2xl">
          {pick(lang, {
            en: 'Examples only. Names and trademarks belong to their respective owners. What’s possible depends on your systems and the project.',
            fr: 'Exemples uniquement. Les noms et marques appartiennent à leurs propriétaires respectifs. Ce qui est possible dépend de vos systèmes et du projet.',
            de: 'Nur Beispiele. Namen und Marken gehören den jeweiligen Eigentümern. Was möglich ist, hängt von Ihren Systemen und vom Projekt ab.',
            it: 'Solo esempi. I nomi e i marchi appartengono ai rispettivi proprietari. Ciò che è possibile dipende dai tuoi sistemi e dal progetto.',
          })}
        </p>
        <a href={getLocalizedPath('/contact/', lang)} class="link-arrow self-start sm:self-auto shrink-0">
          {pick(lang, { en: 'Tell us what you use', fr: 'Dites-nous ce que vous utilisez', de: 'Sagen Sie uns, was Sie nutzen', it: 'Dicci cosa utilizzi' })}
          <ArrowRight size={16} stroke-width={1.75} />
        </a>
      </div>
    </div>
  </div>
</section>
