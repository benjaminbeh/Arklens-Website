---
import type { Language } from '@i18n/index';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { Inbox, FileText, FileSearch, Headphones, Cable, ChartColumn, ArrowRight } from '@lucide/astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// input → output pairs make each automation concrete rather than abstract
const examples = [
  { key: 'enquiries', icon: Inbox, io: pick(lang, { en: 'Inbox → Sorted & routed', fr: 'E-mails → Triés et transmis', de: 'Posteingang → Sortiert & verteilt', it: 'Posta → Smistata e inoltrata' }) },
  { key: 'quotes', icon: FileText, io: pick(lang, { en: 'Request → Draft quote', fr: 'Demande → Projet d’offre', de: 'Anfrage → Offertentwurf', it: 'Richiesta → Bozza d’offerta' }) },
  { key: 'documents', icon: FileSearch, io: pick(lang, { en: 'Question → Sourced answer', fr: 'Question → Réponse sourcée', de: 'Frage → Antwort mit Quelle', it: 'Domanda → Risposta con fonte' }) },
  { key: 'support', icon: Headphones, io: pick(lang, { en: 'FAQ → Instant reply', fr: 'FAQ → Réponse immédiate', de: 'FAQ → Sofortantwort', it: 'FAQ → Risposta immediata' }) },
  { key: 'admin', icon: Cable, io: pick(lang, { en: 'Form → CRM → Sheet', fr: 'Formulaire → CRM → Tableur', de: 'Formular → CRM → Tabelle', it: 'Modulo → CRM → Foglio' }) },
  { key: 'reporting', icon: ChartColumn, io: pick(lang, { en: 'Data → Weekly summary', fr: 'Données → Synthèse hebdo', de: 'Daten → Wochenbericht', it: 'Dati → Sintesi settimanale' }) },
];
---

<section class="theme-dark bg-ink-900 text-white pb-20 md:pb-28 lg:pb-32" aria-labelledby="automation-title">
  <div class="container-custom">
    <div class="rule pt-12 md:pt-16 grid grid-cols-12 gap-x-6 gap-y-6 mb-12">
      <div class="col-span-12 md:col-span-4 lg:col-span-3">
        <p class="eyebrow">{pick(lang, { en: 'Use cases', fr: 'Cas d’usage', de: 'Anwendungsfälle', it: 'Casi d’uso' })}</p>
      </div>
      <div class="col-span-12 md:col-span-8 lg:col-span-9">
        <h2 id="automation-title" class="text-display-sm max-w-3xl">{t('automation.title')}</h2>
      </div>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 border border-white/10 rounded-md overflow-hidden">
      {examples.map((ex, i) => {
        const Icon = ex.icon;
        return (
          <li class="card-grid-hover relative bg-ink-900 p-7 transition-colors hover:bg-ink-800 reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <div class="flex items-center justify-between">
              <Icon size={22} class="text-white" stroke-width={1.5} />
              <span class="font-mono text-xs text-steel-400">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-8 text-heading-sm text-white">{t(`automation.${ex.key}.title` as any)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-300">{t(`automation.${ex.key}.desc` as any)}</p>
            <p class="mt-6 pt-4 border-t border-white/10 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-signal-400">{ex.io}</p>
          </li>
        );
      })}
    </ul>

    <div class="mt-12 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <p class="text-steel-300 max-w-xl">
        {pick(lang, {
          en: 'Automation is optional. We agree the scope and price with you before any paid work begins.',
          fr: 'L’automatisation est facultative. Nous définissons avec vous le périmètre et le prix avant tout travail payant.',
          de: 'Automatisierung ist optional. Umfang und Preis vereinbaren wir mit Ihnen, bevor kostenpflichtige Arbeit beginnt.',
          it: 'L’automazione è facoltativa. Concordiamo con te ambito e prezzo prima di ogni lavoro a pagamento.',
        })}
      </p>
      <a href={getLocalizedPath('/start?path=extend', lang)} class="btn btn-secondary self-start sm:self-auto">
        {pick(lang, { en: 'See what we can automate', fr: 'Explorer l’automatisation', de: 'Automatisierung entdecken', it: 'Scopri l’automazione' })}
        <ArrowRight size={16} class="arrow" stroke-width={1.75} />
      </a>
    </div>
  </div>
</section>
