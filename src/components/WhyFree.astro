---
import type { Language } from '@i18n/index';
import { useTranslations } from '@i18n/index';
import { pick } from '@lib/pick';
import { Check } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const trustPoints = ['noSetup', 'noHosting', 'noCard', 'optional', 'clear', 'yourDomain'];
---

<section class="section" aria-labelledby="why-title">
  <div class="container-custom">
    <SectionHeader
      id="why-title"
      index="03"
      eyebrow={pick(lang, { en: 'Transparency', fr: 'Transparence', de: 'Transparenz', it: 'Trasparenza' })}
      title={t('whyFree.title')}
    >
      <div class="mt-6 grid md:grid-cols-2 gap-6 md:gap-10 max-w-4xl">
        <p class="text-body-lg text-steel-700">{t('whyFree.text1')}</p>
        <p class="text-body-lg text-steel-700">{t('whyFree.text2')}</p>
      </div>
    </SectionHeader>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-900/10 border border-ink-900/10 rounded-md overflow-hidden">
      {trustPoints.map((point) => (
        <li class="flex items-start gap-3 bg-paper p-6">
          <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center bg-ink-900 text-white rounded-xs" aria-hidden="true">
            <Check size={13} stroke-width={2.5} />
          </span>
          <span class="font-medium text-ink-900">{t(`whyFree.trust.${point}` as any)}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
