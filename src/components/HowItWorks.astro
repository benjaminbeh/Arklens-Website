---
import type { Language } from '@i18n/index';
import { useTranslations } from '@i18n/index';
import { pick } from '@lib/pick';
import { ArrowRight } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = ['step1', 'step2', 'step3'];
---

<section class="section" aria-labelledby="process-title">
  <div class="container-custom">
    <SectionHeader
      id="process-title"
      index="05"
      eyebrow={pick(lang, { en: 'Process', fr: 'Processus', de: 'Ablauf', it: 'Processo' })}
      title={t('howItWorks.title')}
    />

    <ol class="grid md:grid-cols-3 gap-x-8 gap-y-12">
      {steps.map((key, i) => (
        <li class="process-step reveal relative pt-8" style={`--reveal-delay:${i * 120}ms`}>
          <span class="process-rule" aria-hidden="true"></span>
          <span class="big-num block" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-8 text-heading-md text-ink-900">
            <span class="sr-only">{pick(lang, { en: 'Step', fr: 'Étape', de: 'Schritt', it: 'Passo' })} {i + 1}: </span>
            {t(`howItWorks.${key}.title` as any)}
          </h3>
          <p class="mt-3 text-steel-600 max-w-sm">{t(`howItWorks.${key}.text` as any)}</p>
        </li>
      ))}
    </ol>

    <div class="mt-14">
      <a href="/start" class="btn btn-primary btn-lg">
        {t('howItWorks.cta')}
        <ArrowRight size={18} class="arrow" stroke-width={1.75} />
      </a>
    </div>
  </div>
</section>

<style>
  /* Each step owns a segment of the signal line along the top edge */
  .process-rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: rgba(17, 20, 24, 0.15);
  }
  .process-rule::after {
    content: '';
    position: absolute;
    left: 0;
    top: -0.5px;
    height: 2px;
    width: 3rem;
    background: theme('colors.signal.600');
  }
</style>
