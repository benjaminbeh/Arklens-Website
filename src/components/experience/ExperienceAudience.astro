---
import type { Language } from '@i18n/index';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { experienceCopy } from './copy';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = experienceCopy(lang).audience;
---

<section class="section" aria-labelledby="experience-audience-title">
  <div class="container-custom">
    <SectionHeader id="experience-audience-title" index="05" eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

    <div class="grid grid-cols-12 gap-x-6 gap-y-8">
      <p class="col-span-12 lg:col-span-4 text-heading-sm text-ink-900 max-w-md">{c.line}</p>
      <ul class="col-span-12 lg:col-span-8 flex flex-wrap gap-2.5 content-start">
        {c.groups.map((g) => (
          <li class="inline-flex items-center rounded-full border border-ink-900/15 bg-white px-4 py-2 text-[0.9375rem] text-ink-900">{g}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
