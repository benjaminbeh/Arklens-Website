---
import type { Language } from '@i18n/index';
import { Store, Network, Users, UserPlus } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { experienceCopy } from './copy';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = experienceCopy(lang).connections;
const icons = [Store, Network, Users, UserPlus];
---

<section class="section bg-white border-y border-ink-900/10" aria-labelledby="experience-connections-title">
  <div class="container-custom">
    <SectionHeader id="experience-connections-title" index="04" eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-ink-900/10 border border-ink-900/10 rounded-md overflow-hidden">
      {c.items.map((item, i) => {
        const Icon = icons[i];
        return (
          <li class="flex flex-col gap-6 bg-white p-6 min-h-[9rem]">
            <Icon size={20} class="text-ink-900" stroke-width={1.5} />
            <span class="font-medium text-ink-900">{item}</span>
          </li>
        );
      })}
    </ul>

    <div class="mt-10 grid md:grid-cols-2 gap-x-6 gap-y-4 border-t border-ink-900/10 pt-8">
      <p class="text-steel-700 max-w-xl">{c.regions}</p>
      <p class="text-steel-600 max-w-xl">{c.note}</p>
    </div>
  </div>
</section>
