---
import type { Language } from '@i18n/index';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { experienceCopy } from './copy';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = experienceCopy(lang).process;
---

<section class="section bg-white border-y border-ink-900/10 scroll-mt-[var(--sfg-header-h)]" id="how-it-works" aria-labelledby="experience-process-title">
  <div class="container-custom">
    <SectionHeader id="experience-process-title" index="06" eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

    <ol class="grid sm:grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-12">
      {c.steps.map((step, i) => (
        <li class="reveal relative pt-8" style={`--reveal-delay:${i * 100}ms`}>
          <span class="process-rule" aria-hidden="true"></span>
          <span class="big-num block" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-8 text-heading-sm text-ink-900">
            <span class="sr-only">{c.stepLabel(i + 1)}</span>
            {step.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-steel-600 max-w-sm">{step.text}</p>
        </li>
      ))}
    </ol>

    <p class="mt-14 text-steel-700 max-w-2xl">{c.note}</p>
  </div>
</section>

<style>
  /* Same step rule as AiStart / HowItWorks: each step owns a segment of the top line */
  .process-rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: rgba(17, 20, 24, 0.15);
  }
  .process-rule::after {
    content: '';
    position: absolute;
    left: 0;
    top: -0.5px;
    height: 2px;
    width: 3rem;
    background: theme('colors.signal.600');
  }
</style>
