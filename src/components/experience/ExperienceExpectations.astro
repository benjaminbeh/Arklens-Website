---
import type { Language } from '@i18n/index';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { experienceCopy } from './copy';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const c = experienceCopy(lang).expectations;
---

<section class="section" aria-labelledby="experience-expectations-title">
  <div class="container-custom">
    <SectionHeader id="experience-expectations-title" index="07" eyebrow={c.eyebrow} title={c.title} lead={c.lead} />

    <ul class="grid md:grid-cols-2 gap-x-10 border-t border-ink-900/10">
      {c.items.map((item) => (
        <li class="flex items-start gap-3 border-b border-ink-900/10 py-4 text-steel-700">
          <span class="mt-[0.6em] h-px w-3 flex-none bg-signal-600" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
