---
import type { Language } from '@i18n/index';
import { getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { SquarePlus, RefreshCw, Blocks, ArrowRight } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const paths = [
  {
    id: 'new',
    icon: SquarePlus,
    title: pick(lang, { en: 'I need a website', fr: 'J’ai besoin d’un site web', de: 'Ich brauche eine Website', it: 'Mi serve un sito web' }),
    text: pick(lang, { en: 'Create a professional online presence for your business from scratch.', fr: 'Une présence en ligne professionnelle pour votre entreprise, créée de A à Z.', de: 'Eine professionelle Online-Präsenz für Ihr Unternehmen, von Grund auf neu.', it: 'Una presenza online professionale per la tua azienda, partendo da zero.' }),
    cta: pick(lang, { en: 'Get my free website', fr: 'Demander mon site gratuit', de: 'Website kostenlos anfragen', it: 'Richiedi il sito gratuito' }),
    href: '/start?path=new',
  },
  {
    id: 'update',
    icon: RefreshCw,
    title: pick(lang, { en: 'My website needs an update', fr: 'Mon site doit être mis à jour', de: 'Meine Website braucht ein Update', it: 'Il mio sito va aggiornato' }),
    text: pick(lang, { en: 'Modernise an outdated website or make it easier to manage.', fr: 'Moderniser un site vieillissant ou le rendre plus simple à gérer.', de: 'Eine veraltete Website modernisieren oder einfacher pflegbar machen.', it: 'Modernizzare un sito datato o renderlo più facile da gestire.' }),
    cta: pick(lang, { en: 'Improve my website', fr: 'Améliorer mon site', de: 'Meine Website verbessern', it: 'Migliora il mio sito' }),
    href: '/start?path=update',
  },
  {
    id: 'extend',
    icon: Blocks,
    title: pick(lang, { en: 'My website works, but I need more', fr: 'Mon site fonctionne, mais il me faut plus', de: 'Meine Website funktioniert, aber ich brauche mehr', it: 'Il mio sito funziona, ma mi serve di più' }),
    text: pick(lang, { en: 'Add bookings, forms, payments, integrations, automation and AI.', fr: 'Ajouter réservations, formulaires, paiements, intégrations, automatisation et IA.', de: 'Buchungen, Formulare, Zahlungen, Integrationen, Automatisierung und KI ergänzen.', it: 'Aggiungere prenotazioni, moduli, pagamenti, integrazioni, automazione e IA.' }),
    cta: pick(lang, { en: 'Add a feature', fr: 'Ajouter une fonctionnalité', de: 'Funktion ergänzen', it: 'Aggiungi una funzionalità' }),
    href: '/start?path=extend',
  },
];
---

<section class="section" id="how-it-works" aria-labelledby="paths-title">
  <div class="container-custom">
    <SectionHeader
      id="paths-title"
      index="01"
      eyebrow={pick(lang, { en: 'Starting point', fr: 'Point de départ', de: 'Ausgangspunkt', it: 'Punto di partenza' })}
      title={pick(lang, { en: 'Choose your starting point', fr: 'Choisissez votre point de départ', de: 'Wählen Sie Ihren Ausgangspunkt', it: 'Scegli il tuo punto di partenza' })}
      lead={pick(lang, { en: 'Tell us where you are today, and we’ll guide you through the right steps.', fr: 'Dites-nous où vous en êtes aujourd’hui, nous vous guidons vers les bonnes étapes.', de: 'Sagen Sie uns, wo Sie heute stehen. Wir zeigen Ihnen die passenden nächsten Schritte.', it: 'Dicci a che punto sei oggi e ti guidiamo nei passi giusti.' })}
    />

    <ul class="grid md:grid-cols-3 border border-ink-900/10 rounded-md bg-white divide-y md:divide-y-0 md:divide-x divide-ink-900/10 overflow-hidden">
      {paths.map((path, i) => {
        const Icon = path.icon;
        return (
          <li class="reveal" style={`--reveal-delay:${i * 90}ms`}>
            <a href={getLocalizedPath(path.href, lang)} class="path-card card-grid-hover group relative flex h-full flex-col p-7 md:p-8 lg:p-10 focus-visible:outline-offset-[-4px]">
              <span class="path-bar" aria-hidden="true"></span>
              <div class="flex items-start justify-between mb-10 md:mb-14">
                <span class="flex h-12 w-12 items-center justify-center border border-ink-900/15 rounded-[4px] text-ink-900 transition-colors group-hover:border-ink-900">
                  <Icon size={22} stroke-width={1.5} />
                </span>
                <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="text-heading-lg text-ink-900 max-w-[16ch]">{path.title}</h3>
              <p class="mt-3 text-steel-600 leading-relaxed">{path.text}</p>
              <span class="link-arrow mt-auto pt-8 text-signal-700 group-hover:underline">
                {path.cta}
                <ArrowRight size={16} stroke-width={1.75} />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .path-card {
    transition: background-color 0.2s ease;
  }
  .path-card:hover {
    background-color: theme('colors.paper.DEFAULT');
  }
  /* Signal bar that draws across the top edge on hover/focus */
  .path-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: theme('colors.signal.600');
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .path-card:hover .path-bar,
  .path-card:focus-visible .path-bar {
    transform: scaleX(1);
  }
</style>
