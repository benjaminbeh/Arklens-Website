---
import type { Language } from '@i18n/index';
import { pick } from '@lib/pick';
import SectionHeader from '@components/ui/SectionHeader.astro';
import WorkflowDiagram from '@components/ui/WorkflowDiagram.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const sources = [
  pick(lang, { en: 'Documents', fr: 'Documents', de: 'Dokumente', it: 'Documenti' }),
  pick(lang, { en: 'PDFs', fr: 'Fichiers PDF', de: 'PDF-Dateien', it: 'File PDF' }),
  pick(lang, { en: 'Manuals', fr: 'Manuels', de: 'Handbücher', it: 'Manuali' }),
  pick(lang, { en: 'Websites', fr: 'Sites web', de: 'Webseiten', it: 'Siti web' }),
  pick(lang, { en: 'CRM information', fr: 'Données CRM', de: 'CRM-Daten', it: 'Dati del CRM' }),
  pick(lang, { en: 'Cloud files', fr: 'Fichiers dans le cloud', de: 'Cloud-Dateien', it: 'File nel cloud' }),
  pick(lang, { en: 'Knowledge bases', fr: 'Bases de connaissances', de: 'Wissensdatenbanken', it: 'Basi di conoscenza' }),
  pick(lang, { en: 'Product catalogues', fr: 'Catalogues produits', de: 'Produktkataloge', it: 'Cataloghi prodotti' }),
];

const principles = [
  pick(lang, {
    en: 'You choose which information is connected.',
    fr: 'Vous choisissez quelles informations sont reliées.',
    de: 'Sie bestimmen, welche Informationen angebunden werden.',
    it: 'Scegli tu quali informazioni collegare.',
  }),
  pick(lang, {
    en: 'Answers show where they come from, so they can be checked.',
    fr: 'Les réponses indiquent leur source et peuvent donc être vérifiées.',
    de: 'Antworten zeigen ihre Quelle und lassen sich so überprüfen.',
    it: 'Le risposte indicano la fonte, così puoi verificarle.',
  }),
  pick(lang, {
    en: 'Access can follow your team’s roles.',
    fr: 'Les accès peuvent suivre les rôles de votre équipe.',
    de: 'Zugriffe können sich nach den Rollen in Ihrem Team richten.',
    it: 'Gli accessi possono seguire i ruoli del tuo team.',
  }),
];

const steps = [
  {
    label: pick(lang, { en: 'Approved sources', fr: 'Sources validées', de: 'Freigegebene Quellen', it: 'Fonti approvate' }),
    meta: pick(lang, { en: 'Only what you select', fr: 'Uniquement ce que vous choisissez', de: 'Nur, was Sie auswählen', it: 'Solo ciò che scegli' }),
  },
  {
    label: pick(lang, { en: 'Private company knowledge', fr: 'Connaissances internes privées', de: 'Privates Firmenwissen', it: 'Conoscenza aziendale privata' }),
    meta: pick(lang, { en: 'Organised for search', fr: 'Organisées pour la recherche', de: 'Für die Suche aufbereitet', it: 'Organizzata per la ricerca' }),
  },
  {
    label: pick(lang, { en: 'Employee asks', fr: 'Un collaborateur pose sa question', de: 'Mitarbeitende fragen', it: 'Un collaboratore chiede' }),
    meta: pick(lang, { en: 'In plain language', fr: 'En langage courant', de: 'In normaler Sprache', it: 'In linguaggio semplice' }),
  },
  {
    label: pick(lang, { en: 'Answer with source', fr: 'Réponse avec source', de: 'Antwort mit Quelle', it: 'Risposta con fonte' }),
    meta: pick(lang, { en: 'Ready to check', fr: 'Prête à être vérifiée', de: 'Bereit zur Prüfung', it: 'Pronta da verificare' }),
  },
];
---

<section class="section" aria-labelledby="ai-knowledge-title">
  <div class="container-custom">
    <SectionHeader
      id="ai-knowledge-title"
      index="02"
      eyebrow={pick(lang, { en: 'Private company knowledge', fr: 'Connaissances internes', de: 'Internes Firmenwissen', it: 'Conoscenza interna' })}
      title={pick(lang, {
        en: 'Your business already has knowledge. AI can make it easier to use.',
        fr: 'Votre entreprise dispose déjà de connaissances. L’IA peut les rendre plus faciles à utiliser.',
        de: 'Ihr Unternehmen hat bereits Wissen. KI kann es leichter nutzbar machen.',
        it: 'La tua azienda possiede già conoscenze. L’IA può renderle più facili da usare.',
      })}
      lead={pick(lang, {
        en: 'Arklens can connect approved business information so your employees can ask questions in natural language and get answers that point back to the source.',
        fr: 'Arklens peut relier les informations validées de votre entreprise, pour que vos collaborateurs posent leurs questions en langage courant et obtiennent des réponses qui renvoient à la source.',
        de: 'Arklens kann freigegebene Geschäftsinformationen anbinden. So stellen Ihre Mitarbeitenden Fragen in normaler Sprache und erhalten Antworten mit Verweis auf die Quelle.',
        it: 'Arklens può collegare le informazioni aziendali approvate: il tuo personale fa domande in linguaggio naturale e riceve risposte che rimandano alla fonte.',
      })}
    />

    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 lg:col-span-5">
        <ul class="flex flex-wrap gap-2" aria-label={pick(lang, { en: 'Examples of business information', fr: 'Exemples d’informations d’entreprise', de: 'Beispiele für Geschäftsinformationen', it: 'Esempi di informazioni aziendali' })}>
          {sources.map((s) => <li class="tag">{s}</li>)}
        </ul>

        <ul class="mt-10 border-t border-ink-900/10">
          {principles.map((p, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-4 border-b border-ink-900/10 py-4">
              <span class="font-mono text-xs text-signal-600 pt-1" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-ink-900 font-medium">{p}</span>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-sm leading-relaxed text-steel-600 max-w-md">
          {pick(lang, {
            en: 'Connecting your information to an assistant is not the same as training a public AI model. We choose services and settings with you so your data is used to answer your questions.',
            fr: 'Relier vos informations à un assistant, ce n’est pas entraîner un modèle d’IA public. Nous choisissons avec vous les services et les réglages pour que vos données servent à répondre à vos questions.',
            de: 'Ihre Informationen mit einem Assistenten zu verbinden heisst nicht, damit ein öffentliches KI-Modell zu trainieren. Wir wählen Dienste und Einstellungen gemeinsam mit Ihnen, damit Ihre Daten zur Beantwortung Ihrer Fragen dienen.',
            it: 'Collegare le tue informazioni a un assistente non significa addestrare un modello di IA pubblico. Scegliamo con te servizi e impostazioni, in modo che i tuoi dati servano a rispondere alle tue domande.',
          })}
        </p>
      </div>

      <div class="col-span-12 lg:col-span-7">
        <WorkflowDiagram
          class="reveal"
          kicker={pick(lang, { en: 'Example', fr: 'Exemple', de: 'Beispiel', it: 'Esempio' })}
          title={pick(lang, { en: 'From your documents to a checked answer', fr: 'De vos documents à une réponse vérifiée', de: 'Von Ihren Dokumenten zur geprüften Antwort', it: 'Dai tuoi documenti a una risposta verificata' })}
          steps={steps}
          outcome={pick(lang, { en: 'From simple assistants to private company AI.', fr: 'Des assistants simples à une IA d’entreprise privée.', de: 'Vom einfachen Assistenten bis zur privaten Firmen-KI.', it: 'Dai semplici assistenti all’IA aziendale privata.' })}
        />
      </div>
    </div>
  </div>
</section>
