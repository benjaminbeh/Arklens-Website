---
import type { Language } from '@i18n/index';
import { useTranslations } from '@i18n/index';
import { pick } from '@lib/pick';
import { Check, ArrowRight } from '@lucide/astro';
import SiteMockup from '@components/ui/SiteMockup.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// "Your business website. CHF 0." → ["Your business website.", "CHF 0."]
const title = t('hero.title');
const splitAt = title.indexOf('. ');
const titleLead = splitAt > -1 ? title.slice(0, splitAt + 1) : title;
const titlePrice = splitAt > -1 ? title.slice(splitAt + 2) : '';

const trust = t('hero.trust').split(' · ').filter(Boolean);

const specs = [
  { k: pick(lang, { en: 'Website', fr: 'Site web', de: 'Website', it: 'Sito web' }), v: 'CHF 0' },
  { k: 'Hosting', v: pick(lang, { en: 'Included', fr: 'Inclus', de: 'Inbegriffen', it: 'Incluso' }) },
  { k: pick(lang, { en: 'Domain', fr: 'Domaine', de: 'Domain', it: 'Dominio' }), v: pick(lang, { en: 'Yours', fr: 'À vous', de: 'Ihre', it: 'Tuo' }) },
];
---

<section class="relative isolate overflow-hidden border-b border-ink-900/10 pt-[calc(var(--sfg-header-h)+3rem)] pb-16 md:pt-[calc(var(--sfg-header-h)+5rem)] md:pb-24" aria-labelledby="hero-title">
  <!-- Faint Swiss grid, faded towards the content -->
  <div class="hero-grid grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-custom">
    <div class="grid grid-cols-12 gap-x-6 gap-y-14 items-start">
      <!-- Copy -->
      <div class="col-span-12 lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 mb-8">
          <span class="h-px w-8 bg-signal-600" aria-hidden="true"></span>
          <span>
            {pick(lang, { en: 'Free Website Programme', fr: 'Programme Site Web Gratuit', de: 'Kostenloses Website-Programm', it: 'Programma Sito Web Gratuito' })}<span class="max-sm:hidden"> · {pick(lang, { en: 'Switzerland', fr: 'Suisse', de: 'Schweiz', it: 'Svizzera' })}</span>
          </span>
        </p>

        <h1 id="hero-title" class="text-display-xl text-ink-900 max-w-[14ch]">
          {titleLead}
          {titlePrice && <span class="block text-signal-600">{titlePrice}</span>}
        </h1>

        <p class="lead mt-7 md:text-[1.25rem] md:leading-[1.6]">
          {t('hero.subtitle')}
        </p>

        <!-- Offer at a glance: the 5-second read -->
        <dl class="mt-10 grid grid-cols-3 max-w-lg border-y border-ink-900/15">
          {specs.map((s, i) => (
            <div class:list={['py-4 pr-2 sm:pr-3', i > 0 && 'pl-3 sm:pl-4 border-l border-ink-900/15']}>
              <dt class="eyebrow text-[0.6875rem]">{s.k}</dt>
              <dd class="mt-1.5 text-base min-[360px]:text-lg min-[400px]:text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-ink-900 whitespace-nowrap">{s.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
          <a href="/start" class="btn btn-primary btn-lg">
            {t('hero.cta.primary')}
            <ArrowRight size={18} class="arrow" stroke-width={1.75} />
          </a>
          <a href="/start?path=update" class="link-arrow self-start sm:self-auto py-2">
            {t('hero.cta.secondary')}
            <ArrowRight size={16} stroke-width={1.75} />
          </a>
        </div>

        <ul class="mt-10 flex flex-col sm:flex-row sm:flex-wrap gap-x-8 gap-y-3 text-sm text-steel-700">
          {trust.map((item) => (
            <li class="flex items-center gap-2.5">
              <Check size={16} class="text-signal-600 flex-none" stroke-width={2} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Realistic website mockup with precise annotations -->
      <div class="col-span-12 lg:col-span-5 lg:pt-6">
        <div class="relative">
          <SiteMockup
            name="Maison Dupont"
            city="Fribourg"
            url="www.maison-dupont.ch"
            headline={pick(lang, { en: 'Seasonal cooking in the old town.', fr: 'Cuisine de saison en vieille ville.', de: 'Saisonale Küche in der Altstadt.', it: 'Cucina di stagione nel centro storico.' })}
            sub={pick(lang, { en: 'Lunch and dinner, Tuesday to Saturday. Reserve a table online.', fr: 'Midi et soir, du mardi au samedi. Réservez en ligne.', de: 'Mittag und Abend, Dienstag bis Samstag. Online reservieren.', it: 'Pranzo e cena, da martedì a sabato. Prenota online.' })}
            cta={pick(lang, { en: 'Reserve', fr: 'Réserver', de: 'Reservieren', it: 'Prenota' })}
            nav={[pick(lang, { en: 'Menu', fr: 'Carte', de: 'Karte', it: 'Menu' }), pick(lang, { en: 'About', fr: 'À propos', de: 'Über uns', it: 'Chi siamo' }), 'Contact']}
            info={[
              { k: pick(lang, { en: 'Open', fr: 'Ouvert', de: 'Geöffnet', it: 'Aperto' }), v: 'Tue–Sat · 11:30' },
              { k: pick(lang, { en: 'Address', fr: 'Adresse', de: 'Adresse', it: 'Indirizzo' }), v: 'Rue de Lausanne 12' },
              { k: pick(lang, { en: 'Phone', fr: 'Téléphone', de: 'Telefon', it: 'Telefono' }), v: '026 000 00 00' },
            ]}
            palette={{ bg: '#F7F3EC', ink: '#1F1A14', accent: '#8A3B1F', tone: '#E6DCCB', tone2: '#CDBB9E' }}
            motif="arch"
            label={pick(lang, { en: 'Example website for a restaurant in Fribourg', fr: 'Exemple de site web pour un restaurant à Fribourg', de: 'Beispiel-Website für ein Restaurant in Freiburg', it: 'Esempio di sito web per un ristorante a Friburgo' })}
            class="shadow-lift"
          />

          <!-- Spec annotations -->
          <ul class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-px bg-ink-900/10 border border-ink-900/10 rounded-[4px] overflow-hidden" aria-label={pick(lang, { en: 'Included as standard', fr: 'Inclus en standard', de: 'Standardmässig inbegriffen', it: 'Incluso di serie' })}>
            {[
              pick(lang, { en: 'Your domain', fr: 'Votre domaine', de: 'Ihre Domain', it: 'Tuo dominio' }),
              'SSL / HTTPS',
              pick(lang, { en: 'Mobile', fr: 'Mobile', de: 'Mobil', it: 'Mobile' }),
              pick(lang, { en: 'Basic SEO', fr: 'SEO de base', de: 'Basis-SEO', it: 'SEO di base' }),
            ].map((s) => (
              <li class="bg-paper px-3 py-2.5 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-steel-700 flex items-center gap-2">
                <span class="h-1.5 w-1.5 bg-signal-600 flex-none" aria-hidden="true"></span>{s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 20%, transparent 75%);
  }
</style>
