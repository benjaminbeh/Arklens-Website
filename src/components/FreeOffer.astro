---
import type { Language } from '@i18n/index';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { Check, ArrowRight, KeyRound } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  'website', 'domain', 'hosting', 'ssl', 'mobile', 'seo', 'intro',
  'services', 'contact', 'hours', 'map', 'social', 'language', 'revision',
];
---

<section class="section bg-white border-y border-ink-900/10" id="what-we-offer" aria-labelledby="offer-title">
  <div class="container-custom">
    <SectionHeader
      id="offer-title"
      index="02"
      eyebrow={pick(lang, { en: 'The offer', fr: 'L’offre', de: 'Das Angebot', it: 'L’offerta' })}
      title={t('freeOffer.title')}
    />

    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <!-- Price block -->
      <div class="col-span-12 lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--sfg-header-h)+2rem)]">
          <div class="border border-ink-900/15 rounded-md p-7">
            <p class="eyebrow">{pick(lang, { en: 'Website', fr: 'Site web', de: 'Website', it: 'Sito web' })}</p>
            <p class="mt-2 text-[3.5rem] leading-none font-semibold tracking-[-0.04em] text-ink-900">{'CHF\u00A00'}</p>
            <p class="mt-4 text-sm text-steel-600">
              {pick(lang, {
                en: 'Hosting included under the Free Website Programme.',
                fr: 'Hébergement inclus dans le Programme Site web gratuit.',
                de: 'Hosting im Programm «Kostenlose Website» inbegriffen.',
                it: 'Hosting incluso nel Programma Sito web gratuito.',
              })}
            </p>
            <div class="mt-7">
              <a href={getLocalizedPath('/start', lang)} class="btn btn-primary btn-block">
                {pick(lang, { en: 'Get my free website', fr: 'Demander mon site gratuit', de: 'Website kostenlos anfragen', it: 'Richiedi il sito gratuito' })}
                <ArrowRight size={16} class="arrow" stroke-width={1.75} />
              </a>
            </div>
          </div>

          <!-- Domain ownership note -->
          <div class="mt-4 flex gap-4 border-l-2 border-signal-600 bg-paper p-5">
            <KeyRound size={20} class="flex-none mt-0.5 text-ink-900" stroke-width={1.5} />
            <div>
              <p class="font-medium text-ink-900">
                {pick(lang, { en: 'Your domain always belongs to you', fr: 'Votre nom de domaine vous appartient toujours', de: 'Ihre Domain gehört immer Ihnen', it: 'Il dominio è sempre tuo' })}
              </p>
              <p class="mt-1.5 text-sm text-steel-600">{t('freeOffer.domain')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Spec sheet -->
      <div class="col-span-12 lg:col-span-8">
        <p class="eyebrow mb-4">{pick(lang, { en: 'Included', fr: 'Inclus', de: 'Inbegriffen', it: 'Incluso' })} · {features.length}</p>
        <ul class="grid sm:grid-cols-2 sm:gap-x-10 border-t border-ink-900/10">
          {features.map((feature, i) => (
            <li class="flex items-center gap-4 border-b border-ink-900/10 py-4">
              <span class="index-num w-6 flex-none">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 text-ink-900">{t(`freeOffer.features.${feature}` as any)}</span>
              <Check size={16} class="flex-none text-signal-600" stroke-width={2} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
