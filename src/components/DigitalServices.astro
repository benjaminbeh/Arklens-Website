---
import type { Language } from '@i18n/index';
import { getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { Users, MessageSquareText, ChartLine, Timer, ArrowRight } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const serviceCategories = [
  {
    key: 'get_customers',
    icon: Users,
    title: pick(lang, { en: 'Get more customers', fr: 'Gagner des clients', de: 'Mehr Kundschaft gewinnen', it: 'Trovare più clienti' }),
    services: [
      pick(lang, { en: 'Local SEO', fr: 'SEO local', de: 'Lokales SEO', it: 'SEO a livello locale' }),
      pick(lang, { en: 'Google Business Profile', fr: 'Profil d’entreprise Google', de: 'Google-Unternehmensprofil', it: 'Profilo dell’attività su Google' }),
      pick(lang, { en: 'Multilingual', fr: 'Site multilingue', de: 'Mehrsprachigkeit', it: 'Sito multilingue' }),
      pick(lang, { en: 'Review management', fr: 'Gestion des avis', de: 'Bewertungen verwalten', it: 'Gestione delle recensioni' }),
    ],
  },
  {
    key: 'serve_customers',
    icon: MessageSquareText,
    title: pick(lang, { en: 'Serve customers better', fr: 'Mieux servir vos clients', de: 'Kunden besser betreuen', it: 'Servire meglio i clienti' }),
    services: [
      pick(lang, { en: 'Online booking', fr: 'Réservation en ligne', de: 'Online-Buchung', it: 'Prenotazione online' }),
      pick(lang, { en: 'Quote requests', fr: 'Demandes d’offre', de: 'Offertanfragen', it: 'Richieste di offerta' }),
      pick(lang, { en: 'Accept payments', fr: 'Paiements en ligne', de: 'Online-Zahlungen', it: 'Pagamenti online' }),
      pick(lang, { en: 'Business email', fr: 'E-mail professionnel', de: 'Geschäfts-E-Mail', it: 'E-mail aziendale' }),
    ],
  },
  {
    key: 'run_business',
    icon: ChartLine,
    title: pick(lang, { en: 'Run your business better', fr: 'Mieux gérer votre entreprise', de: 'Ihr Unternehmen besser führen', it: 'Gestire meglio l’azienda' }),
    services: [
      pick(lang, { en: 'Understand visitors', fr: 'Comprendre vos visiteurs', de: 'Website-Besuche auswerten', it: 'Capire i visitatori' }),
      pick(lang, { en: 'Track leads', fr: 'Suivre les demandes', de: 'Anfragen nachverfolgen', it: 'Seguire i contatti' }),
      pick(lang, { en: 'More pages', fr: 'Pages supplémentaires', de: 'Weitere Seiten', it: 'Pagine aggiuntive' }),
    ],
  },
  {
    key: 'save_time',
    icon: Timer,
    title: pick(lang, { en: 'Save time', fr: 'Gagner du temps', de: 'Zeit sparen', it: 'Risparmiare tempo' }),
    services: [
      pick(lang, { en: 'Automate tasks', fr: 'Automatiser les tâches', de: 'Aufgaben automatisieren', it: 'Automatizzare le attività' }),
      pick(lang, { en: 'Connect tools', fr: 'Relier vos outils', de: 'Tools verbinden', it: 'Collegare gli strumenti' }),
      pick(lang, { en: 'Business workflows', fr: 'Flux de travail', de: 'Arbeitsabläufe', it: 'Flussi di lavoro' }),
    ],
  },
];
---

<section class="section bg-white border-y border-ink-900/10" id="add-features" aria-labelledby="services-title">
  <div class="container-custom">
    <SectionHeader
      id="services-title"
      index="06"
      eyebrow={pick(lang, { en: 'Add-ons', fr: 'Options', de: 'Erweiterungen', it: 'Opzioni' })}
      title={pick(lang, { en: 'Add what your business needs', fr: 'Ajoutez ce dont votre entreprise a besoin', de: 'Ergänzen Sie, was Ihr Unternehmen braucht', it: 'Aggiungi ciò che serve alla tua azienda' })}
      lead={pick(lang, {
        en: 'Start with a free website. Add paid services only when they create value for your business.',
        fr: 'Commencez avec un site gratuit. N’ajoutez des prestations payantes que lorsqu’elles apportent une réelle valeur à votre entreprise.',
        de: 'Starten Sie mit einer kostenlosen Website. Kostenpflichtige Leistungen kommen nur dazu, wenn sie Ihrem Unternehmen etwas bringen.',
        it: 'Inizia con un sito gratuito. Aggiungi servizi a pagamento solo quando portano valore alla tua azienda.',
      })}
    />

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-ink-900/10 border border-ink-900/10 rounded-md overflow-hidden">
      {serviceCategories.map((category) => {
        const Icon = category.icon;
        return (
          <li class="card-grid-hover relative bg-white p-7 transition-colors hover:bg-paper">
            <Icon size={22} class="text-ink-900" stroke-width={1.5} />
            <h3 class="mt-8 text-heading-sm text-ink-900">{category.title}</h3>
            <ul class="mt-5 space-y-2.5">
              {category.services.map((service) => (
                <li class="flex items-baseline gap-3 text-steel-700">
                  <span class="h-px w-3 flex-none translate-y-[-0.25em] bg-steel-400" aria-hidden="true"></span>
                  {service}
                </li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <p class="text-steel-600 max-w-2xl">
        {pick(lang, {
          en: 'Clear pricing before any paid work begins. No surprises, no subscriptions unless you want them.',
          fr: 'Des prix clairs avant tout travail payant. Pas de surprise, pas d’abonnement, sauf si vous le souhaitez.',
          de: 'Klare Preise, bevor kostenpflichtige Arbeit beginnt. Keine Überraschungen und kein Abo, ausser Sie wünschen es.',
          it: 'Prezzi chiari prima di ogni lavoro a pagamento. Nessuna sorpresa e nessun abbonamento, se non lo desideri.',
        })}
      </p>
      <a href={getLocalizedPath('/start?path=extend', lang)} class="link-arrow self-start sm:self-auto">
        {pick(lang, { en: 'Add a feature', fr: 'Ajouter une fonctionnalité', de: 'Funktion ergänzen', it: 'Aggiungi una funzionalità' })}
        <ArrowRight size={16} stroke-width={1.75} />
      </a>
    </div>
  </div>
</section>
