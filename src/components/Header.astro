---
import type { Language } from '@i18n/index';
import { useTranslations, languages, getLocalizedPath } from '@i18n/index';
import { ChevronDown, Menu, X, ArrowRight } from '@lucide/astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: '/#how-it-works', label: t('nav.howItWorks') },
  { href: '/#what-we-offer', label: t('nav.whatWeOffer') },
  { href: '/#examples', label: t('nav.examples') },
  { href: '/#for-business', label: t('nav.forBusiness') },
  { href: '/#faq', label: t('nav.faq') },
];

const langHref = (code: string) => (code === 'en' ? '/' : `/${code}/`);
const langShort = (code: string) => code.toUpperCase();
---

<header class="site-header fixed top-0 inset-x-0 z-50 border-b border-ink-900/10 bg-paper/95 backdrop-blur-md">
  <nav class="container-custom h-[var(--sfg-header-h)] flex items-center justify-between gap-6" aria-label="Main navigation">
    <!-- Wordmark -->
    <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5 text-ink-900 shrink-0" aria-label="Arklens, home">
      <span class="block h-3 w-3 bg-signal-600" aria-hidden="true"></span>
      <span class="text-[1.25rem] font-semibold tracking-[-0.03em]">Arklens</span>
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden lg:flex items-center gap-8">
      {navItems.map((item) => (
        <li>
          <a href={getLocalizedPath(item.href, lang)} class="nav-link text-[0.9375rem] text-steel-700 hover:text-ink-900 transition-colors">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:flex items-center gap-3">
      <!-- Language switcher -->
      <div class="relative" data-lang-switcher>
        <button
          type="button"
          class="flex items-center gap-1.5 h-10 px-3 rounded-[4px] font-mono text-xs tracking-[0.08em] text-steel-700 hover:text-ink-900 hover:bg-ink-900/[0.04] transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          data-lang-button
        >
          <span class="sr-only">Language: </span>{langShort(lang)}
          <ChevronDown size={14} stroke-width={1.75} />
        </button>
        <ul id="lang-menu" class="absolute right-0 mt-2 w-44 bg-white border border-ink-900/10 rounded-md shadow-lift py-1.5 hidden" data-lang-menu>
          {Object.entries(languages).map(([code, name]) => (
            <li>
              <a
                href={langHref(code)}
                hreflang={code}
                lang={code}
                aria-current={code === lang ? 'true' : undefined}
                class="flex items-center justify-between px-4 py-2.5 text-sm text-steel-700 hover:bg-paper hover:text-ink-900"
              >
                {name}
                <span class="font-mono text-[0.6875rem] text-steel-500">{langShort(code)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a href="/start" class="btn btn-primary min-h-[2.75rem] px-5">
        {t('nav.getStarted')}
        <ArrowRight size={16} class="arrow" stroke-width={1.75} />
      </a>
    </div>

    <!-- Mobile: CTA stays visible, menu behind a toggle -->
    <div class="flex lg:hidden items-center gap-2">
      <a href="/start" class="btn btn-primary min-h-[2.75rem] px-3.5 min-[375px]:px-4 text-sm">
        {t('nav.getStarted')}
      </a>
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-[4px] text-ink-900 hover:bg-ink-900/[0.05]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <Menu size={22} stroke-width={1.75} data-icon-open />
        <X size={22} stroke-width={1.75} class="hidden" data-icon-close />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink-900/10 bg-paper" data-mobile-menu>
    <div class="container-custom py-4">
      <ul class="flex flex-col">
        {navItems.map((item, i) => (
          <li class="border-b border-ink-900/10">
            <a href={getLocalizedPath(item.href, lang)} class="flex items-center justify-between py-4 text-lg font-medium text-ink-900" data-mobile-link>
              {item.label}
              <span class="font-mono text-xs text-steel-500">{String(i + 1).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="flex gap-2 py-5" role="group" aria-label="Language">
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={langHref(code)}
            hreflang={code}
            lang={code}
            aria-label={name}
            aria-current={code === lang ? 'true' : undefined}
            class:list={[
              'flex h-11 min-w-[2.75rem] items-center justify-center rounded-[4px] border font-mono text-xs tracking-[0.08em]',
              code === lang ? 'border-ink-900 text-ink-900' : 'border-ink-900/15 text-steel-600',
            ]}
          >
            {langShort(code)}
          </a>
        ))}
      </div>
      <a href="/start" class="btn btn-primary btn-lg btn-block">
        {t('nav.getStarted')}
        <ArrowRight size={18} class="arrow" stroke-width={1.75} />
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconOpen = document.querySelector('[data-icon-open]');
  const iconClose = document.querySelector('[data-icon-close]');

  function setMenu(open: boolean) {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });
  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  const langButton = document.querySelector<HTMLButtonElement>('[data-lang-button]');
  const langMenu = document.querySelector<HTMLElement>('[data-lang-menu]');

  function setLang(open: boolean) {
    if (!langButton || !langMenu) return;
    langButton.setAttribute('aria-expanded', String(open));
    langMenu.classList.toggle('hidden', !open);
  }

  langButton?.addEventListener('click', () => {
    setLang(langButton.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (langButton && langMenu && !langButton.contains(target) && !langMenu.contains(target)) setLang(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (langButton?.getAttribute('aria-expanded') === 'true') {
      setLang(false);
      langButton.focus();
    }
    if (menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
