---
import type { Language } from '@i18n/index';
import { getLocalizedPath } from '@i18n/index';
import { pick } from '@lib/pick';
import { ArrowRight } from '@lucide/astro';
import SectionHeader from '@components/ui/SectionHeader.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

type Status = 'good' | 'opportunity' | 'manual' | 'missing';

const statusLabel: Record<Status, string> = {
  good: pick(lang, { en: 'Good', fr: 'Bon', de: 'Gut', it: 'Buono' }),
  opportunity: pick(lang, { en: 'Opportunity', fr: 'Potentiel', de: 'Potenzial', it: 'Opportunità' }),
  manual: pick(lang, { en: 'Manual', fr: 'Manuel', de: 'Manuell', it: 'Manuale' }),
  missing: pick(lang, { en: 'Missing', fr: 'Absent', de: 'Fehlt', it: 'Assente' }),
};

const rows: { area: string; note: string; status: Status; score: number }[] = [
  {
    area: pick(lang, { en: 'Website', fr: 'Site web', de: 'Website', it: 'Sito web' }),
    note: pick(lang, { en: 'Online, contact details easy to find', fr: 'En ligne, coordonnées faciles à trouver', de: 'Online, Kontaktdaten leicht auffindbar', it: 'Online, contatti facili da trovare' }),
    status: 'good', score: 4,
  },
  {
    area: pick(lang, { en: 'Google visibility', fr: 'Visibilité Google', de: 'Google-Sichtbarkeit', it: 'Visibilità Google' }),
    note: pick(lang, { en: 'Profile incomplete, few reviews', fr: 'Profil incomplet, peu d’avis', de: 'Profil unvollständig, wenige Bewertungen', it: 'Profilo incompleto, poche recensioni' }),
    status: 'opportunity', score: 2,
  },
  {
    area: pick(lang, { en: 'Customer enquiries', fr: 'Demandes clients', de: 'Kundenanfragen', it: 'Richieste clienti' }),
    note: pick(lang, { en: 'Handled by phone and email', fr: 'Traitées par téléphone et e-mail', de: 'Per Telefon und E-Mail', it: 'Gestite via telefono ed e-mail' }),
    status: 'manual', score: 2,
  },
  {
    area: pick(lang, { en: 'Booking', fr: 'Réservation', de: 'Buchung', it: 'Prenotazioni' }),
    note: pick(lang, { en: 'No online booking available', fr: 'Pas de réservation en ligne', de: 'Keine Online-Buchung', it: 'Nessuna prenotazione online' }),
    status: 'missing', score: 0,
  },
  {
    area: pick(lang, { en: 'Automation opportunities', fr: 'Potentiel d’automatisation', de: 'Potenzial für Automatisierung', it: 'Opportunità di automazione' }),
    note: pick(lang, { en: 'Enquiries copied by hand into a spreadsheet', fr: 'Demandes recopiées à la main dans un tableur', de: 'Anfragen werden von Hand in eine Tabelle übertragen', it: 'Richieste copiate a mano in un foglio di calcolo' }),
    status: 'opportunity', score: 1,
  },
  {
    area: pick(lang, { en: 'AI readiness', fr: 'Préparation à l’IA', de: 'KI-Bereitschaft', it: 'Preparazione all’IA' }),
    note: pick(lang, { en: 'FAQs and price lists ready for AI-assisted answers', fr: 'FAQ et tarifs prêts pour des réponses assistées par l’IA', de: 'FAQ und Preislisten bereit für KI-gestützte Antworten', it: 'FAQ e listini pronti per risposte assistite dall’IA' }),
    status: 'opportunity', score: 2,
  },
];

const checks = [
  pick(lang, { en: 'Website and mobile experience', fr: 'Site web et expérience mobile', de: 'Website und mobile Nutzung', it: 'Sito web ed esperienza mobile' }),
  pick(lang, { en: 'Google and local visibility', fr: 'Visibilité Google et locale', de: 'Google- und lokale Sichtbarkeit', it: 'Visibilità Google e locale' }),
  pick(lang, { en: 'How enquiries and bookings arrive', fr: 'Comment arrivent les demandes et les réservations', de: 'Wie Anfragen und Buchungen eingehen', it: 'Come arrivano richieste e prenotazioni' }),
  pick(lang, { en: 'Automation opportunities: where time is lost to manual work', fr: 'Potentiel d’automatisation\u00A0: où le temps se perd en tâches manuelles', de: 'Automatisierungspotenzial: wo Zeit durch Handarbeit verloren geht', it: 'Opportunità di automazione: dove si perde tempo in lavoro manuale' }),
  pick(lang, { en: 'AI readiness: documents and information AI could use safely', fr: 'Préparation à l’IA\u00A0: documents et informations que l’IA peut utiliser en toute sécurité', de: 'KI-Bereitschaft: Dokumente und Informationen, die KI sicher nutzen kann', it: 'Preparazione all’IA: documenti e informazioni che l’IA può usare in sicurezza' }),
];
---

<section class="section bg-paper" aria-labelledby="check-title">
  <div class="container-custom">
    <SectionHeader
      id="check-title"
      index="08"
      eyebrow={pick(lang, { en: 'Diagnostics', fr: 'Diagnostic', de: 'Diagnose', it: 'Diagnostica' })}
      title={pick(lang, { en: 'Free Digital Business Check', fr: 'Évaluation numérique gratuite', de: 'Kostenloser Digital-Check', it: 'Analisi digitale gratuita' })}
      lead={pick(lang, {
        en: 'Understand where your business stands digitally and discover practical improvements.',
        fr: 'Faites le point sur la situation numérique de votre entreprise et découvrez des améliorations concrètes.',
        de: 'Erfahren Sie, wo Ihr Unternehmen digital steht, und entdecken Sie konkrete Verbesserungen.',
        it: 'Scopri a che punto è la tua azienda nel digitale e quali miglioramenti concreti sono possibili.',
      })}
    />

    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 lg:col-span-4">
        <p class="eyebrow mb-4">{pick(lang, { en: 'What we check', fr: 'Ce que nous analysons', de: 'Was wir prüfen', it: 'Cosa controlliamo' })}</p>
        <ol class="border-t border-ink-900/10">
          {checks.map((c, i) => (
            <li class="flex gap-4 border-b border-ink-900/10 py-3.5 text-ink-900">
              <span class="index-num w-6 flex-none">{String(i + 1).padStart(2, '0')}</span>{c}
            </li>
          ))}
        </ol>
        <a href={getLocalizedPath('/start?path=check', lang)} class="btn btn-primary btn-lg mt-8">
          {pick(lang, { en: 'Check my business', fr: 'Évaluer mon entreprise', de: 'Mein Unternehmen prüfen', it: 'Analizza la mia azienda' })}
          <ArrowRight size={18} class="arrow" stroke-width={1.75} />
        </a>
      </div>

      <!-- Example report -->
      <div class="col-span-12 lg:col-span-8">
        <figure class="report bg-white border border-ink-900/15 rounded-md overflow-hidden" data-signal>
          <figcaption class="flex flex-wrap items-center justify-between gap-3 px-5 sm:px-7 py-4 border-b border-ink-900/10 bg-paper/60">
            <span class="eyebrow text-ink-900">{pick(lang, { en: 'Example report', fr: 'Exemple de rapport', de: 'Beispielbericht', it: 'Report di esempio' })}</span>
            <span class="font-mono text-xs text-steel-600">{pick(lang, { en: 'Local business', fr: 'Entreprise locale', de: 'Lokales Unternehmen', it: 'Azienda locale' })} · CH</span>
          </figcaption>

          <table class="w-full text-left">
            <caption class="sr-only">{pick(lang, { en: 'Example diagnostic results by area', fr: 'Exemple de résultats par domaine', de: 'Beispielergebnisse nach Bereich', it: 'Risultati di esempio per area' })}</caption>
            <thead class="sr-only">
              <tr>
                <th scope="col">{pick(lang, { en: 'Area', fr: 'Domaine', de: 'Bereich', it: 'Area' })}</th>
                <th scope="col">{pick(lang, { en: 'Level', fr: 'Niveau', de: 'Stand', it: 'Livello' })}</th>
                <th scope="col">{pick(lang, { en: 'Status', fr: 'Statut', de: 'Status', it: 'Stato' })}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row, i) => (
                <tr class="report-row border-b border-ink-900/10 last:border-0" style={`--i:${i}`}>
                  <th scope="row" class="py-4 pl-5 sm:pl-7 pr-3 align-top font-normal">
                    <span class="block font-medium text-ink-900">{row.area}</span>
                    <span class="block text-sm text-steel-600 mt-0.5">{row.note}</span>
                  </th>
                  <td class="hidden sm:table-cell py-4 px-3 align-middle w-36">
                    <span class="meter" role="img" aria-label={pick(lang, { en: `${row.score} / 5`, fr: `${row.score} sur 5`, de: `${row.score} von 5`, it: `${row.score} su 5` })}>
                      {[0, 1, 2, 3, 4].map((n) => <i class:list={[n < row.score && 'on']}></i>)}
                    </span>
                  </td>
                  <td class="py-4 pr-5 sm:pr-7 pl-3 align-top sm:align-middle text-right w-[1%] whitespace-nowrap">
                    <span class:list={['status', `status-${row.status}`]}>
                      <span class="status-mark" aria-hidden="true"></span>
                      {statusLabel[row.status]}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="px-5 sm:px-7 py-5 border-t border-ink-900/15 bg-paper/60 grid sm:grid-cols-[auto_1fr] gap-x-6 gap-y-1">
            <span class="eyebrow">{pick(lang, { en: 'Recommendation', fr: 'Recommandation', de: 'Empfehlung', it: 'Raccomandazione' })}</span>
            <p class="text-sm text-ink-900">
              {pick(lang, {
                en: 'Add online booking to reduce calls. Then let AI draft answers to repeated questions from your FAQs.',
                fr: 'Ajoutez la réservation en ligne pour réduire les appels. Laissez ensuite l’IA préparer des réponses aux questions récurrentes à partir de vos FAQ.',
                de: 'Ergänzen Sie eine Online-Buchung, um Anrufe zu reduzieren. Danach kann KI aus Ihren FAQ Antworten auf wiederkehrende Fragen vorbereiten.',
                it: 'Aggiungi la prenotazione online per ridurre le chiamate. Poi lascia che l’IA prepari risposte alle domande ricorrenti dalle tue FAQ.',
              })}
            </p>
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .meter {
    display: inline-grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
    width: 100%;
    max-width: 7.5rem;
  }
  .meter i {
    display: block;
    height: 6px;
    background: theme('colors.steel.100');
  }
  .meter i.on {
    background: theme('colors.ink.900');
  }

  .status-mark {
    width: 8px;
    height: 8px;
    flex: none;
  }
  .status-good { color: theme('colors.ink.900'); }
  .status-good .status-mark { background: theme('colors.ink.900'); }
  .status-opportunity { color: theme('colors.signal.700'); }
  .status-opportunity .status-mark { border: 1.5px solid theme('colors.signal.600'); }
  .status-manual { color: theme('colors.steel.600'); }
  .status-manual .status-mark { background: linear-gradient(90deg, theme('colors.steel.500') 50%, transparent 50%); border: 1px solid theme('colors.steel.500'); }
  .status-missing { color: theme('colors.steel.600'); }
  .status-missing .status-mark { height: 1.5px; background: theme('colors.steel.500'); }

  /* rows settle in sequence like a scan completing */
  :global(.motion-ok) .meter i.on {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    transition-delay: calc(var(--i) * 140ms + 200ms);
  }
  :global(.motion-ok) .report:global(.is-visible) .meter i.on {
    transform: none;
  }
</style>
