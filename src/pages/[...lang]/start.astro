---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { pick } from '@lib/pick';
import { TURNSTILE_SITE_KEY_PROD, TURNSTILE_SITE_KEY_TEST } from '@lib/contact';
import { START_LIMITS, TURNSTILE_ACTION_START, type StartIndustry, type StartPath } from '@lib/start';
import { ArrowRight, ArrowLeft, Check, SquarePlus, RefreshCw, Blocks, Activity } from '@lucide/astro';

import { localeStaticPaths, getLocalizedPath, type Language } from '@i18n/index';
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props as { lang: Language };
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_SITE_KEY_TEST : TURNSTILE_SITE_KEY_PROD);

const steps = [
  pick(lang, { en: 'Starting point', fr: 'Point de départ', de: 'Einstieg', it: 'Punto di partenza' }),
  pick(lang, { en: 'Your business', fr: 'Votre entreprise', de: 'Ihr Unternehmen', it: 'La tua azienda' }),
  pick(lang, { en: 'Contact', fr: 'Contact', de: 'Kontakt', it: 'Contatto' }),
];

const paths = [
  {
    value: 'new',
    icon: SquarePlus,
    title: pick(lang, { en: 'I need a website', fr: 'J’ai besoin d’un site web', de: 'Ich brauche eine Website', it: 'Mi serve un sito web' }),
    text: pick(lang, { en: 'Start fresh with a professional online presence', fr: 'Partir de zéro avec une présence numérique professionnelle', de: 'Mit einer professionellen digitalen Präsenz neu starten', it: 'Parti da zero con una presenza digitale professionale' }),
  },
  {
    value: 'update',
    icon: RefreshCw,
    title: pick(lang, { en: 'My website needs an update', fr: 'Mon site doit être mis à jour', de: 'Meine Website muss erneuert werden', it: 'Il mio sito va aggiornato' }),
    text: pick(lang, { en: 'Modernise or improve your existing website', fr: 'Moderniser ou améliorer votre site actuel', de: 'Die bestehende Website modernisieren oder verbessern', it: 'Modernizza o migliora il sito attuale' }),
  },
  {
    value: 'extend',
    icon: Blocks,
    title: pick(lang, { en: 'My website works, but I need more', fr: 'Mon site fonctionne, mais il m’en faut plus', de: 'Meine Website funktioniert, aber ich brauche mehr', it: 'Il mio sito funziona, ma mi serve di più' }),
    text: pick(lang, { en: 'Add bookings, forms, payments, integrations, automation and AI', fr: 'Ajouter réservations, formulaires, paiements, intégrations, automatisation et IA', de: 'Buchungen, Formulare, Zahlungen, Integrationen, Automatisierung und KI ergänzen', it: 'Aggiungi prenotazioni, moduli, pagamenti, integrazioni, automazione e IA' }),
  },
  {
    value: 'check',
    icon: Activity,
    title: pick(lang, { en: 'Check my business first', fr: 'Évaluer d’abord mon entreprise', de: 'Zuerst mein Unternehmen prüfen', it: 'Prima analizza la mia azienda' }),
    text: pick(lang, { en: 'Free Digital Business Check with practical recommendations', fr: 'Évaluation numérique gratuite, avec des recommandations concrètes', de: 'Kostenloser Digital-Check mit konkreten Empfehlungen', it: 'Analisi digitale gratuita con consigli concreti' }),
  },
] satisfies ({ value: StartPath } & Record<string, unknown>)[];

const industries = [
  { value: 'restaurant', label: pick(lang, { en: 'Restaurant / Café', fr: 'Restaurant / café', de: 'Restaurant / Café', it: 'Ristorante / bar' }) },
  { value: 'beauty', label: pick(lang, { en: 'Hair & Beauty', fr: 'Coiffure & beauté', de: 'Coiffeur & Kosmetik', it: 'Parrucchiere & estetica' }) },
  { value: 'trades', label: pick(lang, { en: 'Trades / Crafts', fr: 'Artisanat', de: 'Handwerk', it: 'Artigianato' }) },
  { value: 'consultant', label: pick(lang, { en: 'Consulting', fr: 'Conseil', de: 'Beratung', it: 'Consulenza' }) },
  { value: 'health', label: pick(lang, { en: 'Healthcare', fr: 'Santé', de: 'Gesundheit', it: 'Salute' }) },
  { value: 'garage', label: pick(lang, { en: 'Garage / Automotive', fr: 'Garage / automobile', de: 'Garage / Auto', it: 'Garage / auto' }) },
  { value: 'retail', label: pick(lang, { en: 'Retail / Shop', fr: 'Commerce / magasin', de: 'Detailhandel', it: 'Negozio / commercio' }) },
  { value: 'services', label: pick(lang, { en: 'Professional Services', fr: 'Services professionnels', de: 'Dienstleistungen', it: 'Servizi professionali' }) },
  { value: 'other', label: pick(lang, { en: 'Other', fr: 'Autre', de: 'Andere', it: 'Altro' }) },
] satisfies ({ value: StartIndustry } & Record<string, unknown>)[];

const next = [
  pick(lang, { en: 'We’ll review your information (usually within 24 hours)', fr: 'Nous examinons vos informations (en général sous 24 heures)', de: 'Wir prüfen Ihre Angaben (meist innerhalb von 24 Stunden)', it: 'Esaminiamo le tue informazioni (di solito entro 24 ore)' }),
  pick(lang, { en: 'We’ll contact you about the next steps', fr: 'Nous vous contactons ensuite au sujet des prochaines étapes', de: 'Danach melden wir uns bei Ihnen zu den nächsten Schritten', it: 'Poi ti contattiamo per i prossimi passi' }),
];

const T = {
  required: pick(lang, { en: 'required', fr: 'obligatoire', de: 'Pflichtfeld', it: 'obbligatorio' }),
  optional: pick(lang, { en: 'Optional', fr: 'Facultatif', de: 'Optional', it: 'Facoltativo' }),
  continue: pick(lang, { en: 'Continue', fr: 'Continuer', de: 'Weiter', it: 'Continua' }),
  back: pick(lang, { en: 'Back', fr: 'Retour', de: 'Zurück', it: 'Indietro' }),
  submit: pick(lang, { en: 'Send my request', fr: 'Envoyer ma demande', de: 'Anfrage senden', it: 'Invia la richiesta' }),
  stepOf: pick(lang, { en: 'Step {n} of {t}', fr: 'Étape {n} sur {t}', de: 'Schritt {n} von {t}', it: 'Passo {n} di {t}' }),
  name: pick(lang, { en: 'Your name', fr: 'Votre nom', de: 'Ihr Name', it: 'Il tuo nome' }),
  // Same wording as the contact form's name error.
  nameError: pick(lang, { en: 'Please enter your name.', fr: 'Veuillez indiquer votre nom.', de: 'Bitte geben Sie Ihren Namen ein.', it: 'Inserisci il tuo nome.' }),
  // Terms acceptance sentence, split around the two links.
  termsBefore: pick(lang, { en: 'I agree to the ', fr: 'J’accepte les ', de: 'Ich stimme den ', it: 'Accetto le ' }),
  termsLink: pick(lang, { en: 'Terms of Use', fr: 'Conditions d’utilisation', de: 'Nutzungsbedingungen', it: 'Condizioni d’uso' }),
  termsMiddle: pick(lang, { en: ' and acknowledge the ', fr: ' et reconnais avoir pris connaissance de la ', de: ' zu und bestätige, die ', it: ' e confermo di aver preso visione dell’' }),
  privacyLink: pick(lang, { en: 'Privacy Policy', fr: 'Politique de confidentialité', de: 'Datenschutzerklärung', it: 'Informativa sulla privacy' }),
  termsAfter: pick(lang, { en: '.', fr: '.', de: ' zur Kenntnis genommen zu haben.', it: '.' }),
  termsError: pick(lang, {
    en: 'Please agree to the Terms of Use before submitting your application.',
    fr: 'Veuillez accepter les Conditions d’utilisation avant d’envoyer votre demande.',
    de: 'Bitte stimmen Sie den Nutzungsbedingungen zu, bevor Sie Ihre Anfrage absenden.',
    it: 'Accetta le Condizioni d’uso prima di inviare la richiesta.',
  }),
  newTab: pick(lang, { en: 'Opens in a new tab', fr: 'S’ouvre dans un nouvel onglet', de: 'Öffnet in einem neuen Tab', it: 'Si apre in una nuova scheda' }),
  phoneError: pick(lang, {
    en: 'Please enter a valid phone number, or leave this field empty.',
    fr: 'Veuillez saisir un numéro de téléphone valide ou laisser ce champ vide.',
    de: 'Bitte geben Sie eine gültige Telefonnummer ein oder lassen Sie das Feld leer.',
    it: 'Inserisci un numero di telefono valido o lascia vuoto il campo.',
  }),
  honeypot: pick(lang, { en: 'Leave this field empty', fr: 'Laissez ce champ vide', de: 'Dieses Feld leer lassen', it: 'Lascia vuoto questo campo' }),
  turnstile: pick(lang, {
    en: 'Please complete the security check.',
    fr: 'Veuillez effectuer la vérification de sécurité.',
    de: 'Bitte schliessen Sie die Sicherheitsprüfung ab.',
    it: 'Completa il controllo di sicurezza.',
  }),
  noscript: pick(lang, {
    en: 'Please enable JavaScript to send this form.',
    fr: 'Veuillez activer JavaScript pour envoyer ce formulaire.',
    de: 'Bitte aktivieren Sie JavaScript, um dieses Formular zu senden.',
    it: 'Attiva JavaScript per inviare questo modulo.',
  }),
  formErrorTitle: pick(lang, {
    en: 'We couldn’t send your request.',
    fr: 'Votre demande n’a pas pu être envoyée.',
    de: 'Ihre Anfrage konnte nicht gesendet werden.',
    it: 'Non è stato possibile inviare la richiesta.',
  }),
  retry: pick(lang, { en: 'Please try again.', fr: 'Veuillez réessayer.', de: 'Bitte versuchen Sie es erneut.', it: 'Riprova.' }),
  sending: pick(lang, { en: 'Sending…', fr: 'Envoi en cours…', de: 'Wird gesendet…', it: 'Invio in corso…' }),
  invalid: pick(lang, {
    en: 'Please check the highlighted fields.',
    fr: 'Veuillez vérifier les champs signalés.',
    de: 'Bitte prüfen Sie die markierten Felder.',
    it: 'Controlla i campi evidenziati.',
  }),
  rateLimited: pick(lang, {
    en: 'Too many attempts. Please wait a few minutes before trying again.',
    fr: 'Trop de tentatives. Veuillez patienter quelques minutes avant de réessayer.',
    de: 'Zu viele Versuche. Bitte warten Sie einige Minuten und versuchen Sie es dann erneut.',
    it: 'Troppi tentativi. Attendi qualche minuto prima di riprovare.',
  }),
  verification: pick(lang, {
    en: 'The security check expired. Please complete it again.',
    fr: 'La vérification de sécurité a expiré. Veuillez la refaire.',
    de: 'Die Sicherheitsprüfung ist abgelaufen. Bitte führen Sie sie erneut durch.',
    it: 'Il controllo di sicurezza è scaduto. Completalo di nuovo.',
  }),
  network: pick(lang, {
    en: 'Please check your connection.',
    fr: 'Veuillez vérifier votre connexion internet.',
    de: 'Bitte prüfen Sie Ihre Internetverbindung.',
    it: 'Controlla la tua connessione a internet.',
  }),
  successTitle: pick(lang, {
    en: 'Thank you. Your request has been submitted to Arklens for review.',
    fr: 'Merci. Votre demande a été transmise à Arklens pour examen.',
    de: 'Danke. Ihre Anfrage wurde Arklens zur Prüfung übermittelt.',
    it: 'Grazie. La tua richiesta è stata inviata ad Arklens per la valutazione.',
  }),
  successReference: pick(lang, {
    en: 'Your application reference is:',
    fr: 'Votre référence de demande\u00A0:',
    de: 'Ihre Referenz lautet:',
    it: 'Il riferimento della tua richiesta è:',
  }),
  successConfirmation: pick(lang, {
    en: 'We have also sent a confirmation to your email address.',
    fr: 'Nous vous avons également envoyé une confirmation par e-mail.',
    de: 'Wir haben Ihnen zudem eine Bestätigung per E-Mail gesendet.',
    it: 'Ti abbiamo anche inviato una conferma via e-mail.',
  }),
  successReview: pick(lang, {
    en: 'This does not mean the project has been accepted. Arklens will contact you after reviewing your request.',
    fr: 'Cela ne signifie pas que le projet a été accepté. Arklens vous contactera après avoir examiné votre demande.',
    de: 'Das bedeutet nicht, dass das Projekt angenommen wurde. Arklens meldet sich bei Ihnen, nachdem Ihre Anfrage geprüft wurde.',
    it: 'Questo non significa che il progetto sia stato accettato. Arklens ti contatterà dopo aver esaminato la tua richiesta.',
  }),
};
---

<BaseLayout
  title={pick(lang, { en: 'Get Started', fr: 'Commencer', de: 'Loslegen', it: 'Inizia' })}
  description={pick(lang, {
    en: 'Request your free Arklens website in three short steps: tell us where you are starting from, describe your business and share your contact details.',
    fr: 'Demandez votre site web gratuit en quelques minutes avec Arklens, en trois étapes simples.',
    de: 'Fragen Sie Ihre kostenlose Website bei Arklens an: drei kurze Schritte, wenige Minuten.',
    it: 'Richiedi il tuo sito web gratuito ad Arklens in pochi minuti, in tre semplici passi.',
  })}
  lang={lang}
>
  <Header lang={lang} />

  <main id="main" class="pt-[calc(var(--sfg-header-h)+2.5rem)] md:pt-[calc(var(--sfg-header-h)+4rem)] pb-20 md:pb-28">
    <div class="container-custom">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <!-- Guide column -->
        <aside class="col-span-12 lg:col-span-4">
          <div class="lg:sticky lg:top-[calc(var(--sfg-header-h)+2.5rem)]">
            <p class="eyebrow flex items-center gap-3 mb-6">
              <span class="h-px w-8 bg-signal-600" aria-hidden="true"></span>
              {pick(lang, { en: 'Free Website Programme', fr: 'Programme Site web gratuit', de: 'Programm «Kostenlose Website»', it: 'Programma Sito web gratuito' })}
            </p>
            <h1 class="text-display-md">{pick(lang, { en: 'Let’s get started', fr: 'C’est parti', de: 'Legen wir los', it: 'Iniziamo' })}</h1>
            <p class="lead mt-5">
              {pick(lang, {
                en: 'Tell us about your business so we can create the right starting point for you. It takes about two minutes.',
                fr: 'Présentez-nous votre entreprise pour que nous puissions définir le bon point de départ. Cela prend environ deux minutes.',
                de: 'Erzählen Sie uns von Ihrem Unternehmen, damit wir den passenden Einstieg für Sie finden. Das dauert etwa zwei Minuten.',
                it: 'Raccontaci della tua azienda, così possiamo definire il punto di partenza giusto. Bastano circa due minuti.',
              })}
            </p>

            <!-- Progress (Signal Line) -->
            <ol class="progress mt-10" aria-label={pick(lang, { en: 'Progress', fr: 'Progression', de: 'Fortschritt', it: 'Avanzamento' })} data-progress>
              {steps.map((label, i) => (
                <li class="progress-step" data-step-indicator={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="progress-node" aria-hidden="true"></span>
                  <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="progress-label">{label}</span>
                </li>
              ))}
            </ol>

            <div class="hidden lg:block mt-12 border-t border-ink-900/10 pt-6">
              <h2 class="eyebrow mb-4">{pick(lang, { en: 'What happens next?', fr: 'Et ensuite\u202F?', de: 'Wie geht es weiter?', it: 'E poi?' })}</h2>
              <ul class="space-y-3">
                {next.map((n) => (
                  <li class="flex gap-3 text-sm text-steel-700">
                    <Check size={16} class="mt-0.5 flex-none text-signal-600" stroke-width={2} />{n}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

        <!-- Form column -->
        <div class="col-span-12 lg:col-span-8">
          <div class="bg-white border border-ink-900/10 rounded-md">
            <p class="sr-only" aria-live="polite" data-step-announcer></p>

            <form id="onboarding-form" class="p-6 sm:p-10" novalidate data-sitekey={siteKey} data-action={TURNSTILE_ACTION_START}
              data-lang={lang} data-msg-sending={T.sending} data-msg-submit={T.submit} data-msg-invalid={T.invalid}
              data-msg-rate-limited={T.rateLimited} data-msg-verification={T.verification} data-msg-network={T.network}
              data-msg-retry={T.retry}>
              <div class="hidden mb-8 border-l-2 border-signal-600 bg-paper p-4" role="alert" data-form-error tabindex="-1">
                <h3 class="font-medium text-ink-900">{T.formErrorTitle}</h3>
                <p class="mt-1 text-sm text-steel-700" data-form-error-detail>{T.retry}</p>
              </div>

              <!-- Step 1 -->
              <fieldset class="step" data-step="0">
                <legend class="step-legend">
                  <span class="eyebrow block mb-3">{T.stepOf.replace('{n}', '1').replace('{t}', '3')}</span>
                  <span class="block text-heading-lg text-ink-900">{pick(lang, { en: 'What brings you here today?', fr: 'Qu’est-ce qui vous amène\u202F?', de: 'Was führt Sie zu uns?', it: 'Cosa ti porta da noi?' })}</span>
                </legend>

                <div class="mt-8 grid gap-3">
                  {paths.map((p) => {
                    const Icon = p.icon;
                    return (
                      <label class="choice">
                        <input type="radio" name="path" value={p.value} required />
                        <span class="max-sm:hidden flex h-10 w-10 flex-none items-center justify-center border border-ink-900/15 rounded-[4px] text-ink-900">
                          <Icon size={20} stroke-width={1.5} />
                        </span>
                        <span class="flex-1">
                          <span class="block font-medium text-ink-900">{p.title}</span>
                          <span class="block text-sm text-steel-600 mt-1">{p.text}</span>
                        </span>
                        <span class="choice-mark" aria-hidden="true"><Check size={12} stroke-width={3} /></span>
                      </label>
                    );
                  })}
                </div>
                <p id="path-error" class="error hidden" data-error-for="path">
                  {pick(lang, { en: 'Please choose a starting point.', fr: 'Veuillez choisir un point de départ.', de: 'Bitte wählen Sie einen Ausgangspunkt.', it: 'Scegli un punto di partenza.' })}
                </p>

                <div id="current-website-field" class="mt-8 hidden">
                  <label for="current-website" class="field-label">
                    {pick(lang, { en: 'Current website URL', fr: 'Adresse de votre site actuel', de: 'Adresse Ihrer aktuellen Website', it: 'Indirizzo del sito attuale' })}
                  </label>
                  <input
                    type="url"
                    id="current-website"
                    name="current-website"
                    inputmode="url"
                    autocomplete="url"
                    class="field"
                    maxlength={START_LIMITS.website}
                    placeholder={pick(lang, { en: 'https://www.your-website.ch', fr: 'https://www.votre-entreprise.ch', de: 'https://www.ihre-firma.ch', it: 'https://www.tua-azienda.ch' })}
                    aria-describedby="current-website-hint current-website-error"
                  />
                  <p id="current-website-hint" class="field-hint">
                    {pick(lang, { en: 'We’ll review your current site to understand what you already have.', fr: 'Nous analysons votre site actuel pour voir ce qui existe déjà.', de: 'Wir schauen uns Ihre aktuelle Website an, um zu sehen, was schon vorhanden ist.', it: 'Analizziamo il sito attuale per capire cosa c’è già.' })}
                  </p>
                  <p id="current-website-error" class="error hidden" data-error-for="current-website">
                    {pick(lang, { en: 'Please enter a full address, starting with https://', fr: 'Veuillez saisir l’adresse complète, en commençant par https://', de: 'Bitte geben Sie die vollständige Adresse ein, beginnend mit https://', it: 'Inserisci l’indirizzo completo, che inizia con https://' })}
                  </p>
                </div>
              </fieldset>

              <!-- Step 2 -->
              <fieldset class="step" data-step="1">
                <legend class="step-legend">
                  <span class="eyebrow block mb-3">{T.stepOf.replace('{n}', '2').replace('{t}', '3')}</span>
                  <span class="block text-heading-lg text-ink-900">{pick(lang, { en: 'Tell us about your business', fr: 'Présentez-nous votre entreprise', de: 'Erzählen Sie uns von Ihrem Unternehmen', it: 'Parlaci della tua azienda' })}</span>
                </legend>

                <div class="mt-8">
                  <label for="business-name" class="field-label">
                    {pick(lang, { en: 'Business name', fr: 'Nom de l’entreprise', de: 'Name des Unternehmens', it: 'Nome dell’azienda' })}
                  </label>
                  <input
                    type="text"
                    id="business-name"
                    name="business-name"
                    required
                    autocomplete="organization"
                    class="field"
                    maxlength={START_LIMITS.business}
                    aria-describedby="business-name-error"
                  />
                  <p id="business-name-error" class="error hidden" data-error-for="business-name">
                    {pick(lang, { en: 'Please enter your business name.', fr: 'Veuillez indiquer le nom de votre entreprise.', de: 'Bitte geben Sie den Namen Ihres Unternehmens ein.', it: 'Inserisci il nome della tua azienda.' })}
                  </p>
                </div>

                <fieldset class="mt-8" aria-describedby="industry-error">
                  <legend class="field-label">{pick(lang, { en: 'Industry', fr: 'Secteur', de: 'Branche', it: 'Settore' })}</legend>
                  <div class="grid grid-cols-1 min-[420px]:grid-cols-2 sm:grid-cols-3 gap-2">
                    {industries.map((ind) => (
                      <label class="choice py-3.5 px-4 items-center gap-3">
                        <input type="radio" name="industry" value={ind.value} required />
                        <span class="choice-mark choice-mark-square mt-0" aria-hidden="true"><Check size={12} stroke-width={3} /></span>
                        <span class="text-[0.9375rem] text-ink-900">{ind.label}</span>
                      </label>
                    ))}
                  </div>
                  <p id="industry-error" class="error hidden" data-error-for="industry">
                    {pick(lang, { en: 'Please choose the closest industry.', fr: 'Veuillez choisir le secteur qui correspond le mieux.', de: 'Bitte wählen Sie die passendste Branche.', it: 'Scegli il settore più adatto.' })}
                  </p>
                </fieldset>

                <div class="mt-8">
                  <label for="goals" class="field-label">
                    {pick(lang, { en: 'What do you want to achieve?', fr: 'Quels sont vos objectifs\u202F?', de: 'Was möchten Sie erreichen?', it: 'Cosa vuoi ottenere?' })}
                    <span class="ml-2 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-steel-500">{T.optional}</span>
                  </label>
                  <textarea
                    id="goals"
                    name="goals"
                    rows="4"
                    class="field resize-y"
                    maxlength={START_LIMITS.goals}
                    aria-describedby="goals-hint"
                  ></textarea>
                  <p id="goals-hint" class="field-hint">
                    {pick(lang, { en: 'Goals, target customers or specific features you need. A sentence or two is enough.', fr: 'Objectifs, clientèle visée ou fonctionnalités souhaitées. Une ou deux phrases suffisent.', de: 'Ziele, Zielgruppe oder gewünschte Funktionen. Ein, zwei Sätze genügen.', it: 'Obiettivi, clienti a cui ti rivolgi o funzioni che ti servono. Bastano una o due frasi.' })}
                  </p>
                </div>
              </fieldset>

              <!-- Step 3 -->
              <fieldset class="step" data-step="2">
                <legend class="step-legend">
                  <span class="eyebrow block mb-3">{T.stepOf.replace('{n}', '3').replace('{t}', '3')}</span>
                  <span class="block text-heading-lg text-ink-900">{pick(lang, { en: 'How can we reach you?', fr: 'Comment vous joindre\u202F?', de: 'Wie erreichen wir Sie?', it: 'Come possiamo contattarti?' })}</span>
                </legend>

                <div class="mt-8">
                  <label for="name" class="field-label">{T.name}</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    class="field"
                    maxlength={START_LIMITS.name}
                    aria-describedby="name-error"
                  />
                  <p id="name-error" class="error hidden" data-error-for="name">{T.nameError}</p>
                </div>

                <div class="mt-8">
                  <label for="email" class="field-label">{pick(lang, { en: 'Email address', fr: 'Adresse e-mail', de: 'E-Mail-Adresse', it: 'Indirizzo e-mail' })}</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    inputmode="email"
                    class="field"
                    maxlength={START_LIMITS.email}
                    placeholder={pick(lang, { en: 'name@business.ch', fr: 'nom@entreprise.ch', de: 'name@firma.ch', it: 'nome@azienda.ch' })}
                    aria-describedby="email-error"
                  />
                  <p id="email-error" class="error hidden" data-error-for="email">
                    {pick(lang, { en: 'Please enter a valid email address.', fr: 'Veuillez saisir une adresse e-mail valide.', de: 'Bitte geben Sie eine gültige E-Mail-Adresse ein.', it: 'Inserisci un indirizzo e-mail valido.' })}
                  </p>
                </div>

                <div class="mt-8">
                  <label for="phone" class="field-label">
                    {pick(lang, { en: 'Phone number', fr: 'Numéro de téléphone', de: 'Telefonnummer', it: 'Numero di telefono' })}
                    <span class="ml-2 font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-steel-500">{T.optional}</span>
                  </label>
                  <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" class="field" placeholder="+41 XX XXX XX XX"
                    maxlength={START_LIMITS.phone} aria-describedby="phone-error" />
                  <p id="phone-error" class="error hidden" data-error-for="phone">{T.phoneError}</p>
                </div>

                <!-- Honeypot: hidden from people and assistive tech -->
                <div class="hp" aria-hidden="true">
                  <label for="company_url">{T.honeypot}</label>
                  <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <div class="mt-8">
                  <div data-turnstile></div>
                  <p class="error hidden" data-error-for="turnstile">{T.turnstile}</p>
                </div>

                <noscript>
                  <p class="mt-6 text-sm text-ink-900">{T.noscript}</p>
                </noscript>

                <!-- Terms acceptance: last item before the Submit row. Never pre-checked; validated server-side too. -->
                <div class="mt-8">
                  <div class="flex items-start gap-3">
                    <input type="checkbox" id="terms-accepted" name="terms-accepted" required
                      class="mt-0.5 h-5 w-5 flex-none accent-ink-900" aria-describedby="terms-accepted-error" />
                    <label for="terms-accepted" class="text-[0.9375rem] text-ink-900">{T.termsBefore}<a href={getLocalizedPath('/terms/', lang)} target="_blank" rel="noopener" aria-describedby="new-tab-hint" class="underline underline-offset-4 decoration-1 hover:text-signal-700">{T.termsLink}</a>{T.termsMiddle}<a href={getLocalizedPath('/privacy/', lang)} target="_blank" rel="noopener" aria-describedby="new-tab-hint" class="underline underline-offset-4 decoration-1 hover:text-signal-700">{T.privacyLink}</a>{T.termsAfter}</label>
                  </div>
                  <span id="new-tab-hint" hidden>{T.newTab}</span>
                  <p id="terms-accepted-error" class="error hidden" data-error-for="terms-accepted" role="alert">{T.termsError}</p>
                </div>
              </fieldset>

              <!-- Navigation -->
              <div class="mt-10 pt-6 border-t border-ink-900/10 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-4">
                <button type="button" class="btn btn-secondary hidden" data-back>
                  <ArrowLeft size={16} stroke-width={1.75} />{T.back}
                </button>
                <span class="hidden sm:block" data-spacer></span>
                <button type="button" class="btn btn-primary btn-lg" data-next>
                  {T.continue}<ArrowRight size={18} class="arrow" stroke-width={1.75} />
                </button>
                <button type="submit" class="btn btn-primary btn-lg" data-submit>
                  <span data-submit-label>{T.submit}</span><ArrowRight size={18} class="arrow" stroke-width={1.75} />
                </button>
              </div>
            </form>

            <!-- Confirmation -->
            <div class="hidden p-6 sm:p-10" data-success tabindex="-1" role="status">
              <span class="flex h-12 w-12 items-center justify-center bg-ink-900 text-white rounded-[4px]" aria-hidden="true">
                <Check size={22} stroke-width={2} />
              </span>
              <h2 class="mt-8 text-heading-xl">{T.successTitle}</h2>
              <div class="mt-4" data-reference>
                <p class="lead">{T.successReference}</p>
                <p class="mt-1 font-mono text-ink-900" data-application-id></p>
              </div>
              <p class="lead mt-4 hidden" data-confirmation-sent>{T.successConfirmation}</p>
              <p class="lead mt-4">{T.successReview}</p>
              <ol class="mt-8 border-t border-ink-900/10">
                {next.map((n, i) => (
                  <li class="flex gap-4 border-b border-ink-900/10 py-4 text-ink-900">
                    <span class="index-num w-6 flex-none">{String(i + 1).padStart(2, '0')}</span>{n}
                  </li>
                ))}
              </ol>
              <a href={getLocalizedPath('/', lang)} class="link-arrow mt-8">
                {pick(lang, { en: 'Back to the homepage', fr: 'Retour à l’accueil', de: 'Zurück zur Startseite', it: 'Torna alla pagina iniziale' })}
                <ArrowRight size={16} stroke-width={1.75} />
              </a>
            </div>
          </div>

          <!-- What happens next (mobile) -->
          <div class="lg:hidden mt-10 border-t border-ink-900/10 pt-6">
            <h2 class="eyebrow mb-4">{pick(lang, { en: 'What happens next?', fr: 'Et ensuite\u202F?', de: 'Wie geht es weiter?', it: 'E poi?' })}</h2>
            <ul class="space-y-3">
              {next.map((n) => (
                <li class="flex gap-3 text-sm text-steel-700">
                  <Check size={16} class="mt-0.5 flex-none text-signal-600" stroke-width={2} />{n}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  :global(form:not(.js-steps)) .step + .step {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(17, 20, 24, 0.1);
  }
  /* With JS, show one step at a time */
  :global(.js-steps) .step {
    display: none;
  }
  :global(.js-steps) .step[data-active] {
    display: block;
  }
  :global(.motion-ok .js-steps) .step[data-active] {
    animation: step-in 0.4s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  @keyframes step-in {
    from { opacity: 0; transform: translateX(12px); }
    to { opacity: 1; transform: none; }
  }

  .step-legend {
    padding: 0;
  }

  .error {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: theme('colors.signal.700');
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .error::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    background: currentColor;
    transform: translateY(-1px);
  }
  .error.hidden {
    display: none;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  [data-turnstile]:empty {
    min-height: 65px;
  }

  /* Progress — a compact signal line */
  .progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    padding: 0;
  }
  .progress-step {
    position: relative;
    padding-top: 1.25rem;
    padding-right: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .progress-step::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: rgba(17, 20, 24, 0.18);
  }
  .progress-step::after {
    content: '';
    position: absolute;
    left: 0;
    top: 3.5px;
    height: 2px;
    width: 100%;
    background: theme('colors.signal.600');
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .progress-node {
    position: absolute;
    left: 0;
    top: 0;
    width: 9px;
    height: 9px;
    background: theme('colors.paper.DEFAULT');
    border: 1px solid rgba(17, 20, 24, 0.35);
    z-index: 1;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
  .progress-label {
    font-size: 0.875rem;
    color: theme('colors.steel.600');
    transition: color 0.3s ease;
  }
  .progress-step[data-state='current'] .progress-node,
  .progress-step[data-state='done'] .progress-node {
    background: theme('colors.signal.600');
    border-color: theme('colors.signal.600');
  }
  .progress-step[data-state='current'] .progress-label {
    color: theme('colors.ink.900');
    font-weight: 500;
  }
  .progress-step[data-state='done']::after {
    transform: scaleX(1);
  }
</style>

<script>
  import { APPLICATION_ID_RE } from '@lib/start';

  const form = document.getElementById('onboarding-form') as HTMLFormElement | null;
  const stepsEls = Array.from(document.querySelectorAll<HTMLElement>('.step'));
  const indicators = Array.from(document.querySelectorAll<HTMLElement>('[data-step-indicator]'));
  const backBtn = document.querySelector<HTMLButtonElement>('[data-back]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit]');
  const spacer = document.querySelector<HTMLElement>('[data-spacer]');
  const announcer = document.querySelector<HTMLElement>('[data-step-announcer]');
  const success = document.querySelector<HTMLElement>('[data-success]');
  const urlWrap = document.getElementById('current-website-field');
  const urlInput = document.getElementById('current-website') as HTMLInputElement | null;
  const errorBox = document.querySelector<HTMLElement>('[data-form-error]');
  const errorDetail = document.querySelector<HTMLElement>('[data-form-error-detail]');
  const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
  const tsContainer = document.querySelector<HTMLElement>('[data-turnstile]');
  const termsBox = document.getElementById('terms-accepted') as HTMLInputElement | null;

  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id: string) => void;
    getResponse: (id: string) => string | undefined;
    isExpired: (id: string) => boolean;
  };
  const w = window as unknown as { turnstile?: Turnstile; onArklensStartTurnstile?: () => void };

  const startedAt = Date.now();
  let widgetId: string | null = null;
  let submitting = false;
  // Turnstile tokens are single-use: remember every token already sent so it is never reused.
  const usedTokens = new Set<string>();

  const EMAIL_RE = /^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.[A-Za-z]{2,}$/;
  const PHONE_RE = /^[0-9+()./\s-]{5,40}$/;

  // Server payload keys → form field names and their step (for 422 responses).
  const SERVER_FIELDS: Record<string, [string, number]> = {
    path: ['path', 0],
    currentWebsite: ['current-website', 0],
    businessName: ['business-name', 1],
    industry: ['industry', 1],
    goals: ['goals', 1],
    name: ['name', 2],
    email: ['email', 2],
    phone: ['phone', 2],
    termsAccepted: ['terms-accepted', 2],
  };

  let current = 0;

  /** Native validity plus the same email/phone rules the server applies. */
  function fieldOk(el: HTMLInputElement | HTMLTextAreaElement): boolean {
    if (!el.checkValidity()) return false;
    const v = el.value.trim();
    if (el.name === 'email') return EMAIL_RE.test(v);
    if (el.name === 'phone') return !v || PHONE_RE.test(v);
    if (el.name === 'business-name') return v.length > 0;
    if (el.name === 'name') return v.length >= 2;
    return true;
  }

  function setError(name: string, show: boolean) {
    const msg = document.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    msg?.classList.toggle('hidden', !show);
    form?.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((el) => {
      if (el.type === 'radio') return;
      if (show) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    });
  }

  function validateStep(index: number): boolean {
    const step = stepsEls[index];
    if (!step) return true;
    let firstInvalid: HTMLElement | null = null;
    const checkedGroups = new Set<string>();

    step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((el) => {
      if (el.closest('.hidden')) return;
      const name = el.name;
      if (el instanceof HTMLInputElement && el.type === 'radio') {
        if (checkedGroups.has(name)) return;
        checkedGroups.add(name);
        const ok = !el.required || !!step.querySelector(`input[name="${name}"]:checked`);
        setError(name, !ok);
        if (!ok && !firstInvalid) firstInvalid = el;
        return;
      }
      const ok = fieldOk(el);
      setError(name, !ok);
      if (!ok && !firstInvalid) firstInvalid = el;
    });

    (firstInvalid as HTMLElement | null)?.focus();
    return !firstInvalid;
  }

  function render(focus = true) {
    stepsEls.forEach((s, i) => s.toggleAttribute('data-active', i === current));
    indicators.forEach((ind, i) => {
      ind.dataset.state = i < current ? 'done' : i === current ? 'current' : 'todo';
      if (i === current) ind.setAttribute('aria-current', 'step');
      else ind.removeAttribute('aria-current');
    });
    const last = current === stepsEls.length - 1;
    backBtn?.classList.toggle('hidden', current === 0);
    spacer?.classList.toggle('sm:block', current === 0);
    nextBtn?.classList.toggle('hidden', last);
    submitBtn?.classList.toggle('hidden', !last);
    // Render Turnstile only once its step is visible, so the size check sees the real width.
    if (last) renderTurnstile();

    const legendParts = Array.from(stepsEls[current]?.querySelectorAll('legend > span') ?? []).map((s) => s.textContent?.trim());
    if (announcer) announcer.textContent = legendParts.filter(Boolean).join('. ');

    if (focus) {
      const target = stepsEls[current]?.querySelector<HTMLElement>('input:not([type="hidden"]), textarea');
      target?.focus({ preventScroll: true });
      form?.closest('.bg-white')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }
  }

  function showFormError(detail = form?.dataset.msgRetry ?? '') {
    if (!errorBox) return;
    if (errorDetail) errorDetail.textContent = detail;
    errorBox.classList.remove('hidden');
    errorBox.focus();
  }

  function setBusy(busy: boolean) {
    submitting = busy;
    if (submitBtn) {
      submitBtn.disabled = busy;
      submitBtn.setAttribute('aria-busy', String(busy));
    }
    if (submitLabel) submitLabel.textContent = (busy ? form?.dataset.msgSending : form?.dataset.msgSubmit) ?? '';
  }

  function resetTurnstile() {
    if (widgetId && w.turnstile) w.turnstile.reset(widgetId);
  }

  /** A current token: present, not expired, never submitted before. Otherwise ''. */
  function freshToken(): string {
    if (!widgetId || !w.turnstile) return '';
    const token = w.turnstile.getResponse(widgetId) ?? '';
    if (!token) return '';
    if (usedTokens.has(token) || w.turnstile.isExpired(widgetId)) {
      resetTurnstile(); // fetch a new one; the applicant submits again once it's ready
      return '';
    }
    return token;
  }

  // --- Turnstile (explicit render so the widget can be reset after each attempt) ---
  function renderTurnstile() {
    if (!form || !tsContainer || !w.turnstile || widgetId) return;
    if (!stepsEls[stepsEls.length - 1]?.hasAttribute('data-active')) return;
    widgetId = w.turnstile.render(tsContainer, {
      sitekey: form.dataset.sitekey,
      action: form.dataset.action,
      language: form.dataset.lang,
      theme: 'light',
      // 'flexible' has a 300 px minimum width; narrower containers (320 px phones) get 'compact'.
      size: tsContainer.clientWidth < 300 ? 'compact' : 'flexible',
      'response-field': false,
      // Tokens expire after 5 minutes: let the widget fetch a new one by itself.
      'refresh-expired': 'auto',
      'refresh-timeout': 'auto',
      callback: () => setError('turnstile', false),
    });
  }
  w.onArklensStartTurnstile = renderTurnstile;
  const tsScript = document.createElement('script');
  tsScript.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onArklensStartTurnstile';
  tsScript.async = true;
  tsScript.defer = true;
  document.head.appendChild(tsScript);

  function value(name: string): string {
    const el = form?.elements.namedItem(name) as HTMLInputElement | null;
    return (el?.value ?? '').trim();
  }

  function handlePathChange(path: string) {
    const needsUrl = path === 'update' || path === 'extend';
    urlWrap?.classList.toggle('hidden', !needsUrl);
    if (urlInput) {
      urlInput.required = needsUrl;
      if (!needsUrl) {
        urlInput.value = '';
        setError('current-website', false);
      }
    }
    setError('path', false);
  }

  if (form) {
    form.classList.add('js-steps');

    form.querySelectorAll<HTMLInputElement>('input[name="path"]').forEach((radio) => {
      radio.addEventListener('change', () => handlePathChange(radio.value));
    });
    form.querySelectorAll<HTMLInputElement>('input[name="industry"]').forEach((radio) => {
      radio.addEventListener('change', () => setError('industry', false));
    });
    form.querySelectorAll<HTMLInputElement>('input:not([type="radio"])').forEach((input) => {
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true' && fieldOk(input)) setError(input.name, false);
      });
    });

    // Preselect from ?path= (homepage CTAs)
    const pathParam = new URLSearchParams(window.location.search).get('path');
    if (pathParam) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="path"][value="${CSS.escape(pathParam)}"]`);
      if (radio) {
        radio.checked = true;
        handlePathChange(pathParam);
      }
    }

    nextBtn?.addEventListener('click', () => {
      if (!validateStep(current)) return;
      current = Math.min(current + 1, stepsEls.length - 1);
      render();
    });

    backBtn?.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      render();
    });

    // Enter in a text field advances instead of submitting early
    form.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (e.key === 'Enter' && target.tagName === 'INPUT' && current < stepsEls.length - 1) {
        e.preventDefault();
        nextBtn?.click();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      errorBox?.classList.add('hidden');
      for (let i = 0; i < stepsEls.length; i++) {
        if (!validateStep(i)) {
          current = i;
          render(false);
          validateStep(i);
          return;
        }
      }

      const token = freshToken();
      if (!token) {
        setError('turnstile', true);
        tsContainer?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      usedTokens.add(token);
      setBusy(true);

      const path = form.querySelector<HTMLInputElement>('input[name="path"]:checked')?.value ?? '';
      const industry = form.querySelector<HTMLInputElement>('input[name="industry"]:checked')?.value ?? '';

      try {
        // Only the acceptance flag is sent; the server sets the timestamp, versions and application ID.
        const res = await fetch('/api/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            path,
            currentWebsite: value('current-website'),
            businessName: value('business-name'),
            industry,
            goals: (form.elements.namedItem('goals') as HTMLTextAreaElement | null)?.value ?? '',
            name: value('name'),
            email: value('email'),
            phone: value('phone'),
            termsAccepted: termsBox?.checked === true,
            company_url: value('company_url'),
            started_at: startedAt,
            page: location.pathname.slice(0, 200),
            turnstile_token: token,
            lang: form.dataset.lang ?? 'en',
          }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          ok?: boolean; error?: string; fields?: string[]; applicationId?: string; confirmationSent?: boolean;
        };

        const applicationId = typeof data.applicationId === 'string' ? data.applicationId : '';
        // A genuine success always carries a server-generated ID; anything else (incl. the bot-trap decoy) is a failure.
        if (res.ok && data.ok === true && APPLICATION_ID_RE.test(applicationId)) {
          const idEl = document.querySelector<HTMLElement>('[data-application-id]');
          if (idEl) idEl.textContent = applicationId;
          document.querySelector('[data-confirmation-sent]')?.classList.toggle('hidden', data.confirmationSent !== true);
          form.classList.add('hidden');
          indicators.forEach((ind) => (ind.dataset.state = 'done'));
          success?.classList.remove('hidden');
          success?.focus();
          return;
        }

        if (data.error === 'invalid' && Array.isArray(data.fields)) {
          const mapped = data.fields.map((f) => SERVER_FIELDS[f]).filter((m): m is [string, number] => !!m);
          if (mapped.length) {
            current = Math.min(...mapped.map(([, s]) => s));
            render(false);
            mapped.forEach(([name]) => setError(name, true));
          }
          showFormError(form.dataset.msgInvalid ?? '');
        } else if (data.error === 'rate_limited') {
          showFormError(form.dataset.msgRateLimited ?? '');
        } else if (data.error === 'verification_expired') {
          // Token timed out or was already used: a fresh one is fetched in `finally`.
          showFormError(form.dataset.msgVerification ?? '');
        } else {
          // verification_failed and server errors: generic "Please try again."
          showFormError();
        }
      } catch {
        showFormError(form.dataset.msgNetwork ?? '');
      } finally {
        setBusy(false);
        resetTurnstile();
      }
    });

    render(false);
  }
</script>
