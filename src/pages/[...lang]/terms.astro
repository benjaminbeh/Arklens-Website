---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { pick } from '@lib/pick';

import { localeStaticPaths, getLocalizedPath, dateLocales, type Language } from '@i18n/index';
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props as { lang: Language };

const termsName = pick(lang, { en: 'Terms of Use', fr: 'Conditions d’utilisation', de: 'Nutzungsbedingungen', it: 'Condizioni d’uso' });
const contactPath = getLocalizedPath('/contact', lang);
const contactUrl = `www.arklens.ch${contactPath}`;
---

<BaseLayout 
  title={termsName} 
  description={pick(lang, {
    en: 'Arklens Terms of Use - Terms and conditions for using our services.',
    fr: 'Conditions d’utilisation d’Arklens\u00A0: les conditions qui s’appliquent à l’utilisation de nos services.',
    de: 'Nutzungsbedingungen von Arklens: die Bedingungen, die für die Nutzung unserer Dienstleistungen gelten.',
    it: 'Condizioni d’uso di Arklens: le condizioni che si applicano all’utilizzo dei nostri servizi.',
  })} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {pick(lang, { en: 'Terms of Use', fr: 'Conditions d’utilisation', de: 'Nutzungs\u00ADbedingungen', it: 'Condizioni d’uso' })}
      </h1>
      
      <div class="prose prose-lg max-w-none">
        <p class="text-body-lg text-neutral-600 mb-8">
          {pick(lang, { en: 'Last updated: ', fr: 'Dernière mise à jour\u00A0: ', de: 'Zuletzt aktualisiert: ', it: 'Ultimo aggiornamento: ' })}{new Date().toLocaleDateString(dateLocales[lang])}
        </p>

        <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-6 mb-12">
          <p class="text-sm text-amber-900 font-semibold mb-2">
            ⚠️ {pick(lang, { en: 'Legal Review Required', fr: 'Vérification juridique requise', de: 'Juristische Prüfung erforderlich', it: 'Verifica legale necessaria' })}
          </p>
          <p class="text-sm text-amber-800">
            {pick(lang, {
              en: 'These Terms of Use are provided as a template and must be reviewed by a qualified Swiss legal advisor before being used in production. They should be adapted to reflect your actual business practices and comply with all applicable Swiss and European laws.',
              fr: 'Les présentes Conditions d’utilisation sont fournies à titre de modèle et doivent être vérifiées par un conseil juridique suisse qualifié avant leur mise en production. Elles devraient être adaptées afin de refléter vos pratiques commerciales réelles et de respecter toutes les lois suisses et européennes applicables.',
              de: 'Diese Nutzungsbedingungen dienen als Vorlage und müssen vor dem produktiven Einsatz von einer qualifizierten juristischen Fachperson aus der Schweiz geprüft werden. Sie sollten an Ihre tatsächliche Geschäftspraxis angepasst werden und alle anwendbaren schweizerischen und europäischen Gesetze einhalten.',
              it: 'Le presenti Condizioni d’uso sono fornite come modello e devono essere verificate da un consulente legale svizzero qualificato prima dell’uso in produzione. Dovrebbero essere adattate alle pratiche commerciali effettive e rispettare tutte le leggi svizzere ed europee applicabili.',
            })}
          </p>
        </div>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: '1. Acceptance of Terms', fr: '1. Acceptation des conditions', de: '1. Annahme der Bedingungen', it: '1. Accettazione delle condizioni' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'By accessing or using Arklens services, you agree to be bound by these Terms of Use. If you do not agree to these terms, please do not use our services.',
              fr: 'En accédant aux services d’Arklens ou en les utilisant, vous acceptez d’être lié par les présentes Conditions d’utilisation. Si vous n’acceptez pas ces conditions, veuillez ne pas utiliser nos services.',
              de: 'Mit dem Zugriff auf die Dienstleistungen von Arklens oder deren Nutzung erklären Sie sich einverstanden, an diese Nutzungsbedingungen gebunden zu sein. Wenn Sie mit diesen Bedingungen nicht einverstanden sind, nutzen Sie unsere Dienstleistungen bitte nicht.',
              it: 'Accedendo ai servizi di Arklens o utilizzandoli, l’utente accetta di essere vincolato dalle presenti Condizioni d’uso. In caso di mancata accettazione di queste condizioni, si prega di non utilizzare i nostri servizi.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: '2. Free Website Programme', fr: '2. Programme Site web gratuit', de: '2. Programm «Kostenlose Website»', it: '2. Programma Sito web gratuito' })}
          </h2>
          
          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.1 Programme Description', fr: '2.1 Description du programme', de: '2.1 Beschreibung des Programms', it: '2.1 Descrizione del programma' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'Arklens offers a Free Website Programme as a promotional service. This programme includes the creation of a basic professional website and free hosting. The programme is designed to help Swiss small businesses establish an online presence.',
              fr: 'Arklens propose le Programme Site web gratuit à titre de service promotionnel. Ce programme comprend la création d’un site web professionnel de base et un hébergement gratuit. Il est conçu pour aider les petites entreprises suisses à établir une présence en ligne.',
              de: 'Arklens bietet das Programm «Kostenlose Website» als Dienstleistung zu Promotionszwecken an. Das Programm umfasst die Erstellung einer professionellen Basis-Website und kostenloses Hosting. Es soll kleinen Schweizer Unternehmen helfen, eine Online-Präsenz aufzubauen.',
              it: 'Arklens offre il Programma Sito web gratuito come servizio promozionale. Il programma comprende la realizzazione di un sito web professionale di base e l’hosting gratuito. È pensato per aiutare le piccole aziende svizzere a creare una presenza online.',
            })}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.2 Programme Status and Changes', fr: '2.2 Statut et modifications du programme', de: '2.2 Status und Änderungen des Programms', it: '2.2 Stato e modifiche del programma' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'The Free Website Programme is a promotional offering and is not guaranteed to continue indefinitely. Arklens reserves the right to modify, suspend, or discontinue the programme at any time. We may make changes to:',
              fr: 'Le Programme Site web gratuit est une offre promotionnelle dont la poursuite pour une durée indéterminée n’est pas garantie. Arklens se réserve le droit de modifier, de suspendre ou d’interrompre le programme à tout moment. Nous pouvons modifier\u00A0:',
              de: 'Das Programm «Kostenlose Website» ist ein Promotionsangebot, dessen unbefristete Weiterführung nicht garantiert ist. Arklens behält sich das Recht vor, das Programm jederzeit zu ändern, auszusetzen oder einzustellen. Wir können Folgendes ändern:',
              it: 'Il Programma Sito web gratuito è un’offerta promozionale e la sua prosecuzione a tempo indeterminato non è garantita. Arklens si riserva il diritto di modificare, sospendere o interrompere il programma in qualsiasi momento. Possiamo apportare modifiche a:',
            })}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{pick(lang, { en: 'The scope of services included in the free programme', fr: 'L’étendue des services inclus dans le programme gratuit', de: 'Den Umfang der im kostenlosen Programm enthaltenen Leistungen', it: 'L’ambito dei servizi inclusi nel programma gratuito' })}</li>
            <li>{pick(lang, { en: 'Eligibility criteria for new participants', fr: 'Les critères d’éligibilité pour les nouveaux participants', de: 'Die Teilnahmekriterien für neue Teilnehmende', it: 'I criteri di ammissibilità per i nuovi partecipanti' })}</li>
            <li>{pick(lang, { en: 'Technical specifications or hosting arrangements', fr: 'Les spécifications techniques ou les modalités d’hébergement', de: 'Technische Spezifikationen oder Hosting-Vereinbarungen', it: 'Le specifiche tecniche o le modalità di hosting' })}</li>
            <li>{pick(lang, { en: 'The programme’s continuation or termination', fr: 'La poursuite ou la fin du programme', de: 'Die Weiterführung oder Beendigung des Programms', it: 'La prosecuzione o la cessazione del programma' })}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.3 Notice Period for Programme Changes', fr: '2.3 Préavis en cas de modification du programme', de: '2.3 Ankündigungsfrist bei Programmänderungen', it: '2.3 Preavviso per le modifiche del programma' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: "If Arklens decides to end the Free Website Programme or discontinue free hosting for existing customers, we will aim to provide at least 60 days' advance notice via email to the address you provided.",
              fr: 'Si Arklens décide de mettre fin au Programme Site web gratuit ou de cesser l’hébergement gratuit pour les clients existants, nous nous efforcerons de vous en informer au moins 60 jours à l’avance par e-mail, à l’adresse que vous nous avez communiquée.',
              de: 'Wenn Arklens beschliesst, das Programm «Kostenlose Website» zu beenden oder das kostenlose Hosting für bestehende Kundinnen und Kunden einzustellen, bemühen wir uns, Sie mindestens 60 Tage im Voraus per E-Mail an die von Ihnen angegebene Adresse zu informieren.',
              it: 'Se Arklens decide di porre fine al Programma Sito web gratuito o di interrompere l’hosting gratuito per i clienti esistenti, ci impegneremo a inviare un preavviso di almeno 60 giorni via e-mail all’indirizzo indicato dall’utente.',
            })}
          </p>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'This notice period may be shorter or immediate in cases of:',
              fr: 'Ce délai de préavis peut être plus court, voire immédiat, en cas de\u00A0:',
              de: 'In folgenden Fällen kann die Ankündigung kurzfristiger oder mit sofortiger Wirkung erfolgen:',
              it: 'Questo preavviso può essere più breve o immediato nei seguenti casi:',
            })}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{pick(lang, { en: 'Security threats or vulnerabilities', fr: 'Menaces ou failles de sécurité', de: 'Sicherheitsbedrohungen oder Sicherheitslücken', it: 'Minacce o vulnerabilità di sicurezza' })}</li>
            <li>{pick(lang, { en: 'Misuse or abuse of the service', fr: 'Mauvaise utilisation ou utilisation abusive du service', de: 'Fehlgebrauch oder Missbrauch des Dienstes', it: 'Uso improprio o abuso del servizio' })}</li>
            <li>{pick(lang, { en: 'Legal or regulatory requirements', fr: 'Exigences légales ou réglementaires', de: 'Gesetzliche oder behördliche Vorgaben', it: 'Requisiti legali o normativi' })}</li>
            <li>{pick(lang, { en: 'Urgent technical issues affecting service stability', fr: 'Problèmes techniques urgents affectant la stabilité du service', de: 'Dringende technische Probleme, welche die Stabilität des Dienstes beeinträchtigen', it: 'Problemi tecnici urgenti che compromettono la stabilità del servizio' })}</li>
            <li>{pick(lang, { en: 'Violation of these Terms of Use', fr: 'Violation des présentes Conditions d’utilisation', de: 'Verstösse gegen diese Nutzungsbedingungen', it: 'Violazione delle presenti Condizioni d’uso' })}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.4 No Retrospective Charges', fr: '2.4 Aucune facturation rétroactive', de: '2.4 Keine rückwirkenden Kosten', it: '2.4 Nessun addebito retroattivo' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'Arklens will never charge you retrospectively for services that were previously provided to you free of charge under the Free Website Programme. If the programme ends or changes, any charges will only apply from the date you agree to new paid terms going forward.',
              fr: 'Arklens ne vous facturera jamais rétroactivement des services qui vous ont été fournis gratuitement dans le cadre du Programme Site web gratuit. Si le programme prend fin ou change, d’éventuels frais ne s’appliqueront qu’à partir de la date à laquelle vous acceptez de nouvelles conditions payantes pour l’avenir.',
              de: 'Arklens wird Ihnen Leistungen, die Sie im Rahmen des Programms «Kostenlose Website» kostenlos erhalten haben, nie rückwirkend in Rechnung stellen. Endet oder ändert sich das Programm, fallen allfällige Kosten erst ab dem Datum an, an dem Sie neuen kostenpflichtigen Bedingungen für die Zukunft zustimmen.',
              it: 'Arklens non addebiterà mai retroattivamente all’utente servizi che gli sono stati forniti gratuitamente nell’ambito del Programma Sito web gratuito. Se il programma termina o cambia, eventuali costi si applicheranno solo a partire dalla data in cui l’utente accetta nuove condizioni a pagamento per il futuro.',
            })}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.5 Your Options if the Programme Ends', fr: '2.5 Vos options si le programme prend fin', de: '2.5 Ihre Möglichkeiten, wenn das Programm endet', it: '2.5 Opzioni in caso di cessazione del programma' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'If Arklens discontinues the Free Website Programme or your participation in it, you have several options:',
              fr: 'Si Arklens met fin au Programme Site web gratuit ou à votre participation à celui-ci, plusieurs options s’offrent à vous\u00A0:',
              de: 'Stellt Arklens das Programm «Kostenlose Website» ein oder beendet sie Ihre Teilnahme daran, haben Sie mehrere Möglichkeiten:',
              it: 'Se Arklens interrompe il Programma Sito web gratuito o la partecipazione dell’utente al programma, sono disponibili diverse opzioni:',
            })}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>
              <strong>{pick(lang, { en: 'Continue with Arklens under paid terms:', fr: 'Continuer avec Arklens selon des conditions payantes\u00A0:', de: 'Mit Arklens zu kostenpflichtigen Bedingungen weitermachen:', it: 'Continuare con Arklens a condizioni a pagamento:' })}</strong>
              {pick(lang, {
                en: ' If we offer a paid service option, you may choose to continue using Arklens services under the new paid terms. This requires your explicit agreement to the new pricing and terms before any charges begin.',
                fr: ' Si nous proposons une option payante, vous pouvez choisir de continuer à utiliser les services d’Arklens selon les nouvelles conditions payantes. Cela suppose votre accord explicite sur les nouveaux tarifs et les nouvelles conditions avant tout début de facturation.',
                de: ' Wenn wir eine kostenpflichtige Option anbieten, können Sie die Dienstleistungen von Arklens zu den neuen kostenpflichtigen Bedingungen weiter nutzen. Dafür ist Ihre ausdrückliche Zustimmung zu den neuen Preisen und Bedingungen erforderlich, bevor Kosten anfallen.',
                it: ' Se offriamo un’opzione a pagamento, l’utente può scegliere di continuare a usare i servizi di Arklens alle nuove condizioni a pagamento. Ciò richiede il suo consenso esplicito ai nuovi prezzi e alle nuove condizioni prima che venga addebitato qualsiasi costo.',
              })}
            </li>
            <li>
              <strong>{pick(lang, { en: 'Assume hosting and infrastructure costs:', fr: 'Prendre en charge les coûts d’hébergement et d’infrastructure\u00A0:', de: 'Hosting- und Infrastrukturkosten übernehmen:', it: 'Farsi carico dei costi di hosting e infrastruttura:' })}</strong>
              {pick(lang, {
                en: ' You may choose to take over the hosting and technical infrastructure costs directly, either with Arklens or another provider of your choice. Operating the existing Arklens-built website outside Arklens requires a separate agreement under Section 5.5.',
                fr: ' Vous pouvez choisir de prendre directement en charge les coûts d’hébergement et d’infrastructure technique, que ce soit chez Arklens ou chez un autre fournisseur de votre choix. L’exploitation en dehors d’Arklens du site existant réalisé par Arklens nécessite un accord séparé selon la section 5.5.',
                de: ' Sie können die Kosten für Hosting und technische Infrastruktur direkt übernehmen, entweder bei Arklens oder bei einem anderen Anbieter Ihrer Wahl. Für den Betrieb der bestehenden, von Arklens erstellten Website ausserhalb von Arklens ist eine separate Vereinbarung gemäss Abschnitt 5.5 erforderlich.',
                it: ' L’utente può scegliere di farsi carico direttamente dei costi di hosting e dell’infrastruttura tecnica, presso Arklens o presso un altro fornitore di sua scelta. Per gestire al di fuori di Arklens il sito esistente realizzato da Arklens è necessario un accordo separato ai sensi della sezione 5.5.',
              })}
            </li>
            <li>
              <strong>{pick(lang, { en: 'Migrate to another provider:', fr: 'Migrer vers un autre fournisseur\u00A0:', de: 'Zu einem anderen Anbieter migrieren:', it: 'Migrare a un altro fornitore:' })}</strong>
              {pick(lang, {
                en: ' You may migrate your website to another hosting provider or web development service. Arklens will provide reasonable technical assistance during the handover period.',
                fr: ' Vous pouvez migrer votre site web vers un autre hébergeur ou prestataire de développement web. Arklens fournira une assistance technique raisonnable pendant la période de transfert.',
                de: ' Sie können Ihre Website zu einem anderen Hosting-Anbieter oder Webentwicklungsdienst migrieren. Arklens wird Sie während der Übergabephase in angemessenem Umfang technisch unterstützen.',
                it: ' L’utente può migrare il proprio sito web a un altro fornitore di hosting o servizio di sviluppo web. Arklens fornirà un’assistenza tecnica ragionevole durante il periodo di passaggio.',
              })}
            </li>
            <li>
              <strong>{pick(lang, { en: 'Discontinue the website:', fr: 'Fermer le site web\u00A0:', de: 'Website einstellen:', it: 'Chiudere il sito web:' })}</strong>
              {pick(lang, {
                en: ' You may choose to discontinue your website entirely.',
                fr: ' Vous pouvez choisir de fermer complètement votre site web.',
                de: ' Sie können sich entscheiden, Ihre Website vollständig einzustellen.',
                it: ' L’utente può scegliere di chiudere completamente il proprio sito web.',
              })}
            </li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.6 Agreement to Future Paid Services', fr: '2.6 Accord sur de futurs services payants', de: '2.6 Zustimmung zu künftigen kostenpflichtigen Leistungen', it: '2.6 Consenso a futuri servizi a pagamento' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'Any transition from the Free Website Programme to a paid service requires your explicit written agreement to the new terms and pricing before charges begin. We will clearly communicate:',
              fr: 'Tout passage du Programme Site web gratuit à un service payant nécessite votre accord écrit explicite sur les nouvelles conditions et les nouveaux tarifs avant le début de toute facturation. Nous vous indiquerons clairement\u00A0:',
              de: 'Jeder Wechsel vom Programm «Kostenlose Website» zu einer kostenpflichtigen Leistung erfordert Ihre ausdrückliche schriftliche Zustimmung zu den neuen Bedingungen und Preisen, bevor Kosten anfallen. Wir werden Ihnen klar mitteilen:',
              it: 'Qualsiasi passaggio dal Programma Sito web gratuito a un servizio a pagamento richiede il consenso scritto esplicito dell’utente alle nuove condizioni e ai nuovi prezzi prima che inizino gli addebiti. Comunicheremo chiaramente:',
            })}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{pick(lang, { en: 'The new pricing structure', fr: 'La nouvelle structure tarifaire', de: 'Die neue Preisstruktur', it: 'La nuova struttura dei prezzi' })}</li>
            <li>{pick(lang, { en: 'What services are included', fr: 'Les services inclus', de: 'Welche Leistungen enthalten sind', it: 'Quali servizi sono inclusi' })}</li>
            <li>{pick(lang, { en: 'When charges will begin', fr: 'La date de début de la facturation', de: 'Ab wann Kosten anfallen', it: 'Quando inizieranno gli addebiti' })}</li>
            <li>{pick(lang, { en: 'Payment terms and billing frequency', fr: 'Les conditions de paiement et la fréquence de facturation', de: 'Zahlungsbedingungen und Rechnungsintervall', it: 'Condizioni di pagamento e frequenza di fatturazione' })}</li>
            <li>{pick(lang, { en: 'How to decline and explore other options', fr: 'Comment refuser et étudier d’autres options', de: 'Wie Sie ablehnen und andere Möglichkeiten prüfen können', it: 'Come rifiutare e valutare altre opzioni' })}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.7 Domain Ownership', fr: '2.7 Propriété du nom de domaine', de: '2.7 Eigentum an der Domain', it: '2.7 Proprietà del dominio' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: "Your domain name always remains your property. You are responsible for purchasing and renewing your domain through a domain registrar of your choice. Arklens may assist with domain setup and configuration, but you retain full ownership and control. You may transfer your domain to another provider at any time, subject to your registrar’s policies.",
              fr: 'Votre nom de domaine reste toujours votre propriété. Vous êtes responsable de l’achat et du renouvellement de votre nom de domaine auprès du registraire de votre choix. Arklens peut vous aider à mettre en place et à configurer votre domaine, mais vous en conservez la pleine propriété et le plein contrôle. Vous pouvez transférer votre domaine chez un autre fournisseur à tout moment, sous réserve des règles de votre registraire.',
              de: 'Ihr Domainname bleibt immer Ihr Eigentum. Sie sind dafür verantwortlich, Ihre Domain bei einem Registrar Ihrer Wahl zu kaufen und zu verlängern. Arklens kann Sie bei der Einrichtung und Konfiguration der Domain unterstützen, Eigentum und Kontrolle bleiben jedoch vollständig bei Ihnen. Sie können Ihre Domain jederzeit zu einem anderen Anbieter übertragen, vorbehaltlich der Richtlinien Ihres Registrars.',
              it: 'Il nome di dominio resta sempre di proprietà dell’utente. L’utente è responsabile dell’acquisto e del rinnovo del dominio presso un registrar di sua scelta. Arklens può aiutare a impostare e configurare il dominio, ma l’utente ne mantiene la piena proprietà e il pieno controllo. L’utente può trasferire il dominio a un altro fornitore in qualsiasi momento, fatte salve le regole del proprio registrar.',
            })}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {pick(lang, { en: '2.8 Third-Party Costs', fr: '2.8 Coûts de tiers', de: '2.8 Kosten von Drittanbietern', it: '2.8 Costi di terzi' })}
          </h3>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'While the Free Website Programme includes website creation and hosting, you remain responsible for certain third-party costs unless explicitly stated otherwise in writing. These may include:',
              fr: 'Le Programme Site web gratuit comprend la création et l’hébergement du site web, mais certains coûts de tiers restent à votre charge, sauf indication contraire expresse par écrit. Il peut s’agir de\u00A0:',
              de: 'Das Programm «Kostenlose Website» umfasst zwar die Erstellung und das Hosting der Website, bestimmte Kosten von Drittanbietern tragen Sie jedoch selbst, sofern schriftlich nicht ausdrücklich etwas anderes festgehalten ist. Dazu können gehören:',
              it: 'Sebbene il Programma Sito web gratuito comprenda la realizzazione e l’hosting del sito web, alcuni costi di terzi restano a carico dell’utente, salvo diversa indicazione esplicita per iscritto. Tra questi possono rientrare:',
            })}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{pick(lang, { en: 'Domain registration and renewal fees', fr: 'Frais d’enregistrement et de renouvellement du nom de domaine', de: 'Gebühren für Registrierung und Verlängerung der Domain', it: 'Costi di registrazione e rinnovo del dominio' })}</li>
            <li>{pick(lang, { en: 'Business email services', fr: 'Services de messagerie professionnelle', de: 'Geschäftliche E-Mail-Dienste', it: 'Servizi di e-mail aziendale' })}</li>
            <li>{pick(lang, { en: 'Premium APIs or third-party integrations', fr: 'API premium ou intégrations de tiers', de: 'Premium-APIs oder Integrationen von Drittanbietern', it: 'API premium o integrazioni di terzi' })}</li>
