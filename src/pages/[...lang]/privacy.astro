---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { pick, type Copy } from '@lib/pick';
import { PRIVACY_VERSION, formatLegalVersion } from '@lib/legal';

import { localeStaticPaths, dateLocales, type Language } from '@i18n/index';
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props as { lang: Language };

/*
 * INTERNAL NOTE (not rendered): payments are not live.
 * When Payrexx or another provider is confirmed and payment collection is enabled,
 * Privacy must be updated before or at the same time to identify the payment provider
 * and relevant payment data processing.
 */

// The only public contact address. Never publish the internal form mailbox here.
const EMAIL = 'swiss_contact@arklens.ch';

const policyName = pick(lang, { en: 'Privacy Policy', fr: 'Politique de confidentialité', de: 'Datenschutzerklärung', it: 'Informativa sulla privacy' });

const h2 = 'text-heading-lg mb-4';
const h3 = 'text-heading-md mb-3 mt-6 text-neutral-900';
const ul = 'list-disc pl-6 text-neutral-700 space-y-2';
const link = 'text-primary-600 hover:text-primary-700';

const addedLabel: Copy = {
  en: 'Added when you submit the form: ',
  fr: 'Ajouté lors de l’envoi du formulaire\u00A0: ',
  de: 'Beim Absenden ergänzt: ',
  it: 'Aggiunto al momento dell’invio: ',
};

// 3.1 General contact form (functions/api/contact.ts parseFields + buildEmail)
const contactFields: Copy[] = [
  { en: 'Name', fr: 'Nom', de: 'Name', it: 'Nome' },
  { en: 'Business or organisation', fr: 'Entreprise ou organisation', de: 'Unternehmen oder Organisation', it: 'Azienda o organizzazione' },
  { en: 'Email address', fr: 'Adresse e-mail', de: 'E-Mail-Adresse', it: 'Indirizzo e-mail' },
  { en: 'Phone number (optional)', fr: 'Numéro de téléphone (facultatif)', de: 'Telefonnummer (optional)', it: 'Numero di telefono (facoltativo)' },
  { en: 'Existing website (optional)', fr: 'Site web existant (facultatif)', de: 'Bestehende Website (optional)', it: 'Sito web esistente (facoltativo)' },
  { en: 'Reason for contact', fr: 'Motif de la prise de contact', de: 'Grund der Kontaktaufnahme', it: 'Motivo del contatto' },
  { en: 'Your message', fr: 'Votre message', de: 'Ihre Nachricht', it: 'Messaggio' },
];
const contactAdded: Copy = {
  en: 'the date and time of submission, the language version of the website and the page from which the form was sent.',
  fr: 'la date et l’heure d’envoi, la version linguistique du site et la page depuis laquelle le formulaire a été envoyé.',
  de: 'Datum und Uhrzeit des Absendens, die Sprachversion der Website und die Seite, von der aus das Formular gesendet wurde.',
  it: 'data e ora dell’invio, versione linguistica del sito e pagina da cui è stato inviato il modulo.',
};

// 3.2 Website Programme application /start/ (functions/_lib/start-handler.ts parseStart)
const startFields: Copy[] = [
  {
    en: 'Your starting point (for example a new website, an update or additional features for an existing website, or starting with a Digital Business Check)',
    fr: 'Votre point de départ (par exemple un nouveau site web, une mise à jour ou des fonctionnalités supplémentaires pour un site existant, ou commencer par une évaluation numérique)',
    de: 'Ihr Ausgangspunkt (zum Beispiel eine neue Website, eine Aktualisierung oder zusätzliche Funktionen für eine bestehende Website oder ein Digital-Check als Einstieg)',
    it: 'Il punto di partenza (ad esempio un nuovo sito web, un aggiornamento o funzionalità aggiuntive per un sito esistente, oppure iniziare con un’analisi digitale)',
  },
  {
    en: 'The address of your current website, only if you want to update or extend it',
    fr: 'L’adresse de votre site web actuel, uniquement si vous souhaitez le mettre à jour ou le compléter',
    de: 'Die Adresse Ihrer aktuellen Website, nur wenn Sie diese aktualisieren oder erweitern möchten',
    it: 'L’indirizzo del sito web attuale, solo se si desidera aggiornarlo o ampliarlo',
  },
  { en: 'Business name and industry', fr: 'Nom de l’entreprise et secteur d’activité', de: 'Name des Unternehmens und Branche', it: 'Nome dell’azienda e settore' },
  { en: 'What you want to achieve (optional)', fr: 'Ce que vous souhaitez atteindre (facultatif)', de: 'Was Sie erreichen möchten (optional)', it: 'Gli obiettivi che si desidera raggiungere (facoltativo)' },
  { en: 'Your name and email address', fr: 'Votre nom et votre adresse e-mail', de: 'Ihr Name und Ihre E-Mail-Adresse', it: 'Nome e indirizzo e-mail' },
  { en: 'Phone number (optional)', fr: 'Numéro de téléphone (facultatif)', de: 'Telefonnummer (optional)', it: 'Numero di telefono (facoltativo)' },
  {
    en: 'Your agreement to the Terms of Use and acknowledgement of this Privacy Policy',
    fr: 'Votre acceptation des conditions d’utilisation et votre prise de connaissance de la présente politique de confidentialité',
    de: 'Ihre Zustimmung zu den Nutzungsbedingungen und Ihre Kenntnisnahme dieser Datenschutzerklärung',
    it: 'L’accettazione delle condizioni d’uso e la presa d’atto della presente informativa sulla privacy',
  },
];
const startAdded: Copy = {
  en: 'an application reference, the date and time of submission and acceptance, the versions of the Terms of Use and Privacy Policy you accepted, the application language and the page from which the form was sent.',
  fr: 'une référence de demande, la date et l’heure d’envoi et d’acceptation, les versions des conditions d’utilisation et de la politique de confidentialité acceptées, la langue de la demande et la page depuis laquelle le formulaire a été envoyé.',
  de: 'eine Referenznummer, Datum und Uhrzeit des Absendens und der Zustimmung, die Versionen der akzeptierten Nutzungsbedingungen und Datenschutzerklärung, die Sprache der Anfrage und die Seite, von der aus das Formular gesendet wurde.',
  it: 'un riferimento della richiesta, data e ora dell’invio e dell’accettazione, le versioni delle condizioni d’uso e dell’informativa sulla privacy accettate, la lingua della richiesta e la pagina da cui è stato inviato il modulo.',
};

// 3.3 Experience Programme application (functions/_lib/experience-handler.ts parseExperience)
const experienceFields: Copy[] = [
  { en: 'Your name and email address', fr: 'Votre nom et votre adresse e-mail', de: 'Ihr Name und Ihre E-Mail-Adresse', it: 'Nome e indirizzo e-mail' },
  { en: 'Canton or region (optional)', fr: 'Canton ou région (facultatif)', de: 'Kanton oder Region (optional)', it: 'Cantone o regione (facoltativo)' },
  { en: 'Languages and your level in each', fr: 'Langues et votre niveau dans chacune d’elles', de: 'Sprachen und Ihr Niveau in jeder Sprache', it: 'Lingue e livello in ciascuna di esse' },
  { en: 'Current situation (optional)', fr: 'Situation actuelle (facultatif)', de: 'Aktuelle Situation (optional)', it: 'Situazione attuale (facoltativo)' },
  { en: 'Project interests', fr: 'Centres d’intérêt pour les projets', de: 'Interessen an Projekten', it: 'Interessi per i progetti' },
  {
    en: 'Skills, tools or experience you could bring, and what you would like to learn',
    fr: 'Compétences, outils ou expérience que vous pourriez apporter, et ce que vous aimeriez apprendre',
    de: 'Fähigkeiten, Tools oder Erfahrungen, die Sie einbringen könnten, und was Sie lernen möchten',
    it: 'Competenze, strumenti o esperienze che si possono apportare e ciò che si desidera imparare',
  },
  {
    en: 'Availability: when you could start and how much time you could usually make available',
    fr: 'Disponibilité\u00A0: à partir de quand vous pourriez commencer et combien de temps vous pourriez habituellement y consacrer',
    de: 'Verfügbarkeit: wann Sie beginnen könnten und wie viel Zeit Sie in der Regel zur Verfügung hätten',
    it: 'Disponibilità: quando si potrebbe iniziare e quanto tempo si potrebbe di solito dedicare',
  },
  { en: 'Remote or on-site preference (optional)', fr: 'Préférence pour le travail à distance ou sur place (facultatif)', de: 'Präferenz für Remote-Arbeit oder Arbeit vor Ort (optional)', it: 'Preferenza per il lavoro a distanza o in presenza (facoltativo)' },
  { en: 'Up to two links, such as a profile or work example (optional)', fr: 'Jusqu’à deux liens, par exemple un profil ou un exemple de travail (facultatif)', de: 'Bis zu zwei Links, zum Beispiel ein Profil oder eine Arbeitsprobe (optional)', it: 'Fino a due link, ad esempio un profilo o un esempio di lavoro (facoltativo)' },
  {
    en: 'Your acknowledgement of the programme expectations, with the version of that text',
    fr: 'Votre confirmation d’avoir pris connaissance des attentes du programme, avec la version de ce texte',
    de: 'Ihre Bestätigung der Erwartungen an das Programm, mit der Version dieses Textes',
    it: 'La conferma di aver preso atto delle aspettative del programma, con la versione di tale testo',
  },
];
const experienceAdded: Copy = {
  en: 'an application reference, the application language, the date and time of submission and the page from which the form was sent.',
  fr: 'une référence de candidature, la langue de la candidature, la date et l’heure d’envoi et la page depuis laquelle le formulaire a été envoyé.',
  de: 'eine Referenznummer, die Sprache der Bewerbung, Datum und Uhrzeit des Absendens und die Seite, von der aus das Formular gesendet wurde.',
  it: 'un riferimento della candidatura, la lingua della candidatura, data e ora dell’invio e la pagina da cui è stato inviato il modulo.',
};

const rights: Copy[] = [
  { en: 'request information about your personal data', fr: 'demander des informations sur vos données personnelles', de: 'Auskunft über Ihre Personendaten verlangen', it: 'chiedere informazioni sui propri dati personali' },
  { en: 'have incorrect data corrected', fr: 'faire corriger des données inexactes', de: 'unrichtige Daten berichtigen lassen', it: 'far rettificare i dati inesatti' },
  { en: 'have your data deleted, where applicable', fr: 'faire supprimer vos données, lorsque cela s’applique', de: 'Ihre Daten löschen lassen, soweit anwendbar', it: 'far cancellare i propri dati, ove applicabile' },
  { en: 'have processing restricted or object to it, where applicable', fr: 'faire limiter le traitement ou vous y opposer, lorsque cela s’applique', de: 'die Bearbeitung einschränken lassen oder ihr widersprechen, soweit anwendbar', it: 'chiedere la limitazione del trattamento od opporvisi, ove applicabile' },
  { en: 'withdraw your consent at any time where processing is based on consent', fr: 'retirer à tout moment votre consentement lorsque le traitement repose sur celui-ci', de: 'Ihre Einwilligung jederzeit widerrufen, wenn die Bearbeitung auf einer Einwilligung beruht', it: 'revocare in qualsiasi momento il consenso, se il trattamento si basa sul consenso' },
];
---

<BaseLayout 
  title={policyName} 
  description={pick(lang, {
    en: 'Arklens Privacy Policy - How we collect, use and protect your personal data.',
    fr: 'Politique de confidentialité d’Arklens\u00A0: comment nous collectons, utilisons et protégeons vos données personnelles.',
    de: 'Datenschutzerklärung von Arklens: wie wir Ihre Personendaten erheben, verwenden und schützen.',
    it: 'Informativa sulla privacy di Arklens: come raccogliamo, utilizziamo e proteggiamo i dati personali.',
  })} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {pick(lang, { en: 'Privacy Policy', fr: 'Politique de confidentialité', de: 'Datenschutz\u00ADerklärung', it: 'Informativa sulla privacy' })}
      </h1>
      
      {/* break-words lets long strings (e-mail address) wrap on narrow screens; the UID stays whole (nowrap) */}
      <div class="prose prose-lg max-w-none break-words">
        <p class="text-body-lg text-neutral-600 mb-8">
          {pick(lang, { en: 'Last updated: ', fr: 'Dernière mise à jour\u00A0: ', de: 'Zuletzt aktualisiert: ', it: 'Ultimo aggiornamento: ' })}{formatLegalVersion(PRIVACY_VERSION, dateLocales[lang])}
        </p>

        <section class="mb-8">
          <h2 class={h2}>
            {pick(lang, { en: '1. Introduction', fr: '1. Introduction', de: '1. Einleitung', it: '1. Introduzione' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'This Privacy Policy explains how Arklens processes personal data when you visit www.arklens.ch and when you contact us or apply through the forms on this website.',
              fr: 'La présente politique de confidentialité explique comment Arklens traite les données personnelles lorsque vous consultez www.arklens.ch et lorsque vous nous contactez ou déposez une demande via les formulaires de ce site.',
              de: 'Diese Datenschutzerklärung erläutert, wie Arklens Personendaten bearbeitet, wenn Sie www.arklens.ch besuchen und wenn Sie uns über die Formulare dieser Website kontaktieren oder sich bewerben.',
              it: 'La presente informativa sulla privacy spiega come Arklens tratta i dati personali quando l’utente visita www.arklens.ch e quando ci contatta o presenta una richiesta tramite i moduli di questo sito.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'This privacy policy is available in English, French, German and Italian. In the event of any discrepancy between language versions, the English version prevails, to the extent permitted by applicable law.',
              fr: 'La présente politique de confidentialité est disponible en anglais, en français, en allemand et en italien. En cas de divergence entre les versions linguistiques, la version anglaise fait foi, dans la mesure permise par le droit applicable.',
              de: 'Diese Datenschutzerklärung ist auf Englisch, Französisch, Deutsch und Italienisch verfügbar. Bei Abweichungen zwischen den Sprachfassungen ist die englische Fassung massgebend, soweit dies nach geltendem Recht zulässig ist.',
              it: 'La presente informativa sulla privacy è disponibile in inglese, francese, tedesco e italiano. In caso di discrepanze tra le versioni linguistiche, prevale la versione inglese, nella misura consentita dalla legge applicabile.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class={h2}>
            {pick(lang, { en: '2. Controller', fr: '2. Responsable du traitement', de: '2. Verantwortliche Stelle', it: '2. Titolare del trattamento' })}
          </h2>
          <p class="text-neutral-700 mb-4">
            {pick(lang, {
              en: 'The controller responsible for the processing described in this policy is:',
              fr: 'Le responsable du traitement décrit dans la présente politique est\u00A0:',
              de: 'Verantwortlich für die in dieser Datenschutzerklärung beschriebene Bearbeitung ist:',
              it: 'Il titolare del trattamento descritto nella presente informativa è:',
            })}
          </p>
          <div class="text-neutral-700 space-y-2">
            <address class="not-italic">
              Arklens Sàrl<br />
              Rue de Champ-Barby 18<br />
              1630 Bulle<br />
              {pick(lang, { en: 'Switzerland', fr: 'Suisse', de: 'Schweiz', it: 'Svizzera' })}
            </address>
            <p><strong>{pick(lang, { en: 'UID:', fr: 'IDE\u00A0:', de: 'UID:', it: 'IDI:' })}</strong> <span class="whitespace-nowrap">CHE-160.960.708</span></p>
            <p><strong>{pick(lang, { en: 'Email:', fr: 'E-mail\u00A0:', de: 'E-Mail:', it: 'E-mail:' })}</strong> <a href={`mailto:${EMAIL}`} class={link}>{EMAIL}</a></p>
          </div>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'For any questions about privacy or to exercise your rights, please contact us at this email address.',
              fr: 'Pour toute question relative à la protection des données ou pour exercer vos droits, veuillez nous contacter à cette adresse e-mail.',
              de: 'Bei Fragen zum Datenschutz oder zur Ausübung Ihrer Rechte kontaktieren Sie uns bitte unter dieser E-Mail-Adresse.',
              it: 'Per qualsiasi domanda sulla protezione dei dati o per esercitare i propri diritti, è possibile contattarci a questo indirizzo e-mail.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class={h2}>
            {pick(lang, { en: '3. Data we receive through our forms', fr: '3. Données reçues via nos formulaires', de: '3. Daten aus unseren Formularen', it: '3. Dati ricevuti tramite i nostri moduli' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'We only receive the information you enter in a form, plus a few details our server adds when you submit it. Our forms do not ask for sensitive personal data. Please do not include any in your messages.',
              fr: 'Nous recevons uniquement les informations que vous saisissez dans un formulaire, ainsi que quelques indications ajoutées par notre serveur lors de l’envoi. Nos formulaires ne demandent pas de données personnelles sensibles. Merci de ne pas en indiquer dans vos messages.',
              de: 'Wir erhalten nur die Angaben, die Sie in ein Formular eingeben, sowie einige Angaben, die unser Server beim Absenden ergänzt. Unsere Formulare fragen keine besonders schützenswerten Personendaten ab. Bitte geben Sie solche Daten auch in Ihren Nachrichten nicht an.',
              it: 'Riceviamo solo le informazioni inserite dall’utente in un modulo, oltre ad alcuni dati che il nostro server aggiunge al momento dell’invio. I nostri moduli non richiedono dati personali degni di particolare protezione. Si prega di non indicarne nei messaggi.',
            })}
          </p>

          <h3 class={h3}>
            {pick(lang, { en: '3.1 General contact form', fr: '3.1 Formulaire de contact', de: '3.1 Allgemeines Kontaktformular', it: '3.1 Modulo di contatto' })}
          </h3>
          <ul class={ul}>
            {contactFields.map((f) => <li>{pick(lang, f)}</li>)}
          </ul>
          <p class="text-neutral-700 mt-4">{pick(lang, addedLabel)}{pick(lang, contactAdded)}</p>

          <h3 class={h3}>
            {pick(lang, { en: '3.2 Arklens Website Programme application', fr: '3.2 Demande pour le Programme Site web Arklens', de: '3.2 Anfrage für das Arklens Website-Programm', it: '3.2 Richiesta per il Programma Sito web Arklens' })}
          </h3>
          <ul class={ul}>
            {startFields.map((f) => <li>{pick(lang, f)}</li>)}
          </ul>
          <p class="text-neutral-700 mt-4">{pick(lang, addedLabel)}{pick(lang, startAdded)}</p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'No payment information is collected through this form.',
              fr: 'Aucune information de paiement n’est collectée via ce formulaire.',
              de: 'Über dieses Formular werden keine Zahlungsinformationen erhoben.',
              it: 'Tramite questo modulo non vengono raccolte informazioni di pagamento.',
            })}
          </p>

          <h3 class={h3}>
            {pick(lang, { en: '3.3 Arklens Experience Programme application', fr: '3.3 Candidature à l’Arklens Experience Programme', de: '3.3 Bewerbung für das Arklens Experience Programme', it: '3.3 Candidatura all’Arklens Experience Programme' })}
          </h3>
          <ul class={ul}>
            {experienceFields.map((f) => <li>{pick(lang, f)}</li>)}
          </ul>
          <p class="text-neutral-700 mt-4">{pick(lang, addedLabel)}{pick(lang, experienceAdded)}</p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'The application does not ask for a CV, date of birth, nationality, gender, photo, home address, work permit, salary or health information.',
              fr: 'La candidature ne demande pas de CV, de date de naissance, de nationalité, de genre, de photo, d’adresse privée, de permis de travail, de salaire ni d’informations de santé.',
              de: 'Die Bewerbung fragt weder nach einem Lebenslauf noch nach Geburtsdatum, Staatsangehörigkeit, Geschlecht, Foto, Wohnadresse, Arbeitsbewilligung, Lohn oder Gesundheitsdaten.',
              it: 'La candidatura non richiede CV, data di nascita, nazionalità, genere, foto, indirizzo di domicilio, permesso di lavoro, salario o informazioni sulla salute.',
            })}
          </p>

          <p class="text-neutral-700 mt-6">
            {pick(lang, {
              en: 'After you submit a form, we send a confirmation email to the address you entered.',
              fr: 'Après l’envoi d’un formulaire, nous envoyons un e-mail de confirmation à l’adresse que vous avez indiquée.',
              de: 'Nach dem Absenden eines Formulars senden wir eine Bestätigungs-E-Mail an die von Ihnen angegebene Adresse.',
              it: 'Dopo l’invio di un modulo, inviamo un’e-mail di conferma all’indirizzo indicato.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class={h2}>
            {pick(lang, { en: '4. How we use your data', fr: '4. Utilisation des données', de: '4. Verwendung der Daten', it: '4. Utilizzo dei dati' })}
          </h2>
          <ul class={ul}>
            <li>{pick(lang, {
              en: 'General contact form: to respond to your message and follow up on your enquiry.',
              fr: 'Formulaire de contact\u00A0: pour répondre à votre message et assurer le suivi de votre demande.',
              de: 'Allgemeines Kontaktformular: um Ihre Nachricht zu beantworten und Ihr Anliegen weiterzuverfolgen.',
              it: 'Modulo di contatto: per rispondere al messaggio e dare seguito alla richiesta.',
            })}</li>
            <li>{pick(lang, {
              en: 'Arklens Website Programme: to review your application, check whether your business is suitable for the programme, contact you and, if your application is accepted, administer your project.',
              fr: 'Programme Site web Arklens\u00A0: pour examiner votre demande, vérifier si votre entreprise convient au programme, vous contacter et, si votre demande est acceptée, gérer votre projet.',
              de: 'Arklens Website-Programm: um Ihre Anfrage zu prüfen, abzuklären, ob Ihr Unternehmen für das Programm geeignet ist, Sie zu kontaktieren und, falls Ihre Anfrage angenommen wird, Ihr Projekt zu verwalten.',
              it: 'Programma Sito web Arklens: per esaminare la richiesta, verificare se l’azienda è adatta al programma, contattare l’utente e, se la richiesta viene accettata, gestire il progetto.',
            })}</li>
            <li>{pick(lang, {
              en: 'Arklens Experience Programme: to review your application, assess possible project matches, contact you and manage the application process. We do not use Experience applications for marketing.',
              fr: 'Arklens Experience Programme\u00A0: pour examiner votre candidature, évaluer les projets qui pourraient vous correspondre, vous contacter et gérer le processus de candidature. Nous n’utilisons pas les candidatures à l’Experience Programme à des fins de marketing.',
              de: 'Arklens Experience Programme: um Ihre Bewerbung zu prüfen, mögliche passende Projekte abzuklären, Sie zu kontaktieren und das Bewerbungsverfahren abzuwickeln. Bewerbungen für das Experience Programme verwenden wir nicht für Marketing.',
              it: 'Arklens Experience Programme: per esaminare la candidatura, valutare possibili progetti adatti, contattare l’utente e gestire la procedura di candidatura. Non utilizziamo le candidature all’Experience Programme per scopi di marketing.',
            })}</li>
          </ul>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'The Experience Programme is intended for eligible participants under the programme rules. Additional consent or information may be required before a project begins, where applicable.',
              fr: 'L’Experience Programme s’adresse aux participants qui remplissent les conditions prévues par les règles du programme. Un consentement ou des informations supplémentaires peuvent être nécessaires avant le début d’un projet, le cas échéant.',
              de: 'Das Experience Programme richtet sich an Teilnehmende, welche die Voraussetzungen gemäss den Programmregeln erfüllen. Gegebenenfalls können vor Beginn eines Projekts zusätzliche Einwilligungen oder Angaben erforderlich sein.',
              it: 'L’Experience Programme è destinato ai partecipanti che soddisfano i requisiti previsti dalle regole del programma. Se del caso, prima dell’inizio di un progetto possono essere necessari un consenso o informazioni supplementari.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'For all forms, we also use technical data to protect them against spam and abuse (see section 5).',
              fr: 'Pour tous les formulaires, nous utilisons également des données techniques afin de les protéger contre le spam et les abus (voir section 5).',
              de: 'Bei allen Formularen verwenden wir zudem technische Daten, um sie vor Spam und Missbrauch zu schützen (siehe Abschnitt 5).',
              it: 'Per tutti i moduli utilizziamo inoltre dati tecnici per proteggerli da spam e abusi (vedi sezione 5).',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class={h2}>
            {pick(lang, { en: '5. Website, security and technical data', fr: '5. Site web, sécurité et données techniques', de: '5. Website, Sicherheit und technische Daten', it: '5. Sito web, sicurezza e dati tecnici' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'Our website is hosted on Cloudflare Pages and delivered through Cloudflare’s network (CDN). When you visit it, Cloudflare processes technical information needed to deliver and protect the website, such as your IP address, browser information and the page requested.',
              fr: 'Notre site web est hébergé sur Cloudflare Pages et diffusé via le réseau de Cloudflare (CDN). Lorsque vous le consultez, Cloudflare traite les informations techniques nécessaires pour diffuser et protéger le site, par exemple votre adresse IP, des informations sur votre navigateur et la page demandée.',
              de: 'Unsere Website wird auf Cloudflare Pages gehostet und über das Netzwerk von Cloudflare (CDN) ausgeliefert. Bei Ihrem Besuch bearbeitet Cloudflare technische Informationen, die für die Auslieferung und den Schutz der Website erforderlich sind, zum Beispiel Ihre IP-Adresse, Angaben zu Ihrem Browser und die aufgerufene Seite.',
              it: 'Il nostro sito web è ospitato su Cloudflare Pages e distribuito tramite la rete di Cloudflare (CDN). Durante la visita, Cloudflare tratta le informazioni tecniche necessarie per distribuire e proteggere il sito, ad esempio l’indirizzo IP, informazioni sul browser e la pagina richiesta.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'Our forms use Cloudflare Turnstile to protect against spam and automated abuse. Turnstile processes technical signals from your browser, such as your IP address and browser characteristics. When you submit a form, our server sends the result of this security check and your IP address to Cloudflare for verification.',
              fr: 'Nos formulaires utilisent Cloudflare Turnstile pour se protéger contre le spam et les abus automatisés. Turnstile traite des signaux techniques de votre navigateur, par exemple votre adresse IP et les caractéristiques de votre navigateur. Lorsque vous envoyez un formulaire, notre serveur transmet le résultat de ce contrôle de sécurité et votre adresse IP à Cloudflare pour vérification.',
              de: 'Unsere Formulare verwenden Cloudflare Turnstile zum Schutz vor Spam und automatisiertem Missbrauch. Turnstile bearbeitet technische Signale Ihres Browsers, zum Beispiel Ihre IP-Adresse und Merkmale Ihres Browsers. Wenn Sie ein Formular absenden, übermittelt unser Server das Ergebnis dieser Sicherheitsprüfung und Ihre IP-Adresse zur Überprüfung an Cloudflare.',
              it: 'I nostri moduli utilizzano Cloudflare Turnstile per proteggersi da spam e abusi automatizzati. Turnstile tratta segnali tecnici del browser, ad esempio l’indirizzo IP e le caratteristiche del browser. Al momento dell’invio di un modulo, il nostro server trasmette a Cloudflare il risultato di questo controllo di sicurezza e l’indirizzo IP per la verifica.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'To prevent abuse, our server limits the number of form submissions from the same IP address. For this, it briefly stores only a shortened, hashed (pseudonymised) value derived from your IP address, together with a counter. This entry is deleted automatically after no more than 10 minutes. Your IP address is not included in the messages we receive.',
              fr: 'Pour prévenir les abus, notre serveur limite le nombre d’envois de formulaires depuis une même adresse IP. Pour cela, il enregistre brièvement uniquement une valeur raccourcie et hachée (pseudonymisée) dérivée de votre adresse IP, avec un compteur. Cette entrée est supprimée automatiquement après 10 minutes au plus. Votre adresse IP ne figure pas dans les messages que nous recevons.',
              de: 'Um Missbrauch zu verhindern, begrenzt unser Server die Anzahl der Formularübermittlungen von derselben IP-Adresse. Dafür speichert er kurzzeitig nur einen gekürzten, gehashten (pseudonymisierten) Wert, der aus Ihrer IP-Adresse abgeleitet wird, zusammen mit einem Zähler. Dieser Eintrag wird nach höchstens 10 Minuten automatisch gelöscht. Ihre IP-Adresse ist in den Nachrichten, die wir erhalten, nicht enthalten.',
              it: 'Per prevenire abusi, il nostro server limita il numero di invii di moduli dallo stesso indirizzo IP. A tal fine memorizza brevemente solo un valore abbreviato e sottoposto a hash (pseudonimizzato), derivato dall’indirizzo IP, insieme a un contatore. Questa voce viene cancellata automaticamente dopo al massimo 10 minuti. L’indirizzo IP non è incluso nei messaggi che riceviamo.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'When you open the home page, our server may use your browser’s language setting and your saved language choice (see section 6) to show the matching language version. This information is not stored.',
              fr: 'Lorsque vous ouvrez la page d’accueil, notre serveur peut utiliser le réglage de langue de votre navigateur et votre choix de langue enregistré (voir section 6) pour afficher la version linguistique correspondante. Ces informations ne sont pas enregistrées.',
              de: 'Wenn Sie die Startseite öffnen, kann unser Server die Spracheinstellung Ihres Browsers und Ihre gespeicherte Sprachwahl (siehe Abschnitt 6) verwenden, um die passende Sprachversion anzuzeigen. Diese Informationen werden nicht gespeichert.',
              it: 'Quando l’utente apre la pagina iniziale, il nostro server può utilizzare l’impostazione della lingua del browser e la scelta della lingua salvata (vedi sezione 6) per mostrare la versione linguistica corrispondente. Queste informazioni non vengono memorizzate.',
