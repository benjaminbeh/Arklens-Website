---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { pick } from '@lib/pick';

import { localeStaticPaths, getLocalizedPath, type Language } from '@i18n/index';
export function getStaticPaths() { return localeStaticPaths(); }
const { lang } = Astro.props as { lang: Language };

// Company identity as listed in the Swiss Federal UID register.
const EMAIL = 'swiss_contact@arklens.ch';
const websiteLabel = pick(lang, { en: 'Website:', fr: 'Site web\u00A0:', de: 'Website:', it: 'Sito web:' });
---

<BaseLayout 
  title={pick(lang, { en: 'Legal Notice', fr: 'Mentions légales', de: 'Impressum', it: 'Note legali' })} 
  description={pick(lang, {
    en: 'Legal notice for Arklens: company information, contact details, website hosting, intellectual property, liability and applicable Swiss law.',
    fr: 'Mentions légales d’Arklens\u00A0: informations sur l’entreprise, hébergement, propriété intellectuelle et droit applicable.',
    de: 'Impressum von Arklens: Angaben zum Unternehmen, Hosting, geistiges Eigentum und anwendbares Recht.',
    it: 'Note legali di Arklens: informazioni sull’azienda, hosting, proprietà intellettuale e diritto applicabile.',
  })} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {pick(lang, { en: 'Legal Notice', fr: 'Mentions légales', de: 'Impressum', it: 'Note legali' })}
      </h1>
      
      <div class="prose prose-lg max-w-none">
        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Company Information', fr: 'Informations sur l’entreprise', de: 'Angaben zum Unternehmen', it: 'Informazioni sull’azienda' })}
          </h2>
          <!-- break-words lets the e-mail wrap at 320 px; UID and register numbers stay whole (nowrap) so they never split at a hyphen -->
          <div class="text-neutral-700 space-y-2 break-words">
            <p><strong>{pick(lang, { en: 'Company name:', fr: 'Raison sociale\u00A0:', de: 'Firma:', it: 'Ragione sociale:' })}</strong> Arklens Sàrl</p>
            <p><strong>{pick(lang, { en: 'Legal form:', fr: 'Forme juridique\u00A0:', de: 'Rechtsform:', it: 'Forma giuridica:' })}</strong> {pick(lang, {
              en: 'Limited liability company under Swiss law (Sàrl)',
              fr: 'Société à responsabilité limitée (Sàrl)',
              de: 'Gesellschaft mit beschränkter Haftung (GmbH/Sàrl)',
              it: 'Società a garanzia limitata (Sagl/Sàrl)',
            })}</p>
            <p><strong>{pick(lang, { en: 'Registered address:', fr: 'Adresse du siège\u00A0:', de: 'Domiziladresse:', it: 'Sede legale:' })}</strong></p>
            <address class="not-italic">
              Arklens Sàrl<br />
              Rue de Champ-Barby 18<br />
              1630 Bulle<br />
              {pick(lang, { en: 'Switzerland', fr: 'Suisse', de: 'Schweiz', it: 'Svizzera' })}
            </address>
            <p><strong>{pick(lang, { en: 'UID:', fr: 'IDE\u00A0:', de: 'UID:', it: 'IDI:' })}</strong> <span class="whitespace-nowrap">CHE-160.960.708</span></p>
            <p><strong>{pick(lang, { en: 'Commercial Register:', fr: 'Registre du commerce\u00A0:', de: 'Handelsregister:', it: 'Registro di commercio:' })}</strong> <span class="whitespace-nowrap">CH-217.3.560.062-6</span></p>
            <p><strong>{pick(lang, { en: 'Email:', fr: 'E-mail\u00A0:', de: 'E-Mail:', it: 'E-mail:' })}</strong> <a href={`mailto:${EMAIL}`} class="text-primary-600 hover:text-primary-700">{EMAIL}</a></p>
            <p><strong>{websiteLabel}</strong> www.arklens.ch</p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Hosting', fr: 'Hébergement', de: 'Hosting', it: 'Hosting' })}
          </h2>
          <div class="text-neutral-700">
            <p><strong>{pick(lang, { en: 'Host:', fr: 'Hébergeur\u00A0:', de: 'Hosting-Anbieter:', it: 'Fornitore di hosting:' })}</strong> Cloudflare, Inc.</p>
            <p>101 Townsend St, San Francisco, CA 94107, USA</p>
            <p>{websiteLabel} <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">www.cloudflare.com</a></p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Intellectual Property', fr: 'Propriété intellectuelle', de: 'Geistiges Eigentum', it: 'Proprietà intellettuale' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'All content on this site (text, images, graphics, logo, icons, etc.) is the property of Arklens, unless otherwise stated. Any reproduction, distribution, modification or use without prior authorization is prohibited.',
              fr: 'L’ensemble du contenu de ce site (textes, images, graphiques, logo, icônes, etc.) est la propriété d’Arklens, sauf mention contraire. Toute reproduction, distribution, modification ou utilisation sans autorisation préalable est interdite.',
              de: 'Alle Inhalte dieser Website (Texte, Bilder, Grafiken, Logo, Symbole usw.) sind Eigentum von Arklens, sofern nicht anders angegeben. Jede Vervielfältigung, Verbreitung, Änderung oder Nutzung ohne vorgängige Zustimmung ist untersagt.',
              it: 'Tutti i contenuti di questo sito (testi, immagini, grafiche, logo, icone ecc.) sono di proprietà di Arklens, salvo diversa indicazione. È vietata qualsiasi riproduzione, distribuzione, modifica o utilizzo senza previa autorizzazione.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Liability', fr: 'Responsabilité', de: 'Haftung', it: 'Responsabilità' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'Arklens strives to provide accurate and up-to-date information on this site but cannot guarantee its accuracy or completeness. We disclaim all liability for any errors or omissions, to the extent permitted by law.',
              fr: 'Arklens s’efforce de fournir des informations exactes et à jour sur ce site, mais ne peut en garantir l’exactitude ni l’exhaustivité. Nous déclinons toute responsabilité en cas d’erreur ou d’omission, dans la mesure permise par la loi.',
              de: 'Arklens bemüht sich, auf dieser Website korrekte und aktuelle Informationen bereitzustellen, kann deren Richtigkeit und Vollständigkeit jedoch nicht garantieren. Wir lehnen jede Haftung für Fehler oder Auslassungen ab, soweit gesetzlich zulässig.',
              it: 'Arklens si impegna a fornire su questo sito informazioni corrette e aggiornate, ma non può garantirne l’esattezza né la completezza. Decliniamo ogni responsabilità per eventuali errori od omissioni, nella misura consentita dalla legge.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'External Links', fr: 'Liens externes', de: 'Externe Links', it: 'Link esterni' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'This site may contain links to external websites. Arklens has no control over the content of these sites and disclaims all responsibility for their content or availability.',
              fr: 'Ce site peut contenir des liens vers des sites web externes. Arklens n’a aucun contrôle sur le contenu de ces sites et décline toute responsabilité quant à leur contenu ou à leur disponibilité.',
              de: 'Diese Website kann Links zu externen Websites enthalten. Arklens hat keine Kontrolle über den Inhalt dieser Websites und lehnt jede Verantwortung für deren Inhalt oder Verfügbarkeit ab.',
              it: 'Questo sito può contenere link a siti web esterni. Arklens non ha alcun controllo sul contenuto di tali siti e declina ogni responsabilità per il loro contenuto o la loro disponibilità.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Applicable Law', fr: 'Droit applicable', de: 'Anwendbares Recht', it: 'Diritto applicabile' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'This legal notice is governed by Swiss law. Any dispute shall be subject to the exclusive jurisdiction of the Swiss courts.',
              fr: 'Les présentes mentions légales sont régies par le droit suisse. Tout litige est soumis à la compétence exclusive des tribunaux suisses.',
              de: 'Dieses Impressum untersteht schweizerischem Recht. Für jede Streitigkeit sind ausschliesslich die schweizerischen Gerichte zuständig.',
              it: 'Le presenti note legali sono disciplinate dal diritto svizzero. Qualsiasi controversia è soggetta alla giurisdizione esclusiva dei tribunali svizzeri.',
            })}
          </p>
          <p class="text-neutral-700 mt-4">
            {pick(lang, {
              en: 'This legal notice is available in English, French, German and Italian. In the event of any discrepancy between language versions, the English version prevails, to the extent permitted by applicable law.',
              fr: 'Les présentes mentions légales sont disponibles en anglais, en français, en allemand et en italien. En cas de divergence entre les versions linguistiques, la version anglaise fait foi, dans la mesure permise par le droit applicable.',
              de: 'Dieses Impressum ist auf Englisch, Französisch, Deutsch und Italienisch verfügbar. Bei Abweichungen zwischen den Sprachfassungen ist die englische Fassung massgebend, soweit dies nach geltendem Recht zulässig ist.',
              it: 'Le presenti note legali sono disponibili in inglese, francese, tedesco e italiano. In caso di discrepanze tra le versioni linguistiche, prevale la versione inglese, nella misura consentita dalla legge applicabile.',
            })}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {pick(lang, { en: 'Data Protection', fr: 'Protection des données', de: 'Datenschutz', it: 'Protezione dei dati' })}
          </h2>
          <p class="text-neutral-700">
            {pick(lang, {
              en: 'For more information on how we process your personal data, please see our ',
              fr: 'Pour en savoir plus sur la manière dont nous traitons vos données personnelles, consultez notre ',
              de: 'Weitere Informationen dazu, wie wir Ihre Personendaten bearbeiten, finden Sie in unserer ',
              it: 'Per maggiori informazioni su come trattiamo i dati personali degli utenti, consultare la nostra ',
            })}
            <a href={getLocalizedPath('/privacy', lang)} class="text-primary-600 hover:text-primary-700">
              {pick(lang, { en: 'Privacy Policy', fr: 'Politique de confidentialité', de: 'Datenschutzerklärung', it: 'Informativa sulla privacy' })}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
