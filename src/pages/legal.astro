---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const lang = 'en';
---

<BaseLayout 
  title={lang === 'en' ? 'Legal Notice' : 'Mentions légales'} 
  description={lang === 'en' ? 'Legal information about Arklens.' : 'Mentions légales et informations sur Arklens.'} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {lang === 'en' ? 'Legal Notice' : 'Mentions légales'}
      </h1>
      
      <div class="prose prose-lg max-w-none">
        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Company Information' : 'Informations sur l\'entreprise'}
          </h2>
          <div class="text-neutral-700 space-y-2">
            <p><strong>{lang === 'en' ? 'Company name:' : 'Nom de l\'entreprise :'}</strong> Arklens</p>
            <p><strong>{lang === 'en' ? 'Legal form:' : 'Forme juridique :'}</strong> {lang === 'en' ? '[To be completed]' : '[À compléter]'}</p>
            <p><strong>{lang === 'en' ? 'Address:' : 'Adresse :'}</strong> {lang === 'en' ? '[To be completed]' : '[À compléter]'}</p>
            <p><strong>{lang === 'en' ? 'Switzerland' : 'Suisse'}</strong></p>
            <p><strong>Email:</strong> contact@arklens.ch</p>
            <p><strong>{lang === 'en' ? 'Website:' : 'Site web :'}</strong> www.arklens.ch</p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Legal Representative' : 'Représentant légal'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en' ? '[To be completed: Name of director or legal representative]' : '[À compléter : Nom du directeur ou représentant légal]'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Identification Number' : 'Numéro d\'identification'}
          </h2>
          <div class="text-neutral-700 space-y-2">
            <p><strong>IDE/UID:</strong> {lang === 'en' ? '[To be completed]' : '[À compléter]'}</p>
            <p><strong>{lang === 'en' ? 'VAT:' : 'TVA :'}</strong> {lang === 'en' ? '[To be completed if applicable]' : '[À compléter si assujetti]'}</p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Hosting' : 'Hébergement'}
          </h2>
          <div class="text-neutral-700">
            <p><strong>{lang === 'en' ? 'Host:' : 'Hébergeur :'}</strong> Cloudflare, Inc.</p>
            <p>101 Townsend St, San Francisco, CA 94107, USA</p>
            <p>{lang === 'en' ? 'Website:' : 'Site web :'} <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">www.cloudflare.com</a></p>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Intellectual Property' : 'Propriété intellectuelle'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en' 
              ? 'All content on this site (text, images, graphics, logo, icons, etc.) is the property of Arklens, unless otherwise stated. Any reproduction, distribution, modification or use without prior authorization is prohibited.'
              : 'L\'ensemble du contenu de ce site (textes, images, graphiques, logo, icônes, etc.) est la propriété d\'Arklens, sauf mention contraire. Toute reproduction, distribution, modification ou utilisation sans autorisation préalable est interdite.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Liability' : 'Responsabilité'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'Arklens strives to provide accurate and up-to-date information on this site. However, we cannot guarantee the accuracy, precision or completeness of the information provided. We disclaim all liability for any errors or omissions.'
              : 'Arklens s\'efforce de fournir des informations exactes et à jour sur ce site. Toutefois, nous ne pouvons garantir l\'exactitude, la précision ou l\'exhaustivité des informations fournies. Nous déclinons toute responsabilité en cas d\'erreur ou d\'omission.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'External Links' : 'Liens externes'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'This site may contain links to external websites. Arklens has no control over the content of these sites and disclaims all responsibility for their content or availability.'
              : 'Ce site peut contenir des liens vers des sites web externes. Arklens n\'a aucun contrôle sur le contenu de ces sites et décline toute responsabilité concernant leur contenu ou leur disponibilité.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Applicable Law' : 'Droit applicable'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'This legal notice is governed by Swiss law. Any dispute shall be subject to the exclusive jurisdiction of the Swiss courts.'
              : 'Ces mentions légales sont régies par le droit suisse. Tout litige sera soumis à la juridiction exclusive des tribunaux suisses.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? 'Data Protection' : 'Protection des données'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'For more information on how we process your personal data, please see our '
              : 'Pour plus d\'informations sur la façon dont nous traitons vos données personnelles, veuillez consulter notre '}
            <a href="/privacy" class="text-primary-600 hover:text-primary-700">
              {lang === 'en' ? 'Privacy Policy' : 'Politique de confidentialité'}
            </a>.
          </p>
        </section>

        <div class="bg-neutral-50 rounded-xl p-6 mt-12 border border-neutral-200">
          <p class="text-sm text-neutral-600">
            <strong>{lang === 'en' ? 'Note:' : 'Note :'}</strong> 
            {lang === 'en'
              ? 'This legal notice is provided as a template. It is recommended to have it reviewed by a legal advisor to ensure compliance with applicable Swiss law.'
              : 'Ces mentions légales sont fournies à titre de modèle. Il est recommandé de les faire réviser par un conseiller juridique pour assurer leur conformité avec la législation suisse applicable.'}
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
