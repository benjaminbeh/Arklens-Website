---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const lang = 'en';
---

<BaseLayout 
  title={lang === 'en' ? 'Terms of Use' : 'Conditions d\'utilisation'} 
  description={lang === 'en' ? 'Arklens Terms of Use - Terms and conditions for using our services.' : 'Conditions d\'utilisation d\'Arklens - Conditions générales d\'utilisation de nos services.'} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {lang === 'en' ? 'Terms of Use' : 'Conditions d\'utilisation'}
      </h1>
      
      <div class="prose prose-lg max-w-none">
        <p class="text-body-lg text-neutral-600 mb-8">
          {lang === 'en' ? 'Last updated: ' : 'Dernière mise à jour : '}{new Date().toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-CH')}
        </p>

        <div class="bg-amber-50 border-2 border-amber-200 rounded-xl p-6 mb-12">
          <p class="text-sm text-amber-900 font-semibold mb-2">
            ⚠️ {lang === 'en' ? 'Legal Review Required' : 'Révision juridique requise'}
          </p>
          <p class="text-sm text-amber-800">
            {lang === 'en'
              ? 'These Terms of Use are provided as a template and must be reviewed by a qualified Swiss legal advisor before being used in production. They should be adapted to reflect your actual business practices and comply with all applicable Swiss and European laws.'
              : 'Ces Conditions d\'utilisation sont fournies comme modèle et doivent être révisées par un conseiller juridique suisse qualifié avant d\'être utilisées en production. Elles doivent être adaptées pour refléter vos pratiques commerciales réelles et se conformer à toutes les lois suisses et européennes applicables.'}
          </p>
        </div>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '1. Acceptance of Terms' : '1. Acceptation des conditions'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'By accessing or using Arklens services, you agree to be bound by these Terms of Use. If you do not agree to these terms, please do not use our services.'
              : 'En accédant ou en utilisant les services d\'Arklens, vous acceptez d\'être lié par ces Conditions d\'utilisation. Si vous n\'acceptez pas ces conditions, veuillez ne pas utiliser nos services.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '2. Free Website Programme' : '2. Programme de site web gratuit'}
          </h2>
          
          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.1 Programme Description' : '2.1 Description du programme'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Arklens offers a Free Website Programme as a promotional service. This programme includes the creation of a basic professional website and free hosting. The programme is designed to help Swiss small businesses establish an online presence.'
              : 'Arklens propose un Programme de site web gratuit en tant que service promotionnel. Ce programme comprend la création d\'un site web professionnel de base et un hébergement gratuit. Le programme est conçu pour aider les petites entreprises suisses à établir une présence en ligne.'}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.2 Programme Status and Changes' : '2.2 Statut et modifications du programme'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'The Free Website Programme is a promotional offering and is not guaranteed to continue indefinitely. Arklens reserves the right to modify, suspend, or discontinue the programme at any time. We may make changes to:'
              : 'Le Programme de site web gratuit est une offre promotionnelle et n\'est pas garanti de continuer indéfiniment. Arklens se réserve le droit de modifier, suspendre ou interrompre le programme à tout moment. Nous pouvons apporter des modifications à :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'The scope of services included in the free programme' : 'La portée des services inclus dans le programme gratuit'}</li>
            <li>{lang === 'en' ? 'Eligibility criteria for new participants' : 'Les critères d\'éligibilité pour les nouveaux participants'}</li>
            <li>{lang === 'en' ? 'Technical specifications or hosting arrangements' : 'Les spécifications techniques ou les arrangements d\'hébergement'}</li>
            <li>{lang === 'en' ? 'The programme\'s continuation or termination' : 'La continuation ou la fin du programme'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.3 Notice Period for Programme Changes' : '2.3 Délai de préavis pour les modifications du programme'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'If Arklens decides to end the Free Website Programme or discontinue free hosting for existing customers, we will aim to provide at least 60 days\' advance notice via email to the address you provided.'
              : 'Si Arklens décide de mettre fin au Programme de site web gratuit ou d\'arrêter l\'hébergement gratuit pour les clients existants, nous nous efforcerons de fournir un préavis d\'au moins 60 jours par e-mail à l\'adresse que vous avez fournie.'}
          </p>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'This notice period may be shorter or immediate in cases of:'
              : 'Ce délai de préavis peut être plus court ou immédiat dans les cas de :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Security threats or vulnerabilities' : 'Menaces ou vulnérabilités de sécurité'}</li>
            <li>{lang === 'en' ? 'Misuse or abuse of the service' : 'Mauvaise utilisation ou abus du service'}</li>
            <li>{lang === 'en' ? 'Legal or regulatory requirements' : 'Exigences légales ou réglementaires'}</li>
            <li>{lang === 'en' ? 'Urgent technical issues affecting service stability' : 'Problèmes techniques urgents affectant la stabilité du service'}</li>
            <li>{lang === 'en' ? 'Violation of these Terms of Use' : 'Violation de ces Conditions d\'utilisation'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.4 No Retrospective Charges' : '2.4 Aucun frais rétroactif'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Arklens will never charge you retrospectively for services that were previously provided to you free of charge under the Free Website Programme. If the programme ends or changes, any charges will only apply from the date you agree to new paid terms going forward.'
              : 'Arklens ne vous facturera jamais rétroactivement pour des services qui vous ont été précédemment fournis gratuitement dans le cadre du Programme de site web gratuit. Si le programme se termine ou change, tous les frais ne s\'appliqueront qu\'à partir de la date à laquelle vous acceptez de nouvelles conditions payantes à l\'avenir.'}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.5 Your Options if the Programme Ends' : '2.5 Vos options si le programme se termine'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'If Arklens discontinues the Free Website Programme or your participation in it, you have several options:'
              : 'Si Arklens interrompt le Programme de site web gratuit ou votre participation à celui-ci, vous avez plusieurs options :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>
              <strong>{lang === 'en' ? 'Continue with Arklens under paid terms:' : 'Continuer avec Arklens sous conditions payantes :'}</strong>
              {lang === 'en'
                ? ' If we offer a paid service option, you may choose to continue using Arklens services under the new paid terms. This requires your explicit agreement to the new pricing and terms before any charges begin.'
                : ' Si nous proposons une option de service payant, vous pouvez choisir de continuer à utiliser les services d\'Arklens selon les nouvelles conditions payantes. Cela nécessite votre accord explicite sur les nouveaux prix et conditions avant le début de tout frais.'}
            </li>
            <li>
              <strong>{lang === 'en' ? 'Assume hosting and infrastructure costs:' : 'Assumer les coûts d\'hébergement et d\'infrastructure :'}</strong>
              {lang === 'en'
                ? ' You may choose to take over the hosting and technical infrastructure costs directly, either with Arklens or another provider of your choice. Operating the existing Arklens-built website outside Arklens requires a separate agreement under Section 5.5.'
                : ' Vous pouvez choisir de prendre en charge directement les coûts d\'hébergement et d\'infrastructure technique, soit avec Arklens, soit avec un autre fournisseur de votre choix. L’exploitation du site existant construit par Arklens en dehors d’Arklens nécessite un accord séparé selon la section 5.5.'}
            </li>
            <li>
              <strong>{lang === 'en' ? 'Migrate to another provider:' : 'Migrer vers un autre fournisseur :'}</strong>
              {lang === 'en'
                ? ' You may migrate your website to another hosting provider or web development service. Arklens will provide reasonable technical assistance during the handover period.'
                : ' Vous pouvez migrer votre site web vers un autre fournisseur d\'hébergement ou service de développement web. Arklens fournira une assistance technique raisonnable pendant la période de transfert.'}
            </li>
            <li>
              <strong>{lang === 'en' ? 'Discontinue the website:' : 'Arrêter le site web :'}</strong>
              {lang === 'en'
                ? ' You may choose to discontinue your website entirely.'
                : ' Vous pouvez choisir d\'arrêter complètement votre site web.'}
            </li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.6 Agreement to Future Paid Services' : '2.6 Accord pour les futurs services payants'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Any transition from the Free Website Programme to a paid service requires your explicit written agreement to the new terms and pricing before charges begin. We will clearly communicate:'
              : 'Toute transition du Programme de site web gratuit vers un service payant nécessite votre accord écrit explicite aux nouvelles conditions et tarifs avant le début des frais. Nous communiquerons clairement :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'The new pricing structure' : 'La nouvelle structure tarifaire'}</li>
            <li>{lang === 'en' ? 'What services are included' : 'Les services inclus'}</li>
            <li>{lang === 'en' ? 'When charges will begin' : 'Quand les frais commenceront'}</li>
            <li>{lang === 'en' ? 'Payment terms and billing frequency' : 'Les conditions de paiement et la fréquence de facturation'}</li>
            <li>{lang === 'en' ? 'How to decline and explore other options' : 'Comment refuser et explorer d\'autres options'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.7 Domain Ownership' : '2.7 Propriété du domaine'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Your domain name always remains your property. You are responsible for purchasing and renewing your domain through a domain registrar of your choice. Arklens may assist with domain setup and configuration, but you retain full ownership and control. You may transfer your domain to another provider at any time, subject to your registrar\'s policies.'
              : 'Votre nom de domaine reste toujours votre propriété. Vous êtes responsable de l\'achat et du renouvellement de votre domaine auprès d\'un registraire de domaine de votre choix. Arklens peut vous aider à configurer et paramétrer votre domaine, mais vous conservez la pleine propriété et le contrôle. Vous pouvez transférer votre domaine vers un autre fournisseur à tout moment, sous réserve des politiques de votre registraire.'}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.8 Third-Party Costs' : '2.8 Coûts tiers'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'While the Free Website Programme includes website creation and hosting, you remain responsible for certain third-party costs unless explicitly stated otherwise in writing. These may include:'
              : 'Bien que le Programme de site web gratuit comprenne la création et l\'hébergement du site web, vous restez responsable de certains coûts tiers sauf indication contraire explicite par écrit. Ceux-ci peuvent inclure :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Domain registration and renewal fees' : 'Frais d\'enregistrement et de renouvellement du domaine'}</li>
            <li>{lang === 'en' ? 'Business email services' : 'Services de messagerie professionnelle'}</li>
            <li>{lang === 'en' ? 'Premium APIs or third-party integrations' : 'API premium ou intégrations tierces'}</li>
            <li>{lang === 'en' ? 'External databases or storage beyond basic hosting' : 'Bases de données ou stockage externes au-delà de l\'hébergement de base'}</li>
            <li>{lang === 'en' ? 'Premium software licenses or plugins' : 'Licences de logiciels premium ou plugins'}</li>
            <li>{lang === 'en' ? 'Payment processing fees' : 'Frais de traitement des paiements'}</li>
            <li>{lang === 'en' ? 'SMS, voice, or other communication services' : 'SMS, voix ou autres services de communication'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.9 Migration and Technical Assistance' : '2.9 Migration et assistance technique'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'If you choose to migrate your website to another provider, Arklens will provide reasonable technical assistance during the transition period. This may include:'
              : 'Si vous choisissez de migrer votre site web vers un autre fournisseur, Arklens fournira une assistance technique raisonnable pendant la période de transition. Cela peut inclure :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Providing your business content, customer-owned assets and business data' : 'Fournir vos contenus, les éléments qui vous appartiennent et vos données commerciales'}</li>
            <li>{lang === 'en' ? 'Guidance on DNS configuration' : 'Conseils sur la configuration DNS'}</li>
            <li>{lang === 'en' ? 'Reasonable support during the handover period' : 'Support raisonnable pendant la période de transfert'}</li>
            <li>{lang === 'en' ? 'Documentation of technical specifications' : 'Documentation des spécifications techniques'}</li>
          </ul>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Arklens source code, templates and reusable components are not automatically included in a migration. See Section 5.5 for source-code transfer options.'
              : 'Le code source, les modèles et les composants réutilisables d’Arklens ne sont pas inclus automatiquement dans une migration. Voir la section 5.5 pour les options de transfert du code source.'}
          </p>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Arklens is not responsible for the migration process itself or any issues arising from your new hosting arrangement.'
              : 'Arklens n\'est pas responsable du processus de migration lui-même ou de tout problème découlant de votre nouvel arrangement d\'hébergement.'}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '2.10 Fair Use: No Resale or White-Labelling' : '2.10 Usage loyal : ni revente ni marque blanche'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'The Free Website Programme is intended to help eligible businesses improve their own digital presence, and is provided for the participating business’s own use. It may not be used to:'
              : 'Le Programme de site web gratuit vise à aider les entreprises éligibles à améliorer leur propre présence numérique et est fourni pour l’usage propre de l’entreprise participante. Il ne peut pas être utilisé pour :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Obtain development work for resale' : 'Obtenir des travaux de développement destinés à la revente'}</li>
            <li>{lang === 'en' ? 'White-label Arklens work' : 'Proposer le travail d’Arklens en marque blanche'}</li>
            <li>{lang === 'en' ? 'Supply free development to another company’s client' : 'Fournir gratuitement du développement au client d’une autre entreprise'}</li>
            <li>{lang === 'en' ? 'Transfer Arklens websites to unrelated third parties' : 'Transférer des sites Arklens à des tiers sans lien avec l’entreprise participante'}</li>
            <li>{lang === 'en' ? 'Incorporate Arklens source code into another provider’s commercial offering' : 'Intégrer le code source d’Arklens dans l’offre commerciale d’un autre fournisseur'}</li>
            <li>{lang === 'en' ? 'Circumvent normal paid development work' : 'Contourner des travaux de développement normalement payants'}</li>
          </ul>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Arklens may reject, suspend or discontinue participation if it reasonably believes the programme is being used in this way. Your domain, business content and customer-owned assets remain yours in all cases.'
              : 'Arklens peut refuser, suspendre ou mettre fin à une participation si elle a des raisons de penser que le programme est utilisé de cette manière. Votre domaine, vos contenus et les éléments qui vous appartiennent restent les vôtres dans tous les cas.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '3. Service Exit and Data Portability' : '3. Sortie du service et portabilité des données'}
          </h2>
          
          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '3.1 Your Right to Leave' : '3.1 Votre droit de partir'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'You may terminate your use of Arklens services at any time for any reason. Arklens does not hold your business assets hostage: your domain and business content are always yours to take with you. If you leave:'
              : 'Vous pouvez résilier votre utilisation des services d\'Arklens à tout moment et pour n\'importe quelle raison. Arklens ne retient jamais vos actifs commerciaux : votre domaine et vos contenus restent toujours les vôtres. Si vous partez :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Your domain remains yours' : 'Votre domaine reste le vôtre'}</li>
            <li>{lang === 'en' ? 'Your customer-owned content and assets remain yours' : 'Vos contenus et les éléments qui vous appartiennent restent les vôtres'}</li>
            <li>{lang === 'en' ? 'Arklens provides reasonable migration assistance' : 'Arklens fournit une aide raisonnable à la migration'}</li>
            <li>{lang === 'en' ? 'Arklens source code and reusable intellectual property remain Arklens property unless separately transferred under Section 5.5' : 'Le code source et la propriété intellectuelle réutilisable d’Arklens restent la propriété d’Arklens, sauf transfert séparé selon la section 5.5'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '3.2 Handover Options' : '3.2 Options de transfert'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'When you leave Arklens, whether by your choice or due to programme changes, you have three clear options:'
              : 'Lorsque vous quittez Arklens, que ce soit par votre choix ou en raison de changements de programme, vous avez trois options claires :'}
          </p>
          
          <p class="text-neutral-700 mb-2">
            <strong>{lang === 'en' ? 'Option A: Continue with Arklens (Paid Service)' : 'Option A : Continuer avec Arklens (Service payant)'}</strong>
          </p>
          <p class="text-neutral-700 mb-4 pl-6">
            {lang === 'en'
              ? 'If Arklens offers a paid hosting or maintenance plan, you may choose to continue under paid terms. No paid service begins without your explicit written agreement to the pricing and terms. You will receive clear information about costs, services included, billing schedule, and how to decline if you prefer other options.'
              : 'Si Arklens propose un plan d\'hébergement ou de maintenance payant, vous pouvez choisir de continuer selon des conditions payantes. Aucun service payant ne commence sans votre accord écrit explicite sur les tarifs et conditions. Vous recevrez des informations claires sur les coûts, les services inclus, le calendrier de facturation et comment refuser si vous préférez d\'autres options.'}
          </p>

          <p class="text-neutral-700 mb-2">
            <strong>{lang === 'en' ? 'Option B: Self-Host Your Website' : 'Option B : Auto-héberger votre site web'}</strong>
          </p>
          <p class="text-neutral-700 mb-4 pl-6">
            {lang === 'en'
              ? 'You may move your online presence to infrastructure you manage yourself. Arklens will provide your Customer Asset Package (Section 3.3) and reasonable assistance at no additional charge. If you wish to keep running the existing Arklens-built website rather than rebuild it, a source-code transfer or Migration Package can be agreed separately (Section 5.5).'
              : 'Vous pouvez déplacer votre présence en ligne vers une infrastructure que vous gérez vous-même. Arklens fournira votre package d’actifs client (section 3.3) et une assistance raisonnable sans frais supplémentaires. Si vous souhaitez continuer à exploiter le site existant construit par Arklens plutôt que de le reconstruire, un transfert du code source ou un forfait de migration peut être convenu séparément (section 5.5).'}
          </p>

          <p class="text-neutral-700 mb-2">
            <strong>{lang === 'en' ? 'Option C: Move to Another Provider' : 'Option C : Passer à un autre fournisseur'}</strong>
          </p>
          <p class="text-neutral-700 mb-4 pl-6">
            {lang === 'en'
              ? 'You may move to another web development or hosting company. Arklens will provide your Customer Asset Package and will cooperate with your new provider where appropriate. Arklens source code, templates and reusable components are not automatically included; your new provider may build on your content, or a source-code transfer can be agreed separately (Section 5.5).'
              : 'Vous pouvez passer à une autre entreprise de développement web ou d\'hébergement. Arklens fournira votre package d’actifs client et coopérera avec votre nouveau fournisseur le cas échéant. Le code source, les modèles et les composants réutilisables d’Arklens ne sont pas inclus automatiquement ; votre nouveau fournisseur peut partir de vos contenus, ou un transfert du code source peut être convenu séparément (section 5.5).'}
          </p>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '3.3 Customer Asset Package' : '3.3 Package d’actifs client'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'When you choose Option B or Option C, Arklens will provide a Customer Asset Package containing what belongs to you:'
              : 'Lorsque vous choisissez l\'option B ou C, Arklens fournira un package d’actifs client contenant ce qui vous appartient :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Your business text and content (services, opening hours, contact details, descriptions)' : 'Vos textes et contenus (services, horaires, coordonnées, descriptions)'}</li>
            <li>{lang === 'en' ? 'Your logos, photos, images and other media you provided' : 'Vos logos, photos, images et autres médias que vous avez fournis'}</li>
            <li>{lang === 'en' ? 'Business and customer data held for you by Arklens (for example, form submissions)' : 'Les données commerciales et données clients conservées pour vous par Arklens (par exemple, les envois de formulaires)'}</li>
            <li>{lang === 'en' ? 'A list of your page addresses, to help your new setup preserve links and search visibility' : 'La liste des adresses de vos pages, pour aider votre nouvelle configuration à conserver liens et visibilité dans les moteurs de recherche'}</li>
            <li>{lang === 'en' ? 'Your current DNS settings and DNS configuration guidance' : 'Vos paramètres DNS actuels et des conseils de configuration DNS'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '3.4 What Is Not Included' : '3.4 Ce qui n\'est pas inclus'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'Unless separately agreed in writing under Section 5.5, the Customer Asset Package does not include:'
              : 'Sauf accord écrit séparé selon la section 5.5, le package d’actifs client n’inclut pas :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
            <li>{lang === 'en' ? 'Arklens source code, templates, reusable components or design systems, including the compiled website build' : 'Le code source, les modèles, les composants réutilisables ou les systèmes de design d’Arklens, y compris la version compilée du site'}</li>
            <li>{lang === 'en' ? 'Arklens development frameworks, automation scripts, deployment systems or internal tools' : 'Les frameworks de développement, scripts d’automatisation, systèmes de déploiement ou outils internes d’Arklens'}</li>
            <li>{lang === 'en' ? 'Other customers\' code, data, or intellectual property' : 'Code, données ou propriété intellectuelle d\'autres clients'}</li>
            <li>{lang === 'en' ? 'Access to Arklens Cloudflare accounts or infrastructure' : 'Accès aux comptes Cloudflare ou à l\'infrastructure d\'Arklens'}</li>
          </ul>

          <h3 class="text-heading-md mb-3 mt-6">
            {lang === 'en' ? '3.5 Handover Assistance' : '3.5 Assistance au transfert'}
          </h3>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'As part of your service agreement, Arklens provides reasonable handover assistance at no additional charge:'
              : 'Dans le cadre de votre accord de service, Arklens fournit une assistance au transfert raisonnable sans frais supplémentaires :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2 mb-4">
