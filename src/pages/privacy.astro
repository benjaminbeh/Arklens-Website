---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const lang = 'en';
---

<BaseLayout 
  title={lang === 'en' ? 'Privacy Policy' : 'Politique de confidentialité'} 
  description={lang === 'en' ? 'Arklens Privacy Policy - How we collect, use and protect your personal data.' : 'Politique de confidentialité d\'Arklens - Comment nous collectons, utilisons et protégeons vos données personnelles.'} 
  lang={lang}
>
  <Header lang={lang} />
  <main id="main" class="pt-32 pb-24">
    <div class="container-custom max-w-4xl">
      <h1 class="text-display-md mb-8 text-neutral-900">
        {lang === 'en' ? 'Privacy Policy' : 'Politique de confidentialité'}
      </h1>
      
      <div class="prose prose-lg max-w-none">
        <p class="text-body-lg text-neutral-600 mb-8">
          {lang === 'en' ? 'Last updated: ' : 'Dernière mise à jour : '}{new Date().toLocaleDateString(lang === 'en' ? 'en-GB' : 'fr-CH')}
        </p>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '1. Introduction' : '1. Introduction'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'Arklens is committed to protecting your privacy and personal data. This privacy policy explains how we collect, use and protect your information.'
              : 'Arklens s\'engage à protéger votre vie privée et vos données personnelles. Cette politique de confidentialité explique comment nous collectons, utilisons et protégeons vos informations.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '2. Data Collected' : '2. Données collectées'}
          </h2>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'We only collect data necessary to provide our services:'
              : 'Nous collectons uniquement les données nécessaires pour fournir nos services :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2">
            <li>{lang === 'en' ? 'Business name and contact person' : 'Nom et prénom de l\'entreprise'}</li>
            <li>{lang === 'en' ? 'Professional email address' : 'Adresse e-mail professionnelle'}</li>
            <li>{lang === 'en' ? 'Professional phone number' : 'Numéro de téléphone professionnel'}</li>
            <li>{lang === 'en' ? 'Business information (industry, services)' : 'Informations sur votre entreprise (secteur, services)'}</li>
            <li>{lang === 'en' ? 'Logo and business photos (if provided)' : 'Logo et photos d\'entreprise (si fournis)'}</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '3. Use of Data' : '3. Utilisation des données'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en' ? 'Your data is used exclusively to:' : 'Vos données sont utilisées exclusivement pour :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2">
            <li>{lang === 'en' ? 'Create and host your website' : 'Créer et héberger votre site web'}</li>
            <li>{lang === 'en' ? 'Communicate with you regarding your project' : 'Communiquer avec vous concernant votre projet'}</li>
            <li>{lang === 'en' ? 'Provide technical support' : 'Fournir un support technique'}</li>
            <li>{lang === 'en' ? 'Improve our services' : 'Améliorer nos services'}</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '4. Data Protection' : '4. Protection des données'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'We implement appropriate technical and organizational security measures to protect your data from unauthorized access, loss or destruction.'
              : 'Nous mettons en œuvre des mesures de sécurité techniques et organisationnelles appropriées pour protéger vos données contre tout accès non autorisé, perte ou destruction.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '5. Data Sharing' : '5. Partage des données'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en' ? 'We never sell your data. Your information may only be shared with:' : 'Nous ne vendons jamais vos données. Vos informations peuvent être partagées uniquement avec :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2">
            <li>{lang === 'en' ? 'Cloudflare (hosting and CDN)' : 'Cloudflare (hébergement et CDN)'}</li>
            <li>{lang === 'en' ? 'Essential service providers under confidentiality agreement' : 'Fournisseurs de services essentiels sous contrat de confidentialité'}</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '6. Your Rights' : '6. Vos droits'}
          </h2>
          <p class="text-neutral-700 mb-4">
            {lang === 'en'
              ? 'In accordance with Swiss data protection law (LPD), you have the right to:'
              : 'Conformément à la loi suisse sur la protection des données (LPD), vous avez le droit de :'}
          </p>
          <ul class="list-disc pl-6 text-neutral-700 space-y-2">
            <li>{lang === 'en' ? 'Access your personal data' : 'Accéder à vos données personnelles'}</li>
            <li>{lang === 'en' ? 'Correct your inaccurate data' : 'Corriger vos données inexactes'}</li>
            <li>{lang === 'en' ? 'Delete your data' : 'Supprimer vos données'}</li>
            <li>{lang === 'en' ? 'Limit the processing of your data' : 'Limiter le traitement de vos données'}</li>
            <li>{lang === 'en' ? 'Data portability' : 'Portabilité de vos données'}</li>
            <li>{lang === 'en' ? 'Object to processing' : 'Vous opposer au traitement'}</li>
          </ul>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '7. Cookies' : '7. Cookies'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'We use cookies strictly necessary for the operation of the site. No advertising tracking cookies are used.'
              : 'Nous utilisons des cookies strictement nécessaires au fonctionnement du site. Aucun cookie de suivi publicitaire n\'est utilisé.'}
          </p>
        </section>

        <section class="mb-8">
          <h2 class="text-heading-lg mb-4">
            {lang === 'en' ? '8. Contact' : '8. Contact'}
          </h2>
          <p class="text-neutral-700">
            {lang === 'en'
              ? 'For any questions regarding this privacy policy or to exercise your rights, contact us at: privacy@arklens.ch'
              : 'Pour toute question concernant cette politique de confidentialité ou pour exercer vos droits, contactez-nous à : privacy@arklens.ch'}
          </p>
        </section>

        <div class="bg-neutral-50 rounded-xl p-6 mt-12 border border-neutral-200">
          <p class="text-sm text-neutral-600">
            <strong>{lang === 'en' ? 'Legal note:' : 'Note légale :'}</strong> 
            {lang === 'en'
              ? 'This privacy policy is provided for informational purposes. For full compliance with Swiss and European legislation, we recommend a review by a legal advisor.'
              : 'Cette politique de confidentialité est fournie à titre informatif. Pour une conformité complète avec la législation suisse et européenne, nous recommandons une révision par un conseiller juridique.'}
          </p>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
