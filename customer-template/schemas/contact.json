{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contact Information",
  "description": "Contact details and location",
  "type": "object",
  "required": ["email", "phone", "address"],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[0-9\\s\\-\\(\\)]+$",
      "description": "Primary contact phone"
    },
    "whatsapp": {
      "type": "string",
      "pattern": "^\\+?[0-9\\s\\-\\(\\)]+$",
      "description": "WhatsApp number (optional)"
    },
    "address": {
      "type": "object",
      "required": ["street", "city", "postalCode", "country"],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1,
          "description": "Street address"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "description": "City"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "description": "Swiss postal code (4 digits)"
        },
        "country": {
          "type": "string",
          "enum": ["Switzerland", "Suisse", "Schweiz", "Svizzera"],
          "description": "Country"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": 45.8,
          "maximum": 47.9,
          "description": "Latitude (Switzerland range)"
        },
        "lng": {
          "type": "number",
          "minimum": 5.9,
          "maximum": 10.6,
          "description": "Longitude (Switzerland range)"
        }
      }
    },
    "bookingUrl": {
      "type": "string",
      "format": "uri",
      "description": "Online booking URL (optional)"
    },
    "contactForm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether contact form is enabled"
        },
        "emailRecipient": {
          "type": "string",
          "format": "email",
          "description": "Where form submissions are sent"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "required"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["name", "email", "phone", "message", "subject"],
                "description": "Field name"
              },
              "required": {
                "type": "boolean",
                "description": "Whether field is required"
              }
            }
          }
        }
      }
    }
  }
}
