{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team Members",
  "description": "Team member profiles (optional)",
  "type": "object",
  "required": ["showTeam", "members"],
  "properties": {
    "showTeam": {
      "type": "boolean",
      "description": "Whether to display team section on website"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "active", "order"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique member identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Full name"
          },
          "role": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "en": { "type": "string" },
                  "fr": { "type": "string" },
                  "de": { "type": "string" },
                  "it": { "type": "string" }
                },
                "additionalProperties": false
              }
            ],
            "description": "Job title or role"
          },
          "bio": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "en": { "type": "string" },
                  "fr": { "type": "string" },
                  "de": { "type": "string" },
                  "it": { "type": "string" }
                },
                "additionalProperties": false
              }
            ],
            "description": "Short biography"
          },
          "image": {
            "type": "string",
            "pattern": "^/images/team/.*\\.(jpg|jpeg|png|webp)$",
            "description": "Path to team member photo"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Team member email (optional)"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9\\s\\-\\(\\)]+$",
            "description": "Team member phone (optional)"
          },
          "active": {
            "type": "boolean",
            "description": "Whether member is currently active"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Display order (1 = first)"
          },
          "social": {
            "type": "object",
            "properties": {
              "linkedin": {
                "type": "string",
                "format": "uri"
              },
              "twitter": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
